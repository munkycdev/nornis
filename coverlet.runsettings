<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage collection settings, shared by scripts/coverage.ps1 and (from phase 2) CI.
  Coverage here is signal, not a gate — see .kiro/steering/testing-strategy.md and
  docs/plans/test-quality.md.

  The exclusions all serve one purpose: keep code nobody chooses to write out of the
  denominator. Hand-written logic is what the number is supposed to describe.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Nornis.*]*</Include>
          <!-- EF-scaffolded migrations, and the test assemblies that Include's
               wildcard would otherwise sweep in alongside the product code. -->
          <Exclude>[Nornis.Infrastructure]Nornis.Infrastructure.Migrations.*,[*.Tests]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Entity and DTO auto-properties are a large, uniformly-covered mass that
               drowns out branch logic in the per-assembly numbers phase 4 will set
               floors from. -->
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
