is_global = true

# Analyzer rules whose default does not fit this repository. This file sits at the repository
# root because the rules fire in the test projects too, and the Docker build copies it with
# everything else.
#
# BL0016 ("JS interop call is not guarded with a try/catch") is a hint, not an error.
#
# The rule wants a try/catch written around every call on an IJSRuntime, and it cannot tell
# the calls that need one from the calls that must not have one:
#
# - A call that only acts on the browser and can find the circuit gone (an init in
#   OnAfterRenderAsync, a cleanup after an upload) goes through
#   JsRuntimeExtensions.TryInvokeVoidAsync, which is the one place that catch lives. The rule
#   still flags the call, because the catch is not written at the call site.
# - A call whose answer the code goes on to use (the editor's text, whether an upload
#   arrived) must throw when nobody answers, so the handler stops. Catching there would turn
#   "the tab closed" into "the notes are empty".
# - A call made in a click handler runs while the circuit is alive by definition.
# - It also flags any method on a test double that implements IJSRuntime.
#
# As a hint it still marks each new JS call in the editor, which is the moment to ask which of
# those it is.
dotnet_diagnostic.BL0016.severity = suggestion

# BL0012 ("StateHasChanged is unnecessary") is left at its default, so it fails the build. It
# judges a method by its use as an event handler. Where the same method also runs from
# WorldState.Changed or from the middle of another handler, the call is needed and the method
# carries a #pragma with the reason.
