<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Nornis.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Google.GenAI" Version="2.0.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- OpenAI moves only with Microsoft.Extensions.AI.OpenAI, which is built against 2.14.0 (11.0.0 too).
         2.15.0 changed ResponsesClient.CreateResponseStreamingAsync, and the adapter fails at run
         time with MissingMethodException on every Responses stream. Dependabot ignores 2.15+
         (.github/dependabot.yml); bump both together once the adapter targets a newer OpenAI. -->
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <!-- The Linux containers have no fontconfig; this native build needs none. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient 6.1.6 pulls System.Security.Cryptography.Pkcs 9.0.11, which carries
         GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7, and NU1903 is an error here. Pin the
         patched line until SqlClient moves. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <!-- Microsoft.AspNetCore.DataProtection 10.0.11 pulls System.Security.Cryptography.Xml 10.0.11,
         which carries GHSA-7hqp-7c5m-4vq6 and two more (high), and NU1903 is an error here. Pin the
         patched line, as Pkcs is pinned above. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>

  <!-- The booklet's fonts (feature 34), embedded so the image needs no font directory and the
       output never depends on what fonts a machine has installed. Licences sit beside them. -->
  <ItemGroup>
    <EmbeddedResource Include="Printing\Fonts\*.woff;Printing\Fonts\*.ttf" LogicalName="Nornis.Printing.Fonts.%(Filename)%(Extension)" />
    <None Include="Printing\Fonts\*.txt" />
  </ItemGroup>

  <!-- The Nornis Press mark on the booklet's rights page: a copy of the Web's
       wwwroot/images/logo.png, embedded for the same reason as the fonts. -->
  <ItemGroup>
    <EmbeddedResource Include="Printing\Images\nornis-logo.png" LogicalName="Nornis.Printing.Images.nornis-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nornis.Application\Nornis.Application.csproj" />
    <ProjectReference Include="..\Nornis.Domain\Nornis.Domain.csproj" />
  </ItemGroup>

</Project>
