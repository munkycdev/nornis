<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Holds only Auth0:ClientSecret, read by provision-azure.ps1. Local dev runs anonymous
         against the API's dev-auth bypass and never reads this store. -->
    <UserSecretsId>nornis-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nornis.Web.Tests" />
  </ItemGroup>

  <!-- No ProjectReference, deliberately. Web is a separate deployable that talks to
       nornis-api over HTTP and owns its own copy of the contracts (see Contracts.cs) — it
       never references the Application or Infrastructure layers. Nothing enforces this but
       the absence below, so an added reference here is the thing to question in review. -->

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Markdig" Version="0.45.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageReference Include="MudBlazor" Version="7.16.0" />
  </ItemGroup>

</Project>
