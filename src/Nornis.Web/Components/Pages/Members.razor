@page "/members"
@implements IDisposable
@inject WorldState Worlds
@inject BreadcrumbState Crumbs

<PageTitle>Members — Nornis</PageTitle>

<MudText Typo="Typo.h4" Class="nornis-serif">Members</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Who is at the table, and as what.@(Worlds.IsGm ? " Invite links to bring more people in are below." : "")
</MudText>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else
{
    <MembersPanel />
    @if (Worlds.IsGm)
    {
        <InviteLinksCard />
    }
}

@code {
    protected override void OnInitialized()
    {
        Crumbs.Set("/members", new Crumb("Members"));
        Worlds.Changed += OnWorldsChanged; // the invite card follows the role, including viewing as a player
    }

    private void OnWorldsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Worlds.Changed -= OnWorldsChanged;
}
