@page "/party"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject BreadcrumbState Crumbs
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Nornis.Web.Services

@* Everyone who plays, whether or not they are on Nornis. A player is a person at the table;
   Members (the other page) is who can log in. The two lists agree on the people who are both,
   and this one also has the people who are not — a quiet "Not on Nornis" beside the name. *@

<PageTitle>Party — Nornis</PageTitle>

<MudText Typo="Typo.h4" Class="nornis-serif">Party</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Everyone at the table, and the characters they play. Your own are managed on
    <a href="/profile" class="nornis-link">your settings</a>.
</MudText>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (_loading)
{
    <LoadingRows Rows="3" Height="64px" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    @foreach (var player in _players)
    {
        var characters = _characters.Where(c => c.PlayerId == player.Id).OrderBy(c => c.Name).ToList();
        var editing = _renamingId == player.Id;
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="@(player.WorldMemberId is null ? Color.Default : Color.Primary)" Size="Size.Small">@MemberDisplay.Initial(player.Name)</MudAvatar>
                <div class="nornis-list-body">
                    @if (editing)
                    {
                        <MudTextField @bind-Value="_renameValue" Label="Name" MaxLength="200" Immediate="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                    else
                    {
                        <div class="nornis-list-title">@player.Name</div>
                        <div class="nornis-list-sub">
                            @if (player.Role is { } role)
                            {
                                @MemberDisplay.RoleLabel(role)
                            }
                            else
                            {
                                <span>Not on Nornis</span>
                            }
                        </div>
                    }
                </div>
                @if (IsGm && player.WorldMemberId is null)
                {
                    @if (editing)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="() => SaveRenameAsync(player)" Disabled="_busy">Save</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelRename">Cancel</MudButton>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => BeginRename(player)" aria-label="Rename player" />
                        <MudTooltip Text="@(characters.Count == 0 ? "Remove from the table" : "Move or delete their characters first")">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           Disabled="characters.Count > 0"
                                           OnClick="() => RemoveAsync(player)" aria-label="Remove player" />
                        </MudTooltip>
                    }
                }
            </div>
            @if (characters.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No characters yet.</MudText>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var ch in characters)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Outlined.Person"
                                 Href="@($"/characters/{ch.Id}")">@ch.Name</MudChip>
                    }
                </div>
            }
            @if (IsGm)
            {
                @* The GM gives anyone at the table a character: an existing record moves here, a
                   Codex entry becomes a linked record, a new name becomes a fresh one. *@
                <div class="mt-3">
                    <CharacterPicker Label="@($"Character for {player.Name}")" ExcludePlayerId="player.Id" Busy="_busy"
                                     OnPick="pick => PickForPlayerAsync(player, pick)" />
                </div>
            }
            @if (IsGm && player.WorldMemberId is null)
            {
                <div class="nornis-add-member mt-3">
                    <MudSelect T="Guid?" Value="@LinkTargetFor(player.Id)" ValueChanged="@((Guid? v) => _linkTargets[player.Id] = v)"
                               Label="@($"{player.Name} is on Nornis as…")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Clearable="true" Class="flex-grow-1">
                        @foreach (var m in _members)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)m.Id)">@MemberDisplay.Name(m)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link"
                               OnClick="() => LinkAsync(player)" Disabled="_busy || LinkTargetFor(player.Id) is null">
                        Link
                    </MudButton>
                </div>
            }
            @if (IsGm && player.WorldMemberId is null)
            {
                @* A door for someone who is not on Nornis: a link that opens the party shelf as
                   them, and only that. One standing link per player; a new one retires the old. *@
                <div class="mt-3">
                    @if (ShelfLinkFor(player.Id) is { } link)
                    {
                        <div class="nornis-add-member">
                            <MudTextField T="string" Value="@ShelfUrl(link)" ReadOnly="true" Label="@($"{player.Name}'s shelf link")"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            <MudTooltip Text="Copy link">
                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                               OnClick="() => CopyShelfLinkAsync(link)" aria-label="Copy shelf link" />
                            </MudTooltip>
                            <MudTooltip Text="@(_qrFor == player.Id ? "Hide QR code" : "Show QR code")">
                                <MudIconButton Icon="@Icons.Material.Outlined.QrCode2" Size="Size.Small"
                                               OnClick="() => ToggleQr(player.Id)" aria-label="Show QR code" />
                            </MudTooltip>
                            <MudTooltip Text="New link — the old one stops working">
                                <MudIconButton Icon="@Icons.Material.Outlined.Autorenew" Size="Size.Small" Disabled="_busy"
                                               OnClick="() => MintShelfLinkAsync(player, rotate: true)" aria-label="New shelf link" />
                            </MudTooltip>
                            <MudTooltip Text="Take the link back">
                                <MudIconButton Icon="@Icons.Material.Outlined.LinkOff" Color="Color.Error" Size="Size.Small" Disabled="_busy"
                                               OnClick="() => RevokeShelfLinkAsync(player, link)" aria-label="Revoke shelf link" />
                            </MudTooltip>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(link.LastUsedAt is { } used ? $"Opened {RelativeTime.Ago(used)}" : "Never opened")
                        </MudText>
                        @if (_qrFor == player.Id)
                        {
                            <div class="nornis-shelf-qr">@((MarkupString)QrSvg.For(ShelfUrl(link)))</div>
                        }
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.MenuBook" Disabled="_busy"
                                   OnClick="() => MintShelfLinkAsync(player, rotate: false)">
                            Give @player.Name a link to the shelf
                        </MudButton>
                    }
                </div>
            }
        </MudPaper>
    }

    @if (IsGm)
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            <div class="nornis-detail-section-title">Someone who plays without Nornis</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Add them by name so their characters have a place here. If they sign up later, they
                can claim themselves from their settings, or you can link them from this page.
            </MudText>
            <div class="nornis-add-member">
                <MudTextField @bind-Value="_newName" Label="Name" MaxLength="200"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddAsync" Disabled="_busy">
                    Add
                </MudButton>
            </div>
            @if (_addError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_addError</MudAlert>
            }
        </MudPaper>
    }
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private IReadOnlyList<PlayerDto> _players = [];
    private IReadOnlyList<CharacterDto> _characters = [];
    private IReadOnlyList<WorldMember> _members = [];
    private readonly Dictionary<Guid, Guid?> _linkTargets = [];
    private IReadOnlyList<ShelfLinkDto> _shelfLinks = [];
    private Guid? _qrFor;

    private string _newName = string.Empty;
    private string? _addError;
    private Guid? _renamingId;
    private string _renameValue = string.Empty;

    private bool IsGm => Worlds.EffectiveRole == WorldRoles.Gm;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        Crumbs.Set("/party", new Crumb("Party"));
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (Worlds.Current is null)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _error = null;
        _renamingId = null;
        StateHasChanged();

        var playersTask = Api.GetPlayersAsync(Worlds.Current.Id);
        var charactersTask = Api.GetCharactersAsync(Worlds.Current.Id);
        var membersTask = IsGm ? Api.GetMembersAsync(Worlds.Current.Id) : null;
        var linksTask = IsGm ? Api.GetShelfLinksAsync(Worlds.Current.Id) : null;
        var players = await playersTask;
        var characters = await charactersTask;
        // Only the GM links, so only the GM needs the accounts to link to.
        _members = membersTask is null ? [] : (await membersTask) is { IsSuccess: true } m ? m.Value! : [];
        // Likewise the links: only the GM mints them, and the codes are the GM's to see.
        _shelfLinks = linksTask is null ? [] : (await linksTask) is { IsSuccess: true } l ? l.Value! : [];

        _loading = false;
        if (!players.IsSuccess)
        {
            _error = players.Error!.Message;
        }
        else
        {
            // The API already orders GM first, then by name — the way the table sits.
            _players = players.Value!;
            _characters = characters.IsSuccess ? characters.Value! : [];
        }
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (Worlds.Current is null || string.IsNullOrWhiteSpace(_newName))
        {
            _addError = "A player needs a name.";
            return;
        }

        _busy = true;
        _addError = null;
        var result = await Api.CreatePlayerAsync(Worlds.Current.Id, _newName.Trim());
        _busy = false;

        if (result.IsSuccess)
        {
            _newName = string.Empty;
            await LoadAsync();
        }
        else
        {
            _addError = result.Error!.Message;
        }
    }

    /// <summary>
    /// What a pick means on this page: a record moves to the player (after asking, since it is
    /// someone else's), a Codex entry becomes a record linked to it, a name becomes a record.
    /// </summary>
    private async Task PickForPlayerAsync(PlayerDto player, CharacterPicker.CharacterPick pick)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var worldId = Worlds.Current.Id;
        _busy = true;
        ApiResult<CharacterDto> result;

        switch (pick)
        {
            case { Record: { } record }:
                var confirmed = await DialogService.ShowMessageBoxAsync(
                    "Move this character?",
                    $"\"{record.Name}\" is played by {record.PlayerName}. Move them to {player.Name}? The sheet and everything on it comes along as it is.",
                    yesText: "Move", cancelText: "Cancel");
                if (confirmed != true)
                {
                    _busy = false;
                    return;
                }
                result = await Api.MoveCharacterAsync(worldId, record.Id, player.Id);
                break;
            case { Artifact: { } artifact }:
                var description = artifact.Summary is { Length: > 2000 } s ? s[..2000] : artifact.Summary;
                result = await Api.CreateCharacterAsync(worldId, new CreateCharacterRequest(artifact.Name, description, PlayerId: player.Id, ArtifactId: artifact.Id));
                break;
            default:
                result = await Api.CreateCharacterAsync(worldId, new CreateCharacterRequest(pick.NewName ?? pick.Name, PlayerId: player.Id));
                break;
        }

        _busy = false;
        if (result.IsSuccess)
        {
            Snackbar.Add($"{result.Value!.Name} is {player.Name}'s.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private Guid? LinkTargetFor(Guid playerId) => _linkTargets.GetValueOrDefault(playerId);

    /// <summary>The GM says who this player is on Nornis; the same merge the member's own claim does.</summary>
    private async Task LinkAsync(PlayerDto player)
    {
        if (Worlds.Current is null || LinkTargetFor(player.Id) is not { } memberId)
        {
            return;
        }

        var memberName = _members.FirstOrDefault(m => m.Id == memberId) is { } m ? MemberDisplay.Name(m) : "that member";
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Link this player?",
            $"{player.Name} is {memberName}? Everything {player.Name} plays becomes {memberName}'s, and the name goes.",
            yesText: "Link", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        var result = await Api.LinkPlayerAsync(Worlds.Current.Id, player.Id, memberId);
        _busy = false;

        if (result.IsSuccess)
        {
            _linkTargets.Remove(player.Id);
            Snackbar.Add($"{player.Name} is {memberName} now.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private void BeginRename(PlayerDto player)
    {
        _renamingId = player.Id;
        _renameValue = player.Name;
    }

    private void CancelRename() => _renamingId = null;

    private async Task SaveRenameAsync(PlayerDto player)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _busy = true;
        var result = await Api.RenamePlayerAsync(Worlds.Current.Id, player.Id, _renameValue.Trim());
        _busy = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(PlayerDto player)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove from the table?", $"Remove {player.Name}? They have no characters here.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        var result = await Api.DeletePlayerAsync(Worlds.Current.Id, player.Id);
        _busy = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private ShelfLinkDto? ShelfLinkFor(Guid playerId) => _shelfLinks.FirstOrDefault(l => l.PlayerId == playerId);

    private string ShelfUrl(ShelfLinkDto link) => $"{Nav.BaseUri}shelf/{link.Code}";

    private void ToggleQr(Guid playerId) => _qrFor = _qrFor == playerId ? null : playerId;

    private async Task CopyShelfLinkAsync(ShelfLinkDto link)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ShelfUrl(link));
        Snackbar.Add("Shelf link copied.", Severity.Info);
    }

    /// <summary>Mints a link, or replaces the standing one — after asking, since the old one stops working.</summary>
    private async Task MintShelfLinkAsync(PlayerDto player, bool rotate)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        if (rotate)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                "New shelf link?",
                $"{player.Name}'s current link stops working. Whoever holds it loses the shelf until you send the new one.",
                yesText: "New link", cancelText: "Cancel");
            if (confirmed != true)
            {
                return;
            }
        }

        _busy = true;
        var result = await Api.CreateShelfLinkAsync(Worlds.Current.Id, player.Id);
        _busy = false;

        if (result.IsSuccess)
        {
            Snackbar.Add($"{player.Name} has a shelf link. Copy it and send it to them.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task RevokeShelfLinkAsync(PlayerDto player, ShelfLinkDto link)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Take the link back?",
            $"{player.Name}'s shelf link stops working now. You can give them a new one any time.",
            yesText: "Revoke", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        var result = await Api.RevokeShelfLinkAsync(Worlds.Current.Id, link.Id);
        _busy = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
