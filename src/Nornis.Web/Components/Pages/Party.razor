@page "/party"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject BreadcrumbState Crumbs
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Nornis.Web.Services

@* Everyone who plays, whether or not they are on Nornis. A player is a person at the table;
   Members (the other page) is who can log in. The two lists agree on the people who are both,
   and this one also has the people who are not — a quiet "Not on Nornis" beside the name. *@

<PageTitle>Party — Nornis</PageTitle>

<MudText Typo="Typo.h4" Class="nornis-serif">Party</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Everyone at the table, and the characters they play. Your own are managed on
    <a href="/profile" class="nornis-link">your settings</a>.
</MudText>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (_loading)
{
    <LoadingRows Rows="3" Height="64px" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    @foreach (var player in _players)
    {
        var characters = _characters.Where(c => c.PlayerId == player.Id).OrderBy(c => c.Name).ToList();
        var editing = _renamingId == player.Id;
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
            <div class="d-flex align-center gap-3 mb-2">
                <MudAvatar Color="@(player.WorldMemberId is null ? Color.Default : Color.Primary)" Size="Size.Small">@MemberDisplay.Initial(player.Name)</MudAvatar>
                <div class="nornis-list-body">
                    @if (editing)
                    {
                        <MudTextField @bind-Value="_renameValue" Label="Name" MaxLength="200" Immediate="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                    else
                    {
                        <div class="nornis-list-title">@player.Name</div>
                        <div class="nornis-list-sub">
                            @if (player.Role is { } role)
                            {
                                @MemberDisplay.RoleLabel(role)
                            }
                            else
                            {
                                <span>Not on Nornis</span>
                            }
                        </div>
                    }
                </div>
                @if (IsGm && player.WorldMemberId is null)
                {
                    @if (editing)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="() => SaveRenameAsync(player)" Disabled="_busy">Save</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelRename">Cancel</MudButton>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => BeginRename(player)" aria-label="Rename player" />
                        <MudTooltip Text="@(characters.Count == 0 ? "Remove from the table" : "Move or delete their characters first")">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           Disabled="characters.Count > 0"
                                           OnClick="() => RemoveAsync(player)" aria-label="Remove player" />
                        </MudTooltip>
                    }
                }
            </div>
            @if (characters.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No characters yet.</MudText>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var ch in characters)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Outlined.Person"
                                 Href="@($"/characters/{ch.Id}")">@ch.Name</MudChip>
                    }
                </div>
            }
        </MudPaper>
    }

    @if (IsGm)
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            <div class="nornis-detail-section-title">Someone who plays without Nornis</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Add them by name so their characters have a place here. If they sign up later, they
                can claim themselves from their settings, or you can link them from this page.
            </MudText>
            <div class="nornis-add-member">
                <MudTextField @bind-Value="_newName" Label="Name" MaxLength="200"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddAsync" Disabled="_busy">
                    Add
                </MudButton>
            </div>
            @if (_addError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_addError</MudAlert>
            }
        </MudPaper>
    }
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private IReadOnlyList<PlayerDto> _players = [];
    private IReadOnlyList<CharacterDto> _characters = [];

    private string _newName = string.Empty;
    private string? _addError;
    private Guid? _renamingId;
    private string _renameValue = string.Empty;

    private bool IsGm => Worlds.EffectiveRole == WorldRoles.Gm;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        Crumbs.Set("/party", new Crumb("Party"));
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (Worlds.Current is null)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _error = null;
        _renamingId = null;
        StateHasChanged();

        var playersTask = Api.GetPlayersAsync(Worlds.Current.Id);
        var charactersTask = Api.GetCharactersAsync(Worlds.Current.Id);
        var players = await playersTask;
        var characters = await charactersTask;

        _loading = false;
        if (!players.IsSuccess)
        {
            _error = players.Error!.Message;
        }
        else
        {
            // The API already orders GM first, then by name — the way the table sits.
            _players = players.Value!;
            _characters = characters.IsSuccess ? characters.Value! : [];
        }
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (Worlds.Current is null || string.IsNullOrWhiteSpace(_newName))
        {
            _addError = "A player needs a name.";
            return;
        }

        _busy = true;
        _addError = null;
        var result = await Api.CreatePlayerAsync(Worlds.Current.Id, _newName.Trim());
        _busy = false;

        if (result.IsSuccess)
        {
            _newName = string.Empty;
            await LoadAsync();
        }
        else
        {
            _addError = result.Error!.Message;
        }
    }

    private void BeginRename(PlayerDto player)
    {
        _renamingId = player.Id;
        _renameValue = player.Name;
    }

    private void CancelRename() => _renamingId = null;

    private async Task SaveRenameAsync(PlayerDto player)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _busy = true;
        var result = await Api.RenamePlayerAsync(Worlds.Current.Id, player.Id, _renameValue.Trim());
        _busy = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(PlayerDto player)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove from the table?", $"Remove {player.Name}? They have no characters here.",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        var result = await Api.DeletePlayerAsync(Worlds.Current.Id, player.Id);
        _busy = false;

        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
