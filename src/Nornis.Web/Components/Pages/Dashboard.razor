@page "/dashboard"
@using System.Text.Json
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject AskState AskState
@inject NavigationManager Nav

<PageTitle>Dashboard — Nornis</PageTitle>

<OnboardingPrompt />

@if (Worlds.Current is null)
{
    <NoWorld />
}
else
{
    <div class="nornis-dashboard">
        <div class="nornis-dashboard-main">

            <MudPaper Elevation="0" Class="nornis-card nornis-hero">
                <img src="images/mini-logo.png" alt="" class="nornis-hero-mark" />
                <div class="nornis-hero-title">@Worlds.Current.Name</div>
                <div class="nornis-hero-sub">Ask the Loremaster</div>

                <div class="nornis-ask">
                    <MudTextField T="string"
                                  @bind-Value="_question"
                                  Immediate="true"
                                  Class="nornis-ask-input"
                                  Placeholder="What should I remember before tonight?"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  OnKeyUp="GoAskKeyUp" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="nornis-ask-send"
                                   OnClick="GoAsk"
                                   aria-label="Ask" />
                </div>

                <div class="nornis-suggestions">
                    @foreach (var s in _suggestions)
                    {
                        <button type="button" class="nornis-suggestion" @onclick="() => GoAskWith(s)">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" Size="Size.Small" />
                            <span>@s</span>
                        </button>
                    }
                </div>
            </MudPaper>

            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
                <div class="nornis-capture-head">
                    <div class="nornis-capture-icon">
                        <MudIcon Icon="@Icons.Material.Outlined.Create" />
                    </div>
                    <div>
                        <div class="nornis-card-title">Tell Nornis what happened</div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Add session notes, transcripts, images, or links. Nornis will do the rest.
                        </MudText>
                    </div>
                </div>

                <div class="nornis-capture-tiles">
                    @foreach (var tile in _captureTiles)
                    {
                        <a href="@($"/capture?type={tile.Type}")" class="nornis-tile">
                            <span class="nornis-tile-title">
                                <MudIcon Icon="@tile.Icon" Color="Color.Primary" Size="Size.Small" />
                                @tile.Title
                            </span>
                            <span class="nornis-tile-sub">@tile.Subtitle</span>
                        </a>
                    }
                </div>

                <div class="nornis-capture-foot">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                    All inputs are private to your world
                </div>
            </MudPaper>

            @* Follows capture: logging the session is what surfaces the wrap-up's work in the
               first place. Renders nothing when there is nothing to decide. *@
            @if (_showAiAssessment)
            {
                <SessionWrapUpCard WorldId="Worlds.Current.Id" />
            }

            <WorldDigestCard />
        </div>

        <div class="nornis-rail">
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
                <div class="nornis-card-header">
                    <span class="nornis-card-title">Review Queue</span>
                    <span class="nornis-count-badge">@_proposals.Count</span>
                </div>
                @if (_proposals.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing to review.</MudText>
                }
                @foreach (var item in _proposals)
                {
                    <div class="nornis-list-row">
                        <div class="nornis-list-thumb"><MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" /></div>
                        <div class="nornis-list-body">
                            <div class="nornis-list-title">@ProposalName(item)</div>
                            <div class="nornis-list-sub">@item.Rationale</div>
                        </div>
                        <span class="nornis-dot @DotClass(item)" role="img" title="@DotLabel(item)" aria-label="@DotLabel(item)"></span>
                    </div>
                }
                <div class="nornis-card-foot">
                    <a href="/review" class="nornis-viewall">Open Review Queue <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
                </div>
            </MudPaper>

            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
                <div class="nornis-card-header">
                    <span class="nornis-card-title">Recent Changes</span>
                </div>
                @if (_canonRelationships.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No recent changes.</MudText>
                }
                @foreach (var rel in _canonRelationships)
                {
                    <a href="@Links.Artifact(rel.ArtifactSlug, rel.ArtifactId)" class="nornis-list-row nornis-list-link">
                        <div class="nornis-list-thumb"><MudIcon Icon="@Icons.Material.Outlined.Hub" Size="Size.Small" /></div>
                        <div class="nornis-list-body">
                            <div class="nornis-list-title">@rel.ArtifactName</div>
                            <div class="nornis-list-sub">@rel.Label @rel.OtherArtifactName</div>
                        </div>
                        <span class="nornis-list-meta">@RelativeTime.Ago(rel.UpdatedAt)</span>
                    </a>
                }
            </MudPaper>
        </div>
    </div>
}

@code {

    // Ask the Loremaster — hands the typed question to the /ask conversation page.
    private string _question = string.Empty;

    private IReadOnlyList<CanonEntry> _canonRelationships = [];
    private IReadOnlyList<ReviewProposal> _proposals = [];

    // The wrap-up card decides what the AI found worth acting on, which is a GM's call.
    private bool _showAiAssessment =>
        Worlds.IsGm;

    // Shown until the data-driven suggestions load (or if that call fails).
    private static readonly string[] DefaultSuggestions =
    [
        "What changed last session?",
        "What storylines are unresolved?",
        "Who have we met recently?",
        "What should I prep next?",
    ];

    private IReadOnlyList<string> _suggestions = DefaultSuggestions;

    private record Tile(string Title, string Subtitle, string Icon, string Type);
    private readonly Tile[] _captureTiles =
    [
        new("Write Notes", "Start typing…", Icons.Material.Outlined.Create, "SessionNote"),
        new("Session Audio", "Paste a session transcript", Icons.Material.Outlined.GraphicEq, "SessionAudio"),
        new("Upload Image", "Maps, notes, assets", Icons.Material.Outlined.Image, "Image"),
        new("Handwritten Note", "Upload or scan", Icons.Material.Outlined.Gesture, "HandwrittenNotes"),
        new("Add Link", "Article, wiki, video", Icons.Material.Outlined.Link, "WebLink"),
    ];

    private Guid _dashboardWorldId;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadDashboardAsync();
    }

    private void GoAskWith(string question)
    {
        _question = question;
        GoAsk();
    }

    private void GoAskKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_question))
        {
            GoAsk();
        }
    }

    // Opens the /ask conversation page. If a question was typed it's carried over and asked;
    // otherwise the page just opens (e.g. to browse saved conversations).
    private void GoAsk()
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var question = _question.Trim();
        if (!string.IsNullOrWhiteSpace(question))
        {
            AskState.PendingQuestion = question;
        }
        Nav.NavigateTo("/ask");
    }

    // Reload dashboard data only when the world actually changes; other notifications
    // (e.g. the health score arriving) just re-render so the card picks up Worlds.Health.
    private void OnWorldChanged() => InvokeAsync(async () =>
    {
        if (Worlds.Current?.Id != _dashboardWorldId)
        {
            await LoadDashboardAsync();
        }
        else
        {
            StateHasChanged();
        }
    });

    private async Task LoadDashboardAsync()
    {
        if (Worlds.Current is null)
        {
            _dashboardWorldId = Guid.Empty;
            StateHasChanged();
            return;
        }

        var id = Worlds.Current.Id;
        _dashboardWorldId = id;
        StateHasChanged();

        // Only the relationships are rendered now that the Canon Updates card is gone, but the
        // request still asks for three facts: factLimit is a cap, and 0 is the kind of value that
        // reads as "no limit" somewhere down the stack. Three unused rows cost less than guessing
        // at a sentinel — see the third pre-implementation check.
        var canonTask = Api.GetCanonAsync(id, factLimit: 3, relationshipLimit: 3);
        var reviewTask = Api.GetReviewQueueAsync(id);
        var suggestionsTask = Api.GetAskSuggestionsAsync(id);
        await Task.WhenAll(canonTask, reviewTask, suggestionsTask);

        var suggestions = suggestionsTask.Result.Value;
        _suggestions = suggestions is { Count: > 0 }
            ? suggestions.Select(x => x.Text).ToList()
            : DefaultSuggestions;

        // Already capped per kind by the request, so no client-side Take is needed.
        var canon = canonTask.Result.Value ?? [];
        _canonRelationships = canon.Where(c => c.Kind == "Relationship").ToList();

        _proposals = reviewTask.Result.Value?.Proposals ?? [];

        StateHasChanged();
    }

    private static string ProposalName(ReviewProposal p)
    {
        try
        {
            using var doc = JsonDocument.Parse(p.ProposedValueJson);
            if (doc.RootElement.TryGetProperty("Name", out var name) && name.ValueKind == JsonValueKind.String)
            {
                return name.GetString()!;
            }
        }
        catch (JsonException)
        {
            // Fall through to a humanized change type.
        }
        return DisplayText.Humanize(p.ChangeType);
    }

    private static bool IsConflict(ReviewProposal p) =>
        p.Rationale?.Contains("conflict", StringComparison.OrdinalIgnoreCase) == true;

    private static string DotClass(ReviewProposal p) =>
        IsConflict(p) ? "nornis-dot-error" : "nornis-dot-warning";

    // The dot's colour can't be the only signal — name the state for screen readers and on hover.
    private static string DotLabel(ReviewProposal p) =>
        IsConflict(p) ? "Conflict" : "Awaiting review";

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
