@page "/prep/{Key}/print"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject BreadcrumbState Crumbs
@inject IJSRuntime JS

@* The booklet. The API renders it (AdventurePrintModel, the one renderer) and this page only
   frames it: a paper page on screen, and in print nothing but the page (app.css, "Prep
   booklet"). File to Library takes the PDF the browser's print dialog saved and files it as a
   GM-only Handout, dated, against this Adventure. *@

@* The adventure's title alone: a PDF saved from the print dialog takes this as its name (feature 32). *@
<PageTitle>@(_print?.Title ?? "Adventure")</PageTitle>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (!Worlds.IsGm)
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Class="nornis-comingsoon-icon" />
        <MudText Typo="Typo.h5" Class="nornis-serif">GMs only</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Prep is the GM's planning, and it can hold anything the players haven't learned yet.
        </MudText>
    </MudPaper>
}
else if (_loading && _print is null)
{
    <LoadingRows Rows="6" />
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning">
        That adventure isn't here. It may have been deleted. <a href="/prep" class="nornis-link">Back to Prep</a>
    </MudAlert>
}
else if (_error is not null && _print is null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_print is not null)
{
    <div class="nornis-booklet-toolbar">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   Href="@Links.Adventure(_print.Slug, _print.AdventureId)">
            Back to the adventure
        </MudButton>
        <div class="flex-grow-1"></div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="nornis-booklet-print"
                   StartIcon="@Icons.Material.Outlined.Print" OnClick="PrintAsync">
            Print
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="nornis-booklet-file"
                   StartIcon="@Icons.Material.Outlined.LibraryAdd" OnClick="FileToLibraryAsync">
            File to Library
        </MudButton>
    </div>

    @if (_filed is not null)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="nornis-booklet-toolbar nornis-booklet-filed">
            Filed as <a href="@Links.LibraryDocument(_filed.Slug, _filed.Id)" class="nornis-link">@_filed.Title</a>,
            GM only. Share it from the Library when the players should have it.
        </MudAlert>
    }

    <div class="nornis-booklet-page">
        @((MarkupString)_print.Html)
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    private bool _loading;
    private bool _notFound;
    private string? _error;
    private string? _loadedKey;
    private AdventurePrintDto? _print;
    private LibraryDocumentDto? _filed;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Key != _loadedKey)
        {
            await LoadAsync();
        }
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loadedKey = Key;
        _print = null;
        _filed = null;
        if (Worlds.Current is null || !Worlds.IsGm)
        {
            StateHasChanged();
            return;
        }

        _loading = true;
        _notFound = false;
        _error = null;
        StateHasChanged();

        // The page is addressed by slug, the print route by id: the Adventure resolves the one
        // to the other, as every Prep page does.
        var worldId = Worlds.Current.Id;
        var adventure = await Api.GetAdventureAsync(worldId, Key);
        var print = adventure.IsSuccess ? await Api.GetAdventurePrintAsync(worldId, adventure.Value!.Id) : null;
        _loading = false;

        var error = adventure.Error ?? print?.Error;
        if (error is null)
        {
            _print = print!.Value;
            var adventureLink = Links.Adventure(_print!.Slug, _print.AdventureId);
            Crumbs.Set($"{adventureLink}/print", new Crumb("Prep", "/prep"), new Crumb(_print.Title, adventureLink), new Crumb("Print"));
            if (!Links.IsCanonical(Key, _print.Slug))
            {
                _loadedKey = _print.Slug;
                Nav.NavigateTo($"{adventureLink}/print", replace: true);
            }
        }
        else if (error.Code == "not_found")
        {
            _notFound = true;
        }
        else
        {
            _error = error.Message;
        }

        StateHasChanged();
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    private async Task FileToLibraryAsync()
    {
        if (_print is null)
        {
            return;
        }

        var parameters = new DialogParameters<LibraryUploadDialog>
        {
            { d => d.AdventureId, _print.AdventureId },
            { d => d.PrintTitle, _print.LibraryTitle },
        };
        var dialog = await DialogService.ShowAsync<LibraryUploadDialog>("File to Library", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: LibraryDocumentDto filed })
        {
            _filed = filed;
        }
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
