@page "/prep/{Key}/print"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbState Crumbs
@inject IJSRuntime JS

@* The booklet (feature 34): a PDF the API lays out, the same one File to Library files. The page
   shows it in the browser's own PDF viewer, whose Print prints it on paper; Download saves it;
   File to Library files it in one click as a GM-only Handout, dated, against this Adventure.
   Print props (feature 38) downloads the prop boxes, one to a page, for cutting out. *@

<PageTitle>@(_adventure?.Title ?? "Adventure")</PageTitle>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (!Worlds.IsGm)
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Class="nornis-comingsoon-icon" />
        <MudText Typo="Typo.h5" Class="nornis-serif">GMs only</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Prep is the GM's planning, and it can hold anything the players haven't learned yet.
        </MudText>
    </MudPaper>
}
else if (_loading && _adventure is null)
{
    <LoadingRows Rows="6" />
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Warning">
        That adventure isn't here. It may have been deleted. <a href="/prep" class="nornis-link">Back to Prep</a>
    </MudAlert>
}
else if (_error is not null && _adventure is null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_adventure is not null && Worlds.Current is { } world)
{
    <div class="nornis-booklet-toolbar">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   Href="@Links.Adventure(_adventure.Slug, _adventure.Id)">
            Back to the adventure
        </MudButton>
        <div class="flex-grow-1"></div>
        @if (HasProps)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Class="nornis-booklet-props"
                       StartIcon="@Icons.Material.Outlined.ContentCut" Href="@Links.Props(world.Id, _adventure.Id)">
                Print props
            </MudButton>
        }
        else
        {
            <MudTooltip Text="@NoPropsReason">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Class="nornis-booklet-props"
                           StartIcon="@Icons.Material.Outlined.ContentCut" Disabled="true">
                    Print props
                </MudButton>
            </MudTooltip>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="nornis-booklet-download"
                   StartIcon="@Icons.Material.Outlined.Download" Href="@Links.Booklet(world.Id, _adventure.Id, download: true)">
            Download
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="nornis-booklet-file"
                   StartIcon="@Icons.Material.Outlined.LibraryAdd" Disabled="_filing" OnClick="FileToLibraryAsync">
            @(_filing ? "Filing…" : "File to Library")
        </MudButton>
    </div>

    @if (_showWebNotice)
    {
        @* Feature 40: once per adventure, remembered in this browser. It warns and never blocks. *@
        <MudAlert Severity="Severity.Warning" Dense="true" Class="nornis-booklet-toolbar nornis-booklet-web-notice"
                  ShowCloseIcon="true" CloseIconClicked="DismissWebNoticeAsync">
            @WebResearchNotice.Warning
        </MudAlert>
    }

    @if (_filed is not null)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="nornis-booklet-toolbar nornis-booklet-filed">
            Filed as <a href="@Links.LibraryDocument(_filed.Slug, _filed.Id)" class="nornis-link">@_filed.Title</a>,
            GM only. Share it from the Library when the players should have it.
        </MudAlert>
    }

    @if (_fileError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="nornis-booklet-toolbar nornis-booklet-file-error">@_fileError</MudAlert>
    }

    @* The API lays the booklet out while the frame waits, which can take a while for a long
       adventure with art, so the frame wears a "working" overlay until it loads. The overlay
       says what to do if a browser never reports the load (one that downloads PDFs instead). *@
    <div class="nornis-booklet-stage">
        <iframe class="nornis-booklet-frame" src="@Links.Booklet(world.Id, _adventure.Id)" title="@_adventure.Title"
                @onload="OnBookletLoaded"></iframe>
        @if (!_bookletLoaded)
        {
            <div class="nornis-booklet-working" role="status" aria-live="polite">
                <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="nornis-serif mt-3">Laying out the booklet…</MudText>
                <MudText Typo="Typo.body2" Class="nornis-booklet-working-hint">
                    A long adventure with art can take a minute. If nothing appears, use Open the PDF below.
                </MudText>
            </div>
        }
    </div>
    <div class="nornis-booklet-open">
        <a href="@Links.Booklet(world.Id, _adventure.Id)" target="_blank" rel="noopener" class="nornis-link">Open the PDF</a>
        if your browser doesn't show it above.
    </div>
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    private bool _loading;
    private bool _notFound;
    private string? _error;
    private string? _loadedKey;
    private AdventureDto? _adventure;
    private bool _filing;
    private LibraryDocumentDto? _filed;
    private string? _fileError;
    private bool _showWebNotice;
    private bool _bookletLoaded;

    /// <summary>Why Print props is off: the sheet is the Adventure's prop boxes, and it has none.</summary>
    public const string NoPropsReason = "No prop boxes yet. Add one with the Prop button in a section, and Print props makes a page of each to cut out.";

    /// <summary>
    /// Whether any section has a prop box (feature 38), so Print props can say why it's off rather
    /// than open an empty download. The API decides what is a prop box; this only looks for its marker.
    /// </summary>
    private bool HasProps => _adventure?.Sections.Any(s => s.BodyMarkdown.Contains(PrepMarkup.PropMarker, StringComparison.Ordinal)) == true;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Key != _loadedKey)
        {
            await LoadAsync();
        }
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loadedKey = Key;
        _adventure = null;
        _filed = null;
        _fileError = null;
        _bookletLoaded = false;
        if (Worlds.Current is null || !Worlds.IsGm)
        {
            StateHasChanged();
            return;
        }

        _loading = true;
        _notFound = false;
        _error = null;
        StateHasChanged();

        // The page is addressed by slug, the booklet by id: the Adventure resolves the one to
        // the other, as every Prep page does.
        var adventure = await Api.GetAdventureAsync(Worlds.Current.Id, Key);
        _loading = false;

        if (adventure.IsSuccess)
        {
            _adventure = adventure.Value!;
            _showWebNotice = _adventure.AiUse?.ResearchedOnWeb == true && !await WebNoticeSeenAsync(_adventure.Id);
            var adventureLink = Links.Adventure(_adventure.Slug, _adventure.Id);
            Crumbs.Set($"{adventureLink}/print", new Crumb("Prep", "/prep"), new Crumb(_adventure.Title, adventureLink), new Crumb("Print"));
            if (!Links.IsCanonical(Key, _adventure.Slug))
            {
                _loadedKey = _adventure.Slug;
                Nav.NavigateTo($"{adventureLink}/print", replace: true);
            }
        }
        else if (adventure.Error!.Code == "not_found")
        {
            _notFound = true;
        }
        else
        {
            _error = adventure.Error.Message;
        }

        StateHasChanged();
    }

    /// <summary>Whether this browser has shown the web research reminder for the Adventure. Unreadable storage reads as not seen.</summary>
    private async Task<bool> WebNoticeSeenAsync(Guid adventureId)
    {
        try
        {
            return !string.IsNullOrEmpty(await JS.InvokeAsync<string?>("localStorage.getItem", WebResearchNotice.SeenKey(adventureId)));
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            return false;
        }
    }

    private async Task DismissWebNoticeAsync()
    {
        _showWebNotice = false;
        if (_adventure is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", WebResearchNotice.SeenKey(_adventure.Id), "seen");
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            // A browser that can't store it shows the reminder again next time, which is harmless.
        }
    }

    /// <summary>The frame has the PDF (or the API's error page): the overlay comes off either way.</summary>
    private void OnBookletLoaded() => _bookletLoaded = true;

    private async Task FileToLibraryAsync()
    {
        if (_adventure is null || Worlds.Current is null || _filing)
        {
            return;
        }

        _filing = true;
        _fileError = null;
        StateHasChanged();

        var result = await Api.FileAdventureBookletAsync(Worlds.Current.Id, _adventure.Id);
        _filing = false;
        if (result.IsSuccess)
        {
            _filed = result.Value;
        }
        else
        {
            _fileError = result.Error!.Message;
        }

        StateHasChanged();
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
