@page "/locations"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api

@* Locations — the place-first view over the world map (see LocationsMapExplorer for the
   explorer itself). This page owns the fetch and the world-scoped empty/error states;
   it reuses the /journey read model verbatim. *@

<PageTitle>Map — Nornis</PageTitle>

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Map</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Every place your party has been.</MudText>
    </div>
    @if (Worlds.IsGm && _journey is not null)
    {
        <MudTooltip Text="Open the map's source page, where pins can be dragged or removed.">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.EditLocationAlt"
                       Href="@Links.Source(_journey.MapSourceSlug, _journey.MapSourceId)">
                Edit pins
            </MudButton>
        </MudTooltip>
    }
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (_noMap)
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Large" Class="nornis-comingsoon-icon" />
        <MudText Typo="Typo.h5" Class="nornis-serif">No places to explore yet</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Add a map and Nornis reads the place names on it into pins. Each place then opens here
            to show the sessions that visited it.
        </MudText>
        @* The page said "Upload a map source" and had no way to. A map goes in three places
           (a Capture type, an image, a Library category) and only the first feeds this page,
           so the page that needs one is where the door is (3.32). *@
        @if (Worlds.EffectiveRole != WorldRoles.Observer)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       StartIcon="@Icons.Material.Outlined.Map" Href="/capture?type=Map">
                Add a map
            </MudButton>
        }
    </MudPaper>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_journey is null)
{
    <LoadingRows Rows="3" />
}
else
{
    <LocationsMapExplorer Journey="_journey" />
}

@code {
    private JourneyDto? _journey;
    private bool _noMap;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (Worlds.Current is null)
        {
            _journey = null;
            _error = null;
            _noMap = false;
            StateHasChanged();
            return;
        }

        _journey = null;
        _error = null;
        _noMap = false;
        StateHasChanged();

        var result = await Api.GetJourneyAsync(Worlds.Current.Id);
        if (result.IsSuccess)
        {
            _journey = result.Value!;
        }
        else if (result.Error!.Code == "no_map")
        {
            _noMap = true;
        }
        else
        {
            _error = result.Error!.Message;
        }
        StateHasChanged();
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
