@page "/world-memory"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>World Memory — Nornis</PageTitle>

<div>
    <div class="nornis-page-head">
        <div>
            <MudText Typo="Typo.h4" Class="nornis-serif">World Memory</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">How the health number is derived.</MudText>
        </div>
        @if (Worlds.IsGm)
        {
            <MudTooltip Text="AI reads the whole record and names specific continuity risks — takes 10–30s.">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Psychology"
                           OnClick="RunAssessmentAsync" Disabled="_running">
                    @(_running ? "Assessing…" : "Run assessment")
                </MudButton>
            </MudTooltip>
        }
    </div>

    @if (Worlds.Current is null)
    {
        <NoWorld />
    }
    else if (!Worlds.IsGm)
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Class="nornis-comingsoon-icon" />
            <MudText Typo="Typo.h5" Class="nornis-serif">GMs only</MudText>
            <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
                The health assessment reads the full record, including GM-only material.
            </MudText>
        </MudPaper>
    }
    else if (_loading)
    {
        <LoadingRows Rows="3" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (Assessment is not { HasData: true } assessment)
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
            <MudIcon Icon="@Icons.Material.Outlined.MonitorHeart" Size="Size.Large" Class="nornis-comingsoon-icon" />
            <MudText Typo="Typo.h5" Class="nornis-serif">No assessment yet</MudText>
            <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
                Run an assessment and the auditor will read the record and name specific continuity risks.
            </MudText>
        </MudPaper>
    }
    else
    {
        @* The number, and the arithmetic that produces it *@
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            <div class="d-flex align-center gap-4 flex-wrap">
                <div class="nornis-ring">
                    <MudProgressCircular Value="@assessment.EffectiveScore" Min="0" Max="100"
                                         Color="@DisplayText.HealthColor(assessment.EffectiveScore)" Size="Size.Large" StrokeWidth="4" />
                    <span class="nornis-ring-value">@assessment.EffectiveScore</span>
                </div>
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-wm-formula">
                        Heuristic <b>@assessment.HeuristicScore</b>
                        − findings penalty <b>@Penalty.CappedPenalty</b>@(Penalty.IsCapped ? $" (capped at {Penalty.Cap})" : "")
                        = effective <b>@assessment.EffectiveScore</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        AI audit ran @RelativeTime.Ago(assessment.CreatedAt!.Value) with @assessment.Model ·
                        the heuristic is recomputed live, so the effective score stays current between audits
                    </MudText>
                </div>
            </div>
        </MudPaper>

        @* The AI audit — findings and their penalty arithmetic *@
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
            <div class="nornis-detail-section-title">The AI audit — named risks, deterministic penalties</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                The auditor reads the whole record and names specific continuity risks; every finding
                must cite real record items or it is dropped. The AI never grades the score — each
                open finding subtracts a fixed penalty
                (@string.Join(", ", Penalty.Scale.Select(s => $"{s.Severity} {s.PenaltyEach}")), total capped at @Penalty.Cap).
                Dismissing a finding gives its points back and drops it from this list for good —
                later runs won't re-raise it. A finding whose cited evidence you have since edited
                stops counting until the next run verifies the fix.
            </MudText>

            @foreach (var line in Penalty.Lines)
            {
                <div class="nornis-cost-row">
                    <span class="nornis-cost-row-name">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@SeverityColor(line.Severity)">@line.Severity</MudChip>
                    </span>
                    <span class="nornis-list-meta">@line.Count × @line.PenaltyEach</span>
                    <span class="nornis-cost-row-amount">−@line.Subtotal</span>
                </div>
            }
            @if (Penalty.StaleSuspendedCount > 0)
            {
                <div class="nornis-cost-row">
                    <span class="nornis-cost-row-name">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Changed since audit</MudChip>
                    </span>
                    <span class="nornis-list-meta">@Penalty.StaleSuspendedCount suspended — re-run to verify</span>
                    <span class="nornis-cost-row-amount">−0</span>
                </div>
            }
            @if (OpenFindings.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No open findings — no penalty. The record looks continuous.</MudText>
            }
            else
            {
                <div class="nornis-cost-row nornis-wm-total">
                    <span class="nornis-cost-row-name">Total penalty@(Penalty.IsCapped ? $" (raw {Penalty.RawPenalty}, capped)" : "")</span>
                    <span class="nornis-cost-row-amount">−@Penalty.CappedPenalty</span>
                </div>
            }
        </MudPaper>

        @* The findings themselves *@
        @if (assessment.Findings.Count > 0)
        {
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                <div class="nornis-detail-section-title">Findings</div>
                @* Dismissed findings never arrive here — the API drops them once adjudicated. *@
                @foreach (var finding in assessment.Findings.OrderBy(f => SeverityRank(f.Severity)))
                {
                    <div class="nornis-list-row">
                        <div class="nornis-list-body">
                            <div class="nornis-list-title">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@SeverityColor(finding.Severity)">@finding.Severity</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@DisplayText.Humanize(finding.Category)</MudChip>
                                @if (finding.IsStale)
                                {
                                    <MudTooltip Text="Cited evidence was edited or removed after the audit ran — the penalty is suspended until the next run verifies the fix">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Changed since audit</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                            <div class="nornis-list-sub mt-1">@finding.Summary</div>
                            @if (!string.IsNullOrWhiteSpace(finding.SuggestedAction))
                            {
                                <div class="nornis-list-meta mt-1">Suggested: @finding.SuggestedAction</div>
                            }
                            @if (finding.EvidenceItems.Count > 0)
                            {
                                @* Every cited item is a leg of the finding — a fix that leaves one
                                   untouched is not a fix, so each ref is shown and openable. *@
                                <div class="mt-1">
                                    @foreach (var item in finding.EvidenceItems)
                                    {
                                        @if (item.ArtifactId is { } evidenceArtifactId)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                     Color="@(item.ChangedSinceAudit ? Color.Warning : Color.Default)"
                                                     Icon="@EvidenceIcon(item.Kind)"
                                                     Href="@($"/artifacts/{evidenceArtifactId}")">
                                                @item.Label@(item.ChangedSinceAudit ? " (edited)" : "")
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                                     Icon="@EvidenceIcon(item.Kind)" Disabled="true">
                                                @item.Label
                                            </MudChip>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @if (finding.Status == "Open")
                        {
                            <MudTooltip Text="AI drafts review-queue proposals addressing every cited item — nothing changes until you accept them">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Outlined.AutoFixHigh"
                                           Disabled="_draftingFindingId is not null"
                                           OnClick="() => DraftFixAsync(finding)">
                                    @(_draftingFindingId == finding.Id ? "Drafting…" : "Draft fix")
                                </MudButton>
                            </MudTooltip>
                        }
                        @if (finding.ArtifactId is { } artifactId)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@($"/artifacts/{artifactId}")">
                                Open artifact
                            </MudButton>
                        }
                        @if (finding.Status == "Open")
                        {
                            <MudTooltip Text="Dismiss — gives its penalty points back">
                                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                               OnClick="() => DismissAsync(finding)" aria-label="Dismiss finding" />
                            </MudTooltip>
                        }
                    </div>
                }
            </MudPaper>
        }
    }
</div>

@code {
    private bool _loading;
    private bool _running;
    private Guid? _draftingFindingId;
    private string? _error;

    // The assessment lives in WorldState — one shared fetch feeds this page, the Home
    // card, and the sidebar ring. Updates flow back through Worlds.SetContinuity.
    private ContinuityAssessment? Assessment => Worlds.Continuity;

    private IReadOnlyList<ContinuityFinding> OpenFindings =>
        Assessment is { HasData: true } a ? a.Findings.Where(f => f.Status == "Open").ToList() : [];

    /// <summary>
    /// The scoring rule lives in ContinuityAuditService and arrives already applied. This page
    /// used to hold a second copy of the severity table, the cap and the stale-suspension rule,
    /// across a deploy boundary no compiler or test spans.
    /// </summary>
    private ContinuityPenaltyBreakdown Penalty =>
        Assessment?.Penalty ?? ContinuityPenaltyBreakdown.Empty;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (Worlds.Current is null || !Worlds.IsGm)
        {
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        // Shared per-world fetch in WorldState — no request if the sidebar already loaded it.
        await Worlds.EnsureContinuityLoadedAsync();

        _loading = false;
        _error = Worlds.ContinuityError?.Message;
        StateHasChanged();
    }

    private async Task RunAssessmentAsync()
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _running = true;
        StateHasChanged();

        var result = await Api.RunContinuityAssessmentAsync(Worlds.Current.Id);
        _running = false;

        if (result.IsSuccess)
        {
            Worlds.SetContinuity(result.Value!);
            Snackbar.Add($"Assessment complete — {OpenFindings.Count} open finding(s).", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task DismissAsync(ContinuityFinding finding)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var result = await Api.DismissFindingAsync(Worlds.Current.Id, finding.Id);
        if (result.IsSuccess)
        {
            // Refetch rather than patching the cached assessment: the server is the only
            // place the effective score is computed, and ArtifactDetail already does this.
            await Worlds.LoadContinuityAsync();
            Snackbar.Add("Finding dismissed — its penalty points are back.", Severity.Info);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task DraftFixAsync(ContinuityFinding finding)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _draftingFindingId = finding.Id;
        StateHasChanged();

        var result = await Api.DraftFindingFixAsync(Worlds.Current.Id, finding.Id);
        _draftingFindingId = null;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            StateHasChanged();
            return;
        }

        var draft = result.Value!;
        if (draft.ProposalCount > 0)
        {
            Snackbar.Add(
                $"{draft.ProposalCount} fix proposal(s) drafted — nothing changes until you accept them.",
                Severity.Success);
            Nav.NavigateTo("/review");
            return;
        }

        Snackbar.Add(
            "The fixer found no concrete change to propose. Re-run the assessment or dismiss the finding.",
            Severity.Info);
        StateHasChanged();
    }

    private static string EvidenceIcon(string kind) => kind switch
    {
        "Artifact" => Icons.Material.Outlined.Hub,
        "Fact" => Icons.Material.Outlined.Notes,
        "Relationship" => Icons.Material.Outlined.Link,
        _ => Icons.Material.Outlined.HelpOutline,
    };

    private static Color SeverityColor(string severity) => severity switch
    {
        "High" => Color.Error,
        "Medium" => Color.Warning,
        _ => Color.Default,
    };

    private static int SeverityRank(string severity) => severity switch
    {
        "High" => 0,
        "Medium" => 1,
        _ => 2,
    };

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
