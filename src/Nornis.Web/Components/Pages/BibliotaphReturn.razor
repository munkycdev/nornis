@page "/profile/bibliotaph/{State}"
@* Where Bibliotaph sends the browser back during Connect (feature 31, Requirement 1). The page
   decides nothing: the state and Bibliotaph's outcome both go to the API, which answers with the
   Auth0 address for the grant on "connected" and Profile otherwise. The state is opaque here:
   only the API can read it. Branching on the query string here would let the address decide
   whether the authorization step runs, which is the API's call. *@
@inject NornisApiClient Api
@inject NavigationManager Nav

<PageTitle>Connecting Bibliotaph — Nornis</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    <MudButton Variant="Variant.Outlined" Href="@Links.ProfileAccount">Back to your settings</MudButton>
}
else
{
    <MudText Typo="Typo.body1">Connecting Bibliotaph…</MudText>
}

@code {
    [Parameter] public string State { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "bibliotaph")] public string? Outcome { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.ResumeBibliotaphAsync(State, Outcome);
        if (result.IsSuccess)
        {
            Nav.NavigateTo(result.Value!.Url, forceLoad: true, replace: true);
            return;
        }

        _error = result.Error!.Message;
    }
}
