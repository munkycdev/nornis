@page "/settings"
@page "/admin"
@implements IDisposable
@inject WorldState Worlds
@inject NavigationManager Nav

<PageTitle>World settings — Nornis</PageTitle>

<MudText Typo="Typo.h4" Class="nornis-serif">World settings</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    @(Worlds.IsGm
        ? "This world's settings, costs and processing, and you at its table."
        : "You at this world's table. What follows you to every world is in your account.")
</MudText>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (_form is { } form)
{
    @* Every member's since Nornis 3.31: the You tab is theirs; the GM also gets the world's five
       tabs (3.23), each hidden from everyone else rather than refused, and the API refuses their
       calls regardless. The shown tab is in the URL. Every field card shares the one form, so
       moving between tabs keeps what was typed; each card's Save sends only its own fields. *@
    @if (Tabs.Count > 1)
    {
        <TabStrip Tabs="Tabs" Active="@Shown" Selected="ShowTab" Label="World settings" Class="nornis-settings-tabs" />
    }

    <div class="nornis-settings nornis-settings-tab-@Shown">
        @switch (Shown)
        {
            case YouTab:
                <YouAtThisTablePanel />
                break;

            case PublicTab:
                <WorldSettingsPanel Form="form" Section="WorldSettingsSection.PublicPage" />
                break;

            case AiTab:
                <WorldSettingsPanel Form="form" Section="WorldSettingsSection.Budgets" Class="mb-6" />
                <CostsPanel />
                break;

            case ProcessingTab:
                <WorldSettingsPanel Form="form" Section="WorldSettingsSection.Review" Class="mb-6" />
                <StorylineBackfillCard />
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    A source that failed or is stuck in the queue can be retried from
                    <a href="/sources" class="nornis-link">Sources</a>.
                </MudText>
                break;

            case ExportTab:
                <ExportAndDeletePanel />
                break;

            case TemplateTab:
                <WorldSettingsPanel Form="form" Section="WorldSettingsSection.Template" />
                break;

            default:
                <div class="nornis-settings-world-grid">
                    <WorldSettingsPanel Form="form" Section="WorldSettingsSection.World" />
                    <KeyArtCard WorldId="Worlds.Current.Id" PublicAccessEnabled="Worlds.Current.PublicAccessEnabled"
                                OnChanged="() => Worlds.ForgetHero(Worlds.Current!.Id)" />
                </div>
                break;
        }
    </div>
}

@code {
    public const string YouTab = "you";
    public const string WorldTab = "world";
    public const string PublicTab = "public";
    public const string AiTab = "ai";
    public const string ProcessingTab = "processing";
    public const string ExportTab = "export";
    public const string TemplateTab = "template";

    private static readonly TabStrip.Item You = new(YouTab, "You");

    /// <summary>
    /// The GM's tabs: theirs at this table first, then in the order a GM reaches for them, what the
    /// world is, who can see it, what it spends, how it reads, and its end.
    /// </summary>
    public static readonly IReadOnlyList<TabStrip.Item> GmTabs =
    [
        You,
        new(WorldTab, "World"),
        new(PublicTab, "Public page"),
        new(AiTab, "AI and costs"),
        new(ProcessingTab, "Processing"),
        new(ExportTab, "Export and delete"),
    ];

    /// <summary>Everyone else's: the one tab that is theirs.</summary>
    public static readonly IReadOnlyList<TabStrip.Item> MemberTabs = [You];

    private static readonly TabStrip.Item Template = new(TemplateTab, "Template");

    /// <summary>
    /// The tabs in the strip. The Template tab is the operator's tool for making demo templates,
    /// and until 3.32 its switch was the first card every GM met on Export and delete. It is in
    /// the strip only for someone who already runs a template master (<paramref name="runsTemplates"/>),
    /// which in practice is the one person who makes them. It is hidden, not secured: the switch
    /// only moves a GM's own world in their own switcher, and the API accepts it from any GM as before.
    /// </summary>
    public static IReadOnlyList<TabStrip.Item> VisibleTabs(bool isGm, bool runsTemplates = false) =>
        !isGm ? MemberTabs : runsTemplates ? [.. GmTabs, Template] : GmTabs;

    /// <summary>
    /// The tab to show: the one the URL names, whatever its case, when this member can see it; else
    /// World for the GM and You for everyone else. A GM's tab named to a player (a shared link, or
    /// the GM viewing as a player) falls back to You rather than to a refusal. A GM may always open
    /// the Template tab by its address (?tab=template), which is how the first template master is made.
    /// </summary>
    public static string TabFor(string? tab, bool isGm) =>
        VisibleTabs(isGm, runsTemplates: true).FirstOrDefault(t => string.Equals(t.Key, tab?.Trim(), StringComparison.OrdinalIgnoreCase))?.Key
        ?? (isGm ? WorldTab : YouTab);

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    // What the URL asked for; what is shown also depends on the role, which can change under the
    // page (viewing as a player), so it is worked out at render.
    private string? _requested;

    private string Shown => TabFor(_requested, Worlds.IsGm);

    // The strip shows Template to someone who runs one, and to anyone standing on it.
    private IReadOnlyList<TabStrip.Item> Tabs =>
        VisibleTabs(Worlds.IsGm, runsTemplates: Shown == TemplateTab || Worlds.Worlds.Any(w => w.IsTemplate && w.MyRole == WorldRoles.Gm));

    private WorldSettingsForm? _form;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldsChanged;
        await Worlds.EnsureLoadedAsync();
        SyncForm();
    }

    // The URL is the authority on the tab, so Back and a pasted link both land where they say.
    protected override void OnParametersSet() => _requested = Tab;

    /// <summary>
    /// Fills the form from the world when a different world is selected. A save reloads the same
    /// world, and the form is left alone then, so what was typed on another tab is not wiped.
    /// </summary>
    private void SyncForm()
    {
        if (Worlds.Current is { } world && _form?.WorldId != world.Id)
        {
            _form = WorldSettingsForm.From(world);
        }
        else if (Worlds.Current is null)
        {
            _form = null;
        }
    }

    private void ShowTab(string tab)
    {
        if (string.Equals(Tab, tab, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _requested = tab;
        // A step in the browser's history (3.32): Back returns to the tab before.
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tab));
    }

    private void OnWorldsChanged() => InvokeAsync(() =>
    {
        SyncForm();
        StateHasChanged();
    });

    public void Dispose() => Worlds.Changed -= OnWorldsChanged;
}
