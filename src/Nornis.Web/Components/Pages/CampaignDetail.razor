@page "/campaigns/{CampaignId:guid}"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject ISnackbar Snackbar
@inject BreadcrumbState Crumbs
@inject IDialogService DialogService
@inject NavigationManager Nav

@* A campaign's own page. Every member may read it — a campaign is a place to look, not an
   authorization boundary — and the server assembles it at the caller's visibility, so a
   player's copy simply holds less. Only the editing affordances are GM-gated here; the
   server refuses regardless. *@

<PageTitle>@(_detail?.Campaign.Name ?? "Campaign") — Nornis</PageTitle>

<div>
    @if (Worlds.Current is null)
    {
        <NoWorld />
    }
    else if (_loading)
    {
        <LoadingRows Rows="4" />
    }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Warning">This campaign doesn't exist or you can't see it.</MudAlert>
    }
    else
    {
        var c = _detail.Campaign;
        <EntityPage>
        <Header>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Outlined.AutoStories" Size="Size.Large" Color="Color.Secondary" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.h5" Class="nornis-serif">@c.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@PlayedSpan()</MudText>
                </div>
                @* Which campaign the world is playing now decides what a capture files itself
                   under, so it is worth saying on the page rather than only in settings. *@
                @if (IsCurrent)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                             Icon="@Icons.Material.Filled.PlayArrow">Current</MudChip>
                }
                else if (Worlds.IsGm && c.Status == "Active")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="MakeCurrentAsync" Disabled="_settingCurrent">
                        Play this one
                    </MudButton>
                }
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@StatusColor(c.Status)">@c.Status</MudChip>
                @if (Worlds.IsGm && !_editing)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="BeginEdit" aria-label="Edit campaign" />
                }
            </div>

            @if (_editing)
            {
                @* The campaign's own facts — name, intro, status, dates — edited where they are
                   read, the way every other page here edits its own thing. *@
                <div class="mt-3">
                    <MudTextField @bind-Value="_editName" Label="Name" Required="true" MaxLength="200"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    <MudTextField @bind-Value="_editDescription" Label="Introduction" Lines="4"
                                  HelperText="What this campaign is about, in your own words. Markdown is fine."
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    <MudSelect T="string" @bind-Value="_editStatus" Label="Status" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                        @foreach (var status in CampaignStatuses)
                        {
                            <MudSelectItem Value="@status">@status</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <MudDatePicker @bind-Date="_editStartedAt" Label="Began" Clearable="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        <MudDatePicker @bind-Date="_editEndedAt" Label="Ended" Clearable="true"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                    </div>
                    @if (_editError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_editError</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="SaveEditAsync" Disabled="_saving" Class="mr-2">Save</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _editing = false">Cancel</MudButton>
                </div>
            }

            @if (IsCurrent)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    New sessions and notes are filed under this campaign unless you say otherwise.
                </MudText>
            }

            @* The GM's written intro: what this campaign is. Its generated sibling below says
               what has happened in it — the two go stale at different rates, which is why
               they are separate fields rather than one. *@
            @if (_editing)
            {
            }
            else if (!string.IsNullOrWhiteSpace(c.Description))
            {
                <div class="nornis-markdown mt-3">@MarkdownRenderer.ToHtml(c.Description)</div>
            }
            else if (Worlds.IsGm)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                    No introduction yet —
                    <MudLink OnClick="BeginEdit">write one</MudLink> to say what this campaign is about.
                </MudText>
            }
        </MudPaper>
        </Header>
        <Body>

        @if (Worlds.IsGm && _detail.UnfiledInSpan.TotalCount > 0)
        {
            @* The cleanup the dates make possible: sources filed under no campaign whose own
               date falls inside this one's. Offered, never done unasked — a side game played
               during these same years is dated inside them too, and only the GM knows which
               nights were which. Sources already filed elsewhere are never on this list. *@
            var unfiled = _detail.UnfiledInSpan;
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
                <div class="nornis-card-header">
                    <span class="nornis-card-title">Unfiled sources from these dates</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               EndIcon="@(_unfiledOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               OnClick="() => _unfiledOpen = !_unfiledOpen"
                               aria-label="Review unfiled sources">
                        @(_unfiledOpen ? "Hide" : "Review")
                    </MudButton>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(unfiled.TotalCount == 1
                        ? "One source is dated within this campaign but filed under no campaign. File it here?"
                        : $"{unfiled.TotalCount} sources are dated within this campaign but filed under no campaign. File them here?")
                </MudText>

                @if (_unfiledOpen)
                {
                    <div class="d-flex flex-column mt-2">
                        @foreach (var s in unfiled.Items)
                        {
                            <div class="d-flex align-center gap-1">
                                <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                             Value="@_fileIds.Contains(s.Id)"
                                             ValueChanged="@(v => ToggleUnfiled(s.Id, v))"
                                             aria-label="@($"File {s.Title}")" />
                                <a href="@($"/sources/{s.Id}")" class="nornis-link flex-grow-1">
                                    <span class="nornis-list-title">@s.Title</span>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                        @SourceTypeDisplay.Label(s.Type)
                                        @(s.OccurredAt is { } o ? $" · {o:yyyy-MM-dd}" : "")
                                    </MudText>
                                </a>
                            </div>
                        }
                    </div>

                    @if (unfiled.TotalCount > unfiled.Items.Count)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                            The first @unfiled.Items.Count of @unfiled.TotalCount. The rest are offered once these are filed.
                        </MudText>
                    }

                    <div class="d-flex align-center gap-2 mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.DriveFileMove"
                                   OnClick="FileUnfiledAsync" Disabled="_filing || _fileIds.Count == 0">
                            @(_fileIds.Count == 1 ? "File 1 source here" : $"File {_fileIds.Count} sources here")
                        </MudButton>
                        @if (_fileIds.Count < unfiled.Items.Count)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectAllUnfiled">Select all</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _fileIds.Clear()">Select none</MudButton>
                        }
                    </div>
                }
            </MudPaper>
        }

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
            <div class="nornis-card-header">
                <span class="nornis-card-title">The story so far</span>
                <MudTooltip Text="An LLM-written recap of this campaign's record: what happened, where things stand, what is still open.">
                    <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Tertiary" Size="Size.Small" />
                </MudTooltip>
            </div>

            @if (_detail.Recap is { HasData: true } recap)
            {
                <div class="nornis-digest-body nornis-markdown">@MarkdownRenderer.ToHtml(recap.Content)</div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                    Generated @RelativeTime.Ago(recap.GeneratedAt!.Value)
                </MudText>

                @if (Worlds.IsGm)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                               EndIcon="@(_previewOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               OnClick="() => _previewOpen = !_previewOpen"
                               aria-label="What players see">
                        What players see
                    </MudButton>
                    @if (_previewOpen)
                    {
                        <div class="nornis-digest-body nornis-digest-preview nornis-markdown">
                            @MarkdownRenderer.ToHtml(recap.PartyPreview)
                        </div>
                    }
                }
            }
            else if (Worlds.IsGm)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No recap yet.</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No recap has been written for this campaign yet.
                </MudText>
            }

            @if (Worlds.IsGm)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@(_detail.Recap.HasData ? Icons.Material.Filled.Refresh : Icons.Material.Filled.AutoAwesome)"
                           Disabled="_generating" OnClick="GenerateRecapAsync" Class="nornis-ai-run"
                           aria-label="Generate campaign recap">
                    @(_generating ? "Generating…" : _detail.Recap.HasData ? "Refresh" : "Generate recap")
                </MudButton>
                @if (_generating)
                {
                    <div class="nornis-ai-running"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /></div>
                }
            }
        </MudPaper>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
            <div class="nornis-card-header">
                <span class="nornis-card-title">Cast</span>
                @if (Worlds.IsGm && !_editingCast)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="BeginEditCastAsync" aria-label="Edit cast" />
                }
            </div>
            @if (_editingCast)
            {
                @* Every character in the world, whoever plays them; the GM says which were in this run. *@
                <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_castIds"
                           Label="Characters in this campaign" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    @foreach (var ch in _worldCharacters)
                    {
                        <MudSelectItem T="Guid" Value="@ch.Id">@ch.Name (@ch.PlayerName)</MudSelectItem>
                    }
                </MudSelect>
                @if (_castError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_castError</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="SaveCastAsync" Disabled="_saving" Class="mr-2">Save</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _editingCast = false">Cancel</MudButton>
            }
            else if (_detail.Characters.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No characters assigned.
                    @if (Worlds.IsGm)
                    {
                        <MudLink OnClick="BeginEditCastAsync">Choose the cast.</MudLink>
                    }
                </MudText>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @* The character's own page, not the artifact behind it: the page is
                       readable by every member and links on to the record when the reader
                       may see it, which the chip cannot know. This is the one member-only
                       way to reach a character you do not play. *@
                    @foreach (var ch in _detail.Characters)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Outlined.Person"
                                 title="@($"Played by {ch.PlayerName}")"
                                 Href="@($"/characters/{ch.Id}")">@ch.Name</MudChip>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-3">
            <div class="nornis-card-header">
                <span class="nornis-card-title">What this campaign touched</span>
                <MudTooltip Text="Derived from the campaign's own sources — nothing is assigned by hand, so nothing goes stale.">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Secondary" Size="Size.Small" />
                </MudTooltip>
            </div>

            @if (_detail.Artifacts.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Nothing yet. Once this campaign's sources are processed, what they mention appears here.
                </MudText>
            }
            else
            {
                <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true">
                    @foreach (var group in GroupedArtifacts())
                    {
                        <MudTabPanel Text="@($"{group.Label} ({group.Items.Count})")">
                            <div class="d-flex flex-column gap-1">
                                @foreach (var a in group.Items)
                                {
                                    <a href="@($"/artifacts/{a.Id}")" class="nornis-list-row nornis-link">
                                        <div class="nornis-list-thumb">
                                            <MudIcon Icon="@ArtifactTypeDisplay.Icon(a.Type)" Size="Size.Small" />
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-center gap-2">
                                                <span class="nornis-list-title">@a.Name</span>
                                                <span class="nornis-graph-dot"
                                                      style="background:var(--mud-palette-tertiary)"></span>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @a.SourceCount @(a.SourceCount == 1 ? "session" : "sessions")
                                                </MudText>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(a.Summary))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @DisplayText.Truncate(a.Summary, 160)
                                                </MudText>
                                            }
                                        </div>
                                    </a>
                                }
                            </div>
                        </MudTabPanel>
                    }
                </MudTabs>

                @if (_detail.ArtifactTotalCount > _detail.Artifacts.Count)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                        Showing the @_detail.Artifacts.Count most-cited of @_detail.ArtifactTotalCount.
                    </MudText>
                }
            }
        </MudPaper>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            <div class="nornis-card-header">
                <span class="nornis-card-title">Sessions</span>
                <MudLink Href="@($"/sources?campaign={CampaignId}")" Typo="Typo.caption">All sources</MudLink>
            </div>

            @if (_detail.RecentSessions.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No sources have been filed under this campaign yet.
                </MudText>
            }
            else
            {
                <div class="d-flex flex-column gap-1">
                    @foreach (var s in _detail.RecentSessions)
                    {
                        <a href="@($"/sources/{s.Id}")" class="nornis-list-row nornis-link">
                            <div class="nornis-list-thumb">
                                <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" />
                            </div>
                            <div class="flex-grow-1">
                                <span class="nornis-list-title">@s.Title</span>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                    @SourceTypeDisplay.Label(s.Type)
                                    @(s.OccurredAt is { } o ? $" · {o:yyyy-MM-dd}" : "")
                                </MudText>
                            </div>
                        </a>
                    }
                </div>

                @if (_detail.SessionCount > _detail.RecentSessions.Count)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">
                        Showing @_detail.RecentSessions.Count of @_detail.SessionCount.
                    </MudText>
                }
            }
        </MudPaper>

        @if (Worlds.IsGm)
        {
            @* Last, and quiet: deleting a campaign removes only the campaign. Sources keep their
               content and revert to no campaign; the record is untouched. *@
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
                <div class="nornis-card-header">
                    <span class="nornis-card-title">Remove this campaign</span>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Sources filed under it keep their content and revert to no campaign. Nothing else is removed.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_saving">
                    Delete campaign
                </MudButton>
            </MudPaper>
        }
        </Body>
        <Rail>
            <ContextRail Rows="@RailRows" Related="@RailRelated" RowsTitle="This campaign" RelatedTitle="Cast" />
        </Rail>
        </EntityPage>
    }
</div>

@code {
    [Parameter] public Guid CampaignId { get; set; }

    private CampaignDetailDto? _detail;
    private bool _loading = true;
    private bool _generating;
    private bool _previewOpen;
    private bool _settingCurrent;

    private static readonly string[] CampaignStatuses = ["Active", "Completed", "Archived"];

    private bool _editing;
    private bool _saving;
    private string _editName = string.Empty;
    private string? _editDescription;
    private string _editStatus = "Active";
    private DateTime? _editStartedAt;
    private DateTime? _editEndedAt;
    private string? _editError;

    private bool _editingCast;
    private IReadOnlyList<CharacterDto> _worldCharacters = [];
    private IReadOnlyCollection<Guid> _castIds = [];
    private string? _castError;

    // Stays open across the reload that follows a filing, so a long backlog is filed in
    // rounds without re-opening the list each time.
    private bool _unfiledOpen;
    private bool _filing;
    private readonly HashSet<Guid> _fileIds = [];

    private void ToggleUnfiled(Guid sourceId, bool file)
    {
        if (file)
        {
            _fileIds.Add(sourceId);
        }
        else
        {
            _fileIds.Remove(sourceId);
        }
    }

    private void SelectAllUnfiled()
    {
        _fileIds.Clear();
        _fileIds.UnionWith(_detail!.UnfiledInSpan.Items.Select(s => s.Id));
    }

    /// <summary>
    /// Files the checked sources under this campaign and reloads: the sessions list, the
    /// rollup, the span and the offer itself all change with it.
    /// </summary>
    private async Task FileUnfiledAsync()
    {
        if (Worlds.Current is null || _detail is null || _fileIds.Count == 0)
        {
            return;
        }

        _filing = true;
        var result = await Api.FileCampaignSourcesAsync(Worlds.Current.Id, CampaignId, _fileIds.ToList());
        _filing = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            return;
        }

        var filed = result.Value!.FiledCount;
        Snackbar.Add(filed == 1 ? $"Filed 1 source under {_detail.Campaign.Name}." : $"Filed {filed} sources under {_detail.Campaign.Name}.",
            Severity.Success);
        await LoadAsync();
    }

    private void BeginEdit()
    {
        var c = _detail!.Campaign;
        _editName = c.Name;
        _editDescription = c.Description;
        _editStatus = c.Status;
        _editStartedAt = c.StartedAt?.UtcDateTime.Date;
        _editEndedAt = c.EndedAt?.UtcDateTime.Date;
        _editError = null;
        _editing = true;
    }

    /// <summary>
    /// Sends what changed. A date the GM cleared is said explicitly (ClearStartedAt), because
    /// the request treats null as "leave it" — the picker cannot tell the two apart on its own.
    /// </summary>
    private async Task SaveEditAsync()
    {
        if (Worlds.Current is null || _detail is null)
        {
            return;
        }

        var c = _detail.Campaign;
        _saving = true;
        _editError = null;

        var request = new UpdateCampaignRequest(
            Name: _editName,
            Description: _editDescription ?? string.Empty,
            Status: _editStatus,
            StartedAt: AsUtcDate(_editStartedAt),
            EndedAt: AsUtcDate(_editEndedAt),
            ClearStartedAt: _editStartedAt is null && c.StartedAt is not null,
            ClearEndedAt: _editEndedAt is null && c.EndedAt is not null);

        var result = await Api.UpdateCampaignAsync(Worlds.Current.Id, CampaignId, request);
        _saving = false;

        if (!result.IsSuccess)
        {
            _editError = result.Error!.Message;
            return;
        }

        _editing = false;
        Snackbar.Add("Campaign saved.", Severity.Success);
        // The status may have cleared the world's current-campaign pointer; reload both.
        await Worlds.ReloadAsync();
        await LoadAsync();
    }

    // Picker dates are Kind.Local; DateTimeOffset's ctor throws on a local date with a zero
    // offset, so the kind is set first (the same line Capture and the character page use).
    private static DateTimeOffset? AsUtcDate(DateTime? date) =>
        date is { } d ? new DateTimeOffset(DateTime.SpecifyKind(d.Date, DateTimeKind.Utc), TimeSpan.Zero) : null;

    private async Task BeginEditCastAsync()
    {
        if (Worlds.Current is null || _detail is null)
        {
            return;
        }

        var characters = await Api.GetCharactersAsync(Worlds.Current.Id);
        _worldCharacters = characters.IsSuccess ? characters.Value! : [];
        _castIds = _detail.Characters.Select(ch => ch.Id).ToList();
        _castError = characters.IsSuccess ? null : characters.Error!.Message;
        _editingCast = true;
    }

    private async Task SaveCastAsync()
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _saving = true;
        _castError = null;
        var result = await Api.AssignCampaignCharactersAsync(Worlds.Current.Id, CampaignId, _castIds.ToList());
        _saving = false;

        if (!result.IsSuccess)
        {
            _castError = result.Error!.Message;
            return;
        }

        _editingCast = false;
        Snackbar.Add("Cast saved.", Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (Worlds.Current is null || _detail is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete campaign?",
            $"Delete \"{_detail.Campaign.Name}\"? Sources keep their content and revert to no campaign; nothing else is removed.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _saving = true;
        var result = await Api.DeleteCampaignAsync(Worlds.Current.Id, CampaignId);
        _saving = false;

        if (result.IsSuccess)
        {
            Snackbar.Add("Campaign deleted.", Severity.Info);
            await Worlds.ReloadAsync();
            Nav.NavigateTo("/campaigns");
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private bool IsCurrent => Worlds.Current?.CurrentCampaignId == CampaignId;

    /// <summary>
    /// Points the world at this campaign. Reloads world state rather than patching a local
    /// copy: the capture form reads the same pointer to default its campaign, and a page that
    /// only updated its own badge would leave the next capture filing under the old one.
    /// </summary>
    private async Task MakeCurrentAsync()
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _settingCurrent = true;
        var result = await Api.SetCurrentCampaignAsync(Worlds.Current.Id, CampaignId);
        _settingCurrent = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            return;
        }

        await Worlds.ReloadAsync();
        Snackbar.Add($"Now playing {result.Value!.Name}. New notes file here.", Severity.Success);
    }

    protected override void OnInitialized() => Worlds.Changed += OnWorldChanged;

    public void Dispose() => Worlds.Changed -= OnWorldChanged;

    private async void OnWorldChanged()
    {
        // The page is scoped to one world's campaign; switching worlds makes it meaningless.
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private IReadOnlyList<ContextRail.RailRow> RailRows => _detail is null ? [] :
    [
        new("Cast", _detail.Characters.Count.ToString()),
        new("Entries", _detail.ArtifactTotalCount.ToString()),
        new("Sessions", _detail.SessionCount.ToString(), $"/sources?campaign={CampaignId}"),
    ];

    private IReadOnlyList<ContextRail.RailLink> RailRelated => _detail is null ? [] :
        _detail.Characters
            .Take(8)
            .Select(ch => new ContextRail.RailLink(Icons.Material.Outlined.Person, ch.Name, $"/characters/{ch.Id}"))
            .ToList();

    private async Task LoadAsync()
    {
        if (Worlds.Current is null)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _previewOpen = false;
        _editing = false;
        _editingCast = false;

        var worldId = Worlds.Current.Id;
        var campaignId = CampaignId;
        var result = await Api.GetCampaignDetailAsync(worldId, campaignId);

        // A slower earlier load must not overwrite a newer one, and must not paint another
        // world's campaign onto this page.
        if (Worlds.Current?.Id != worldId || CampaignId != campaignId)
        {
            return;
        }

        _detail = result.IsSuccess ? result.Value : null;
        _loading = false;
        if (_detail is not null)
        {
            Crumbs.Set($"/campaigns/{_detail.Campaign.Id}", new Crumb("Campaigns", "/campaigns"), new Crumb(_detail.Campaign.Name));
            // Everything offered starts checked: the offer is "file these", and unchecking
            // is the exception the GM makes.
            SelectAllUnfiled();
        }
    }

    private async Task GenerateRecapAsync()
    {
        if (Worlds.Current is null || _detail is null)
        {
            return;
        }

        _generating = true;
        var result = await Api.GenerateCampaignRecapAsync(Worlds.Current.Id, CampaignId);
        _generating = false;

        if (result.IsSuccess)
        {
            _detail = _detail with { Recap = result.Value! };
            Snackbar.Add("Recap generated.", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private string PlayedSpan()
    {
        var c = _detail!.Campaign;

        var declared = (c.StartedAt, c.EndedAt) switch
        {
            ({ } s, { } e) => $"Played {s:yyyy-MM-dd} – {e:yyyy-MM-dd}",
            ({ } s, null) => $"Began {s:yyyy-MM-dd}",
            (null, { } e) => $"Ended {e:yyyy-MM-dd}",
            _ => null
        };

        // Sessions are the lived record; declared dates are what a GM typed. Show the
        // declared span when there is one and fall back to what actually happened.
        var observed = (_detail.FirstSessionAt, _detail.LastSessionAt) switch
        {
            ({ } f, { } l) when f != l => $"{f:yyyy-MM-dd} – {l:yyyy-MM-dd}",
            ({ } f, _) => $"{f:yyyy-MM-dd}",
            _ => null
        };

        var sessions = _detail.SessionCount == 1 ? "1 session" : $"{_detail.SessionCount} sessions";

        return (declared ?? observed) is { } span ? $"{span} · {sessions}" : sessions;
    }

    private static Color StatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Completed" => Color.Info,
        _ => Color.Default
    };

    private sealed record ArtifactGroup(string Label, IReadOnlyList<CampaignArtifactDto> Items);

    /// <summary>
    /// Grouped by type, most-populated group first, so a campaign's dominant shape — a cast
    /// of characters, or a tour of places — leads. Order within a group is the server's
    /// ranking (most-cited first) and is left alone.
    /// </summary>
    private IReadOnlyList<ArtifactGroup> GroupedArtifacts() =>
        _detail!.Artifacts
            .GroupBy(a => a.Type)
            .Select(g => new ArtifactGroup(ArtifactTypeDisplay.Plural(g.Key), g.ToList()))
            .OrderByDescending(g => g.Items.Count)
            .ThenBy(g => g.Label)
            .ToList();
}
