@page "/w/{Slug}/artifacts/{Key}"
@layout PublicLayout
@inject NornisApiClient Api

<PageTitle>@(_detail?.Name ?? "Codex") — Nornis</PageTitle>

<PublicWorldFrame Slug="@Slug" Active="artifacts">
    <ChildContent Context="world">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text"
                   Color="Color.Default" Href="@($"/w/{Slug}/artifacts")" Class="mb-3">Codex</MudButton>

        @if (_loading)
        {
            <LoadingRows Rows="3" />
        }
        else if (_detail is null)
        {
            <MudAlert Severity="Severity.Warning">This entry doesn't exist or isn't public.</MudAlert>
        }
        else
        {
            @* The member entry page's shape, less the GM controls: the same header, the same
               rule, the same rail — and the Loremaster's corner points at the overview's Ask. *@
            <EntityPage>
            <Header>
            <div class="nornis-detail-head">
                <div class="nornis-list-thumb"><MudIcon Icon="@ArtifactTypeDisplay.Icon(_detail.Type)" /></div>
                <div class="nornis-detail-title">
                    <MudText Typo="Typo.h4" Class="nornis-serif">@_detail.Name</MudText>
                    <div class="nornis-detail-chips">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@_detail.Type</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ArtifactTypeDisplay.StatusColor(_detail.Status)">@_detail.Status</MudChip>
                        @if (_detail.PlayedBy is { Count: > 0 } players)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary"
                                     Icon="@Icons.Material.Outlined.Person">
                                Played by @string.Join(", ", players)
                            </MudChip>
                        }
                        @if (_detail.Confidence is not null)
                        {
                            <span class="nornis-list-meta">@($"{_detail.Confidence:P0}") confidence</span>
                        }
                    </div>
                </div>
            </div>
            </Header>
            <Body>

            @if (!string.IsNullOrWhiteSpace(_detail.Summary))
            {
                <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                    <MudText Typo="Typo.body1" Class="nornis-reading">@_detail.Summary</MudText>
                </MudPaper>
            }

            @if (OpenQuestions.Count > 0)
            {
                <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                    <div class="nornis-detail-section-title">Open questions</div>
                    <div class="nornis-open-questions">
                        @foreach (var q in OpenQuestions)
                        {
                            <div class="nornis-open-question">
                                <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Color="Color.Secondary" />
                                <span>@q.Value</span>
                            </div>
                        }
                    </div>
                </MudPaper>
            }

            @if (RegularFacts.Count > 0)
            {
                <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                    <div class="nornis-detail-section-title">What's known</div>
                    @foreach (var fact in RegularFacts)
                    {
                        <div class="nornis-list-row">
                            <div class="nornis-list-body">
                                <div class="nornis-list-title">@fact.Predicate</div>
                                <div class="nornis-list-sub">@fact.Value</div>
                            </div>
                            @if (fact.TruthState is "Rumor" or "Disputed" or "False")
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@(fact.TruthState == "Rumor" ? Color.Warning : Color.Error)">
                                    @fact.TruthState
                                </MudChip>
                            }
                        </div>
                    }
                </MudPaper>
            }

            @if (_detail.ConnectedArtifacts.Count > 0)
            {
                <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                    <div class="nornis-detail-section-title">Connections</div>
                    @foreach (var rel in _detail.Relationships)
                    {
                        var other = OtherEnd(rel);
                        if (other is not null)
                        {
                            <div class="nornis-list-row">
                                <div class="nornis-list-body">
                                    <div class="nornis-list-title">
                                        <ArtifactTip Name="@other.Name" Summary="@other.Summary">
                                            <a href="@Links.PublicArtifact(Slug, other.Slug, other.Id)" class="nornis-link">@other.Name</a>
                                        </ArtifactTip>
                                    </div>
                                    <div class="nornis-list-sub">@DisplayText.Humanize(rel.Type)@(rel.Description is null ? "" : $" — {rel.Description}")</div>
                                </div>
                            </div>
                        }
                    }
                </MudPaper>
            }

            @if (_detail.SourceReferences.Count > 0)
            {
                <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                    <div class="nornis-detail-section-title">Source references</div>
                    @foreach (var s in _detail.SourceReferences)
                    {
                        <div class="nornis-source-ref">
                            <MudIcon Icon="@Icons.Material.Outlined.FormatQuote" Size="Size.Small" Color="Color.Tertiary" />
                            <div>
                                @if (!string.IsNullOrWhiteSpace(s.Quote))
                                {
                                    <span class="nornis-source-quote">“@s.Quote”</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(s.Notes))
                                {
                                    <span class="nornis-list-sub">@s.Notes</span>
                                }
                                @if (s.SourceTitle is not null)
                                {
                                    <a href="@Links.PublicSource(Slug, s.SourceSlug, s.SourceId)" class="nornis-link nornis-list-sub">@s.SourceTitle</a>
                                }
                            </div>
                        </div>
                    }
                </MudPaper>
            }
            </Body>
            <Rail>
                <ContextRail Rows="@RailRows" Related="@RailRelated" RelatedTitle="Connected" ShowLoremaster="false">
                    <PublicAskLink Slug="@Slug" Enabled="world.AskEnabled" />
                </ContextRail>
            </Rail>
            </EntityPage>
        }
    </ChildContent>
</PublicWorldFrame>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    /// <summary>The slug, or an id from a link minted before slugs; see <see cref="Links"/>.</summary>
    [Parameter] public string Key { get; set; } = string.Empty;

    private bool _loading = true;
    private ArtifactDetailDto? _detail;
    private (string Slug, string Key)? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedKey == (Slug, Key))
        {
            return;
        }
        var key = (Slug, Key);
        _loadedKey = key;
        _loading = true;
        var result = await Api.GetPublicArtifactAsync(Slug, Key);

        // Overlapping loads do not return in the order they were sent, so without this the
        // slowest wins and shows the artifact a visitor clicked past. _loadedKey is the
        // sequence marker — a newer load overwrote it before its own await.
        if (_loadedKey != key)
        {
            return;
        }

        _detail = result.IsSuccess ? result.Value : null;
        _loading = false;
    }

    // Convention over schema (mirrors ArtifactDetail): unresolved tensions live as facts
    // with the exact predicate "open question"; answering one flips its truth to False.
    private const string OpenQuestionPredicate = "open question";

    private IReadOnlyList<ArtifactFactDto> OpenQuestions =>
        _detail is null
            ? []
            : _detail.Facts
                .Where(f => string.Equals(f.Predicate, OpenQuestionPredicate, StringComparison.OrdinalIgnoreCase)
                            && f.TruthState != "False")
                .ToList();

    private IReadOnlyList<ArtifactFactDto> RegularFacts =>
        _detail is null
            ? []
            : _detail.Facts
                .Where(f => !string.Equals(f.Predicate, OpenQuestionPredicate, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private ConnectedArtifact? OtherEnd(ArtifactRelationshipDto rel)
    {
        var otherId = rel.ArtifactAId == _detail?.Id ? rel.ArtifactBId : rel.ArtifactAId;
        return _detail?.ConnectedArtifacts.FirstOrDefault(c => c.Id == otherId);
    }

    private IReadOnlyList<ContextRail.RailRow> RailRows => _detail is null ? [] :
    [
        new("Sources", _detail.SourceReferences.Count.ToString()),
        new("Facts", _detail.Facts.Count.ToString()),
        new("Relationships", _detail.Relationships.Count.ToString()),
    ];

    private IReadOnlyList<ContextRail.RailLink> RailRelated => _detail is null ? [] :
        _detail.ConnectedArtifacts
            .Take(8)
            .Select(c => new ContextRail.RailLink(ArtifactTypeDisplay.Icon(c.Type), c.Name, Links.PublicArtifact(Slug, c.Slug, c.Id)))
            .ToList();
}
