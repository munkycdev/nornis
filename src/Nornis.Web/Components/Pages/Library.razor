@page "/library"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Library — Nornis</PageTitle>

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Library</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Sourcebooks, maps, and handouts — reference material, not world memory.
            Indexed PDFs answer through the Loremaster with page citations.
        </MudText>
    </div>
    @if (Worlds.Current is not null && Worlds.EffectiveRole != "Observer")
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.UploadFile"
                   OnClick="OpenUploadAsync">
            Add to library
        </MudButton>
    }
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (_loading)
{
    <LoadingRows Rows="3" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    @if (_bibliotaph is { } shelf && shelf.State != LibraryBibliotaphDto.None)
    {
        <MudAlert Severity="@StripSeverity(shelf.State)" Dense="true" Variant="Variant.Text" Class="mb-3 nornis-library-bibliotaph">
            @StripText(shelf)
            @if (shelf.State == LibraryBibliotaphDto.NeedsReconnect && Worlds.IsGm)
            {
                <text> </text><a href="@Links.ProfileAccount" class="nornis-link">Reconnect in your settings.</a>
            }
        </MudAlert>
    }

    @if (_documents.Count == 0)
    {
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Large" Class="nornis-comingsoon-icon" />
        <MudText Typo="Typo.h5" Class="nornis-serif">The shelves are empty</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Upload adventure sourcebooks and the Loremaster can quote them mid-session —
            "what happens at level 8?" answered with page citations.
        </MudText>
        @if (Worlds.Current is not null && Worlds.EffectiveRole != WorldRoles.Observer)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       StartIcon="@Icons.Material.Outlined.UploadFile" OnClick="OpenUploadAsync">
                Add the first book
            </MudButton>
        }
    </MudPaper>
}
else
{
    <div class="nornis-filter-row mb-2 nornis-library-filters">
        <MudChip T="string" Size="Size.Medium"
                 Variant="@(_view.Category is null ? Variant.Filled : Variant.Outlined)"
                 Color="@(_view.Category is null ? Color.Secondary : Color.Default)"
                 OnClick="() => ChooseCategoryAsync(null)">All · @LibraryFilter.Total(_documents, _view.Scope)</MudChip>
        @foreach (var (category, count) in LibraryFilter.Counts(_documents, _view.Scope))
        {
            var c = category;
            <MudChip T="string" Size="Size.Small"
                     Variant="@(_view.Category == c ? Variant.Filled : Variant.Outlined)"
                     Color="@(_view.Category == c ? Color.Secondary : Color.Default)"
                     OnClick="() => ChooseCategoryAsync(c)">@LibraryDisplay.ChipLabel(c) · @count</MudChip>
        }
    </div>

    <div class="d-flex gap-3 align-center flex-wrap mb-3 nornis-library-tools">
        @if (Worlds.IsGm && _adventureMenu.Count > 0)
        {
            <MudSelect T="string" Value="@ScopeValue" ValueChanged="ChooseScope" Label="Adventure"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Class="nornis-library-adventure-menu" Style="max-width: 16rem;">
                <MudSelectItem Value="@ShelfValue">Shelf</MudSelectItem>
                <MudSelectItem Value="@EverythingValue">Everything</MudSelectItem>
                @foreach (var adventure in _adventureMenu)
                {
                    <MudSelectItem Value="@adventure.Id.ToString()">@adventure.Title</MudSelectItem>
                }
            </MudSelect>
        }
        <MudTextField T="string" Value="@_view.Search" ValueChanged="Search" Immediate="true"
                      Placeholder="Search titles" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Class="flex-grow-1 nornis-library-search" />
        <div class="nornis-library-sort">
            @foreach (var sort in Enum.GetValues<LibrarySort>())
            {
                var s = sort;
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_view.Sort == s ? Variant.Filled : Variant.Outlined)"
                         Color="@(_view.Sort == s ? Color.Secondary : Color.Default)"
                         OnClick="() => _view = _view with { Sort = s }">@s</MudChip>
            }
        </div>
    </div>

    @if (Visible.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-library-filter-empty">
            @LibraryDisplay.EmptyFilterText(_view.Category, !string.IsNullOrWhiteSpace(_view.Search))
        </MudText>
    }
    else
    {
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
        @foreach (var doc in Visible)
        {
            <div class="nornis-list-row">
                <div class="nornis-list-thumb">
                    @if (doc.HasCover)
                    {
                        <img src="@($"/library-covers/{doc.WorldId}/{doc.Id}")" alt="" class="nornis-library-cover" loading="lazy" />
                    }
                    else
                    {
                        <MudIcon Icon="@LibraryDisplay.KindIcon(doc.Kind)" Size="Size.Small" />
                    }
                </div>
                <div class="nornis-list-body">
                    <a href="@Links.LibraryDocument(doc.Slug, doc.Id)" class="nornis-list-title nornis-link">@doc.Title</a>
                    <div class="nornis-list-sub">
                        <span class="nornis-library-category">@doc.Category</span>@(doc.IsFromBibliotaph ? "" : $" · {DisplayText.FormatSize(doc.SizeBytes)}")@(doc.PageCount is { } p ? $" · {p} pages" : "")
                    </div>
                    @if (Worlds.IsGm && doc.LinkedAdventureId is { } linkedId)
                    {
                        <div class="nornis-list-sub nornis-library-adventure-tag">
                            For <a href="@Links.Adventure(null, linkedId)" class="nornis-link">@AdventureTitle(linkedId)</a>
                        </div>
                    }
                    @if (Worlds.IsGm && doc.AdventureId is { } adventureId)
                    {
                        <div class="nornis-list-sub nornis-library-printed">
                            Printed from <a href="@Links.Adventure(null, adventureId)" class="nornis-link">Prep</a>
                        </div>
                    }
                </div>
                <BibliotaphBadge Document="doc" />
                <LibraryVisibilityChip Document="doc" OnChanged="LoadAsync" />
                @if (!doc.IsFromBibliotaph)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@LibraryDisplay.StatusColor(doc.Status)">
                        @LibraryDisplay.StatusLabel(doc.Status, doc.ChunkCount)
                    </MudChip>
                }
                @if (doc.Status == "IndexFailed")
                {
                    <MudTooltip Text="@($"Retry indexing. {doc.ErrorMessage}")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small"
                                       OnClick="() => ReindexAsync(doc)" aria-label="Retry indexing" />
                    </MudTooltip>
                }
                @if (doc.InBibliotaph)
                {
                    <MudTooltip Text="Read in Bibliotaph">
                        <MudIconButton Icon="@Icons.Material.Outlined.AutoStories" Size="Size.Small"
                                       OnClick="() => OpenAsync(doc)" aria-label="Open" />
                    </MudTooltip>
                }
                @if (!doc.IsFromBibliotaph)
                {
                    <MudTooltip Text="Download">
                        <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small"
                                       OnClick="() => DownloadAsync(doc)" aria-label="Download" />
                    </MudTooltip>
                }
                @if (Worlds.IsGm)
                {
                    <MudTooltip Text="Rename">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                       OnClick="() => RenameAsync(doc)" aria-label="Rename" />
                    </MudTooltip>
                }
                @if (Worlds.IsGm && doc.IsFromBibliotaph)
                {
                    <MudTooltip Text="Take it out of the world's collection in Bibliotaph to remove it here">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Disabled="true"
                                       aria-label="Delete (in Bibliotaph)" />
                    </MudTooltip>
                }
                else if (Worlds.IsGm)
                {
                    <MudTooltip Text="@(doc.Status == "Indexing" ? "Available once indexing finishes" : "Delete")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                       Disabled="@(doc.Status == "Indexing")"
                                       OnClick="() => DeleteAsync(doc)" aria-label="Delete" />
                    </MudTooltip>
                }
            </div>
        }
    </MudPaper>
    }
}

}

@code {
    private bool _loading;
    private string? _error;
    private IReadOnlyList<LibraryDocumentDto> _documents = [];
    private LibraryBibliotaphDto? _bibliotaph;

    // Feature 36: the chips, the Adventure menu (GM only), search and sort, all over _documents.
    private const string CategoryStorageKey = "nornis.library.category";
    private const string ShelfValue = "shelf";
    private const string EverythingValue = "everything";
    private LibraryView _view = new();
    private IReadOnlyList<AdventureSummaryDto> _adventures = [];
    private IReadOnlyList<AdventureSummaryDto> _adventureMenu = [];

    private IReadOnlyList<LibraryDocumentDto> Visible => LibraryFilter.Apply(_documents, _view);

    private string ScopeValue => _view.Scope.Kind switch
    {
        LibraryScopeKind.Everything => EverythingValue,
        LibraryScopeKind.Adventure => _view.Scope.AdventureId.ToString()!,
        _ => ShelfValue,
    };

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await RestoreCategoryAsync();
        await LoadAsync();
    }

    private void ChooseScope(string value)
    {
        _view = _view with
        {
            Scope = value switch
            {
                EverythingValue => LibraryScope.Everything,
                _ when Guid.TryParse(value, out var id) => LibraryScope.ForAdventure(id),
                _ => LibraryScope.Shelf,
            },
        };
    }

    private void Search(string? text) => _view = _view with { Search = text };

    private string AdventureTitle(Guid id) =>
        _adventures.FirstOrDefault(a => a.Id == id)?.Title ?? "an adventure";

    private async Task ChooseCategoryAsync(string? category)
    {
        _view = _view with { Category = category };
        // Remembered for this browser only, like a filter; a blocked or missing store just forgets.
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", CategoryStorageKey, category ?? string.Empty);
        }
        catch (JSException)
        {
        }
    }

    private async Task RestoreCategoryAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", CategoryStorageKey);
            _view = _view with { Category = LibraryDocumentDto.Categories.Contains(saved) ? saved : null };
        }
        catch (JSException)
        {
        }
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (Worlds.Current is null)
        {
            _documents = [];
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        // Bibliotaph first: it brings the rows up to date, so the list below includes new books.
        var shelf = await Api.GetLibraryBibliotaphAsync(Worlds.Current.Id);
        _bibliotaph = shelf.IsSuccess ? shelf.Value : null;
        var result = await Api.GetLibraryAsync(Worlds.Current.Id);

        _loading = false;
        if (result.IsSuccess)
        {
            _documents = result.Value!;
        }
        else
        {
            _error = result.Error!.Message;
        }

        // The Adventure menu and tags are the GM's organisation; players never ask for them.
        if (Worlds.IsGm && result.IsSuccess)
        {
            var adventures = await Api.GetAdventuresAsync(Worlds.Current.Id);
            _adventures = adventures.IsSuccess ? adventures.Value! : [];
        }
        else
        {
            _adventures = [];
        }
        _adventureMenu = LibraryFilter.AdventuresWithDocuments(_documents, _adventures);
        if (_view.Scope.Kind == LibraryScopeKind.Adventure && _adventureMenu.All(a => a.Id != _view.Scope.AdventureId))
        {
            _view = _view with { Scope = LibraryScope.Shelf };
        }
        StateHasChanged();
    }

    private async Task OpenUploadAsync()
    {
        var dialog = await DialogService.ShowAsync<LibraryUploadDialog>("Add to library",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DownloadAsync(LibraryDocumentDto doc)
    {
        if (Worlds.Current is null) return;
        var result = await Api.GetLibraryDownloadAsync(Worlds.Current.Id, doc.Id);
        if (result.IsSuccess)
        {
            await JS.InvokeVoidAsync("nornisUpload.open", result.Value!.DownloadUrl);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task OpenAsync(LibraryDocumentDto doc)
    {
        if (Worlds.Current is null) return;
        var result = await Api.ReadLibraryDocumentAsync(Worlds.Current.Id, doc.Id, null);
        if (result.IsSuccess)
        {
            await JS.InvokeVoidAsync("nornisUpload.open", result.Value!.Url);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Warning);
        }
    }

    private async Task RenameAsync(LibraryDocumentDto doc)
    {
        if (Worlds.Current is null) return;

        var parameters = new DialogParameters<RenameLibraryDocumentDialog>
        {
            { d => d.WorldId, Worlds.Current.Id },
            { d => d.DocumentId, doc.Id },
            { d => d.CurrentTitle, doc.Title },
        };

        var dialog = await DialogService.ShowAsync<RenameLibraryDocumentDialog>("Rename document", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Document renamed.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(LibraryDocumentDto doc)
    {
        if (Worlds.Current is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete document?",
            $"Remove \"{doc.Title}\" from the library? Its file and indexed passages are deleted.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var result = await Api.DeleteLibraryDocumentAsync(Worlds.Current.Id, doc.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add($"\"{doc.Title}\" removed from the library.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task ReindexAsync(LibraryDocumentDto doc)
    {
        if (Worlds.Current is null) return;
        var result = await Api.ReindexLibraryDocumentAsync(Worlds.Current.Id, doc.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add("Indexing queued.", Severity.Info);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private static Severity StripSeverity(string state) => state switch
    {
        LibraryBibliotaphDto.Ok => Severity.Normal,
        LibraryBibliotaphDto.NeedsReconnect or LibraryBibliotaphDto.Unreachable => Severity.Warning,
        _ => Severity.Info,
    };

    private static string StripText(LibraryBibliotaphDto shelf)
    {
        var whose = string.IsNullOrWhiteSpace(shelf.OwnerName) ? "the GM's" : $"{shelf.OwnerName}'s";
        return shelf.State switch
        {
            LibraryBibliotaphDto.Ok => $"Books from {whose} Bibliotaph appear here alongside uploads.",
            LibraryBibliotaphDto.NeedsReconnect => $"{Capitalize(whose)} Bibliotaph needs reconnecting, so its books may be out of date.",
            LibraryBibliotaphDto.Opening => $"{Capitalize(whose)} Bibliotaph is opening. These are its books as they were last seen.",
            LibraryBibliotaphDto.NotSetUp => "Bibliotaph is still setting up this world's collection.",
            _ => "Bibliotaph couldn't be reached. These are its books as they were last seen.",
        };
    }

    private static string Capitalize(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
