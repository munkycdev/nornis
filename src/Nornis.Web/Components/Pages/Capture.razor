@page "/capture"
@inject WorldState Worlds
@inject NornisApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Capture — Nornis</PageTitle>

<MudText Typo="Typo.h4" Class="nornis-serif">Tell Nornis what happened</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Add a source. Nornis reads it and proposes updates to your world record.
</MudText>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else
{
    <div class="nornis-dashboard">
        <div class="nornis-dashboard-main">
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
                <MudTextField @bind-Value="_title"
                              Label="Title"
                              Required="true"
                              Immediate="true"
                              MaxLength="200"
                              Variant="Variant.Outlined"
                              Class="mb-3" />

                <div class="d-flex gap-3 mb-3">
                    <MudSelect @bind-Value="SelectedType" Label="Type" Variant="Variant.Outlined" Class="flex-grow-1">
                        @foreach (var (value, label) in SourceTypeDisplay.CaptureOptions)
                        {
                            <MudSelectItem Value="@value">@label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect @bind-Value="_visibility" Label="Visibility" Variant="Variant.Outlined" Class="flex-grow-1">
                        @foreach (var vis in VisibilityDisplay.Scopes)
                        {
                            <MudSelectItem Value="@vis">@vis</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (FilePlanForType is { } plan)
                {
                    @* Files go straight to blob via the SAS handshake; the worker derives
                       text (transcription / vision read / PDF text) before extraction. *@
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        @plan.Hint
                    </MudText>

                    @if (_transcribed)
                    {
                        @* Photographs are done with: the reading is in the editor below, and
                           picking new ones now would leave the source carrying page images
                           the text no longer came from. Retake is the way back. *@
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            <div class="d-flex align-center justify-space-between gap-3">
                                <span>@($"Read {_pageFiles.Count} {(_pageFiles.Count == 1 ? "page" : "pages")}. Check the text below before saving.")</span>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit"
                                           StartIcon="@Icons.Material.Filled.Replay"
                                           OnClick="RetakeAsync" Disabled="_busy">
                                    Retake
                                </MudButton>
                            </div>
                        </MudAlert>
                    }
                    else
                    {
                        @* Choosing photos is the same button on every device; only the camera
                           is device-specific, because `capture` is advertised by desktop
                           browsers and ignored by them — a camera button on a laptop opens the
                           ordinary file dialog under a label that cannot deliver on it.

                           These are LABELS, not buttons that call into script. A file picker
                           may only open while the user's gesture is still live, and on Blazor
                           Server a click handler answers from the other end of a SignalR round
                           trip — by which point Safari has stopped listening, so the button did
                           nothing at all on iOS. A label opens its own input natively, in the
                           gesture, before any of that. *@
                        @if (IsHandwritten)
                        {
                            @* Three ways to hand over the same thing, so they read as peers:
                               one style, one size, side by side where there is room and stacked
                               full-width on a phone where there is not. Writing by hand is
                               offered on every device; the two picker routes belong to touch. *@
                            <div class="nornis-pick-row mb-3">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Draw" Href="/capture/ink">
                                    Write by hand
                                </MudButton>
                                <MudButton HtmlTag="label" for="@_cameraInputId"
                                           Class="nornis-pick-touch"
                                           Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PhotoCamera" Disabled="_busy">
                                    Take a photo
                                </MudButton>
                                <MudButton HtmlTag="label" for="@_libraryInputId"
                                           Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PhotoLibrary" Disabled="_busy">
                                    Choose photos
                                </MudButton>
                            </div>

                            @* Camera-only, and never the visible control — its label is. The
                               `capture` hint lives in the markup because that is the only way it
                               can be set before the picker opens. *@
                            <InputFile id="@_cameraInputId" multiple capture="environment"
                                       OnChange="@(e => OnPagesSelected(e, _cameraInputId))"
                                       class="nornis-pick-offscreen" accept="@plan.Accept" />
                        }
                        @if (plan.Multiple)
                        {
                            <InputFile id="@_libraryInputId" OnChange="@(e => OnPagesSelected(e, _libraryInputId))"
                                       multiple class="@FilePickerClass" accept="@plan.Accept" />
                        }
                        else
                        {
                            <InputFile id="@_libraryInputId" OnChange="@(e => OnPagesSelected(e, _libraryInputId))"
                                       class="@FilePickerClass" accept="@plan.Accept" />
                        }
                    }

                    @if (_pageFiles.Count > 0)
                    {
                        <div class="mb-3">
                            @for (var i = 0; i < _pageFiles.Count; i++)
                            {
                                @* Local copies: MudText's child content renders after the
                                   loop finishes, so referencing i directly is off-by-N. *@
                                var fileNumber = i + 1;
                                var page = _pageFiles[i];
                                <MudText Typo="Typo.body2">@($"File {fileNumber}: {page.Name} ({DisplayText.FormatSize(page.Size)})")</MudText>
                            }
                        </div>
                    }
                    @if (_busy && _pageFiles.Count > 0 && !_reading)
                    {
                        <MudProgressLinear Value="@_uploadProgress" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            Uploading file @(_uploadingIndex + 1) of @_pageFiles.Count…
                        </MudText>
                    }

                    @if (_type == "HandwrittenNotes" && !_transcribed && _pageFiles.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   OnClick="TranscribeAsync" Disabled="_busy">
                            @(_reading ? "Reading the handwriting…" : "Read the handwriting")
                        </MudButton>
                        @if (_reading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mb-2" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                                This takes a moment — Nornis is reading every page before you check it.
                            </MudText>
                        }
                    }
                }

                @if (ShowEditor)
                {
                    @if (_transcribed && _transcriptionWasBlank)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                            Nornis found no readable handwriting on those pages. Type the notes
                            yourself, or retake the photos in better light.
                        </MudAlert>
                    }
                    <div class="mb-3">
                        <NotesEditor @ref="_editor" InitialMarkdown="@_transcription"
                                     Placeholder="@EditorPlaceholder" />
                    </div>
                }

                @* A Web Link source is the one whose subject IS a URL. On every other type the
                   field asked for something the extraction pipeline never reads, which is worth
                   fewer inputs between a GM and a saved note. *@
                @if (IsWebLink)
                {
                    <MudTextField @bind-Value="_uri"
                                  Label="Link"
                                  Placeholder="https://…"
                                  Variant="Variant.Outlined"
                                  Class="mb-3" />
                }

                <MudDatePicker @bind-Date="_occurredAt"
                               Label="When it happened (optional)"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="mb-3" />

                @if (_campaigns.Count > 0)
                {
                    <MudSelect T="Guid?" @bind-Value="_campaignId" Label="Campaign (optional)"
                               Variant="Variant.Outlined" Class="mb-3"
                               HelperText="Which campaign these events happened in. Leave empty for world lore or prep.">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">No campaign</MudSelectItem>
                        @foreach (var c in _campaigns)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)c.Id)">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudCheckBox T="bool" @bind-Value="_extractionEnabled" Color="Color.Secondary" Dense="true" Class="mb-1"
                             Label="Extract knowledge from this source" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    @(_extractionEnabled
                        ? "Nornis will read it and propose artifacts, facts, and relationships for review."
                        : "Stored in the record as-is — no proposals, no changes to canon.")
                </MudText>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
                }

                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="() => SaveAsync(process: false)"
                               Disabled="_busy">
                        Save draft
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               StartIcon="@(_extractionEnabled ? Icons.Material.Filled.AutoAwesome : Icons.Material.Filled.Inventory2)"
                               OnClick="() => SaveAsync(process: true)"
                               Disabled="_busy">
                        @(_extractionEnabled ? "Save & process" : "Save to record")
                    </MudButton>
                </div>
            </MudPaper>
        </div>

        <div class="nornis-rail nornis-capture-rail">
            <LoremasterPanel />
        </div>
    </div>
}

@code {


    // Set from the dashboard capture tiles, e.g. /capture?type=WebLink.
    [Parameter, SupplyParameterFromQuery]
    public string? Type { get; set; }

    private string _title = string.Empty;
    private string _type = "SessionNote";
    private string _visibility = "PartyVisible";
    private NotesEditor? _editor;
    private string? _uri;
    // Defaults to today — most captures describe the session just played.
    private DateTime? _occurredAt = DateTime.Today;
    private Guid? _campaignId;
    private IReadOnlyList<CampaignDto> _campaigns = [];
    private bool _extractionEnabled = true;
    private bool _busy;
    private string? _error;

    // ------------------------------------------------ Read-before-extract (handwriting) --
    // A handwritten source is saved as a draft, transcribed, corrected, and only then sent
    // for extraction — so the words that become canon are the ones the GM approved rather
    // than the ones a vision model guessed. The other types still go straight through and
    // are read during processing.

    /// <summary>The draft this page is editing, once one exists. Null until the first save
    /// or the first transcription — both of which need a row to hang attachments off, and
    /// must therefore use the same one rather than each creating its own.</summary>
    private Guid? _sourceId;

    private bool _pagesUploaded;
    private bool _reading;
    private bool _transcribed;
    private bool _transcriptionWasBlank;
    private string? _transcription;

    private bool IsHandwritten => _type == "HandwrittenNotes";

    private bool IsWebLink => _type == "WebLink";

    /// <summary>
    /// The type, plus the one thing that has to happen when it changes: a link typed for a Web
    /// Link source is dropped on the way out of that type. The field is gone from the form by
    /// then, and saving a URL the GM can no longer see or delete is worse than losing it.
    /// </summary>
    private string SelectedType
    {
        get => _type;
        set
        {
            _type = value;

            if (!IsWebLink)
            {
                _uri = null;
            }
        }
    }

    /// <summary>
    /// Handwriting gets its editor only once there is a reading to correct; every other type
    /// has it from the start, for the notes themselves or as context for a file.
    /// </summary>
    private bool ShowEditor => !IsHandwritten || _transcribed;

    /// <summary>
    /// Handwriting has labelled buttons standing in for the file box on every device, so its
    /// input is never the visible control. The other types have no such buttons — hiding the
    /// box for them would leave a map or a PDF with no way to attach anything at all.
    /// </summary>
    private string FilePickerClass =>
        IsHandwritten ? "nornis-pick-offscreen" : "nornis-upload-input mb-2";

    private string EditorPlaceholder =>
        _transcribed ? "Fix anything Nornis misread — names especially."
        : FilePlanForType is null ? "Paste session notes, a journal entry, a transcript… Type # for a heading, - for a list, **bold**."
        : "Optional notes to go with the file(s) — context, captions, what to look for.";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Type) && SourceTypeDisplay.IsCaptureOption(Type))
        {
            _type = Type;
        }
        await Worlds.EnsureLoadedAsync();

        if (Worlds.Current is not null)
        {
            var campaigns = await Api.GetCampaignsAsync(Worlds.Current.Id);
            if (campaigns.IsSuccess)
            {
                _campaigns = campaigns.Value!;

                // The world says which campaign it is playing; this form does not guess. It
                // used to infer "the only active one", which was right for one campaign and
                // gave up for two — and giving up meant filing a session under no campaign at
                // all. Null here is a world with none chosen, and stays "No campaign".
                var current = Worlds.Current.CurrentCampaignId;
                if (current is not null && _campaigns.Any(c => c.Id == current))
                {
                    _campaignId = current;
                }
            }
        }
    }

    // ----------------------------------------------------------- File attachments --

    /// <summary>Per-type file behavior: attachment kind, multiplicity, accepted extensions.</summary>
    private sealed record FilePlan(string Kind, bool Multiple, string Accept, string Hint);

    private FilePlan? FilePlanForType => _type switch
    {
        // accept is image/* rather than a list of extensions: on a phone that is what puts
        // the camera in the picker, and whatever comes back — HEIC included — is re-encoded
        // to JPEG in the browser before the API is asked for an upload ticket.
        // No "above" or "below": which of the three routes a device shows, and where, is the
        // stylesheet's business now.
        "HandwrittenNotes" => new("PageImage", true, "image/*",
            "Photograph the pages in reading order, or write them out by hand in Nornis. Either "
            + "way Nornis reads the handwriting and shows you the text to correct before anything "
            + "reaches your world record."),
        "Image" => new("ImageFile", true, ".png,.jpg,.jpeg,.webp,.gif",
            "Nornis reads the image(s) for lore — people, places, things — and combines that with any notes you type."),
        "Upload" => new("Document", true, ".pdf,.txt,.md,.markdown,.png,.jpg,.jpeg,.webp,.gif",
            "PDF text is extracted, text files are read, images are vision-read — then combined with your notes."),
        "Map" => new("MapImage", false, ".png,.jpg,.jpeg,.webp,.gif",
            "Nornis reads place names and positions off the map and proposes Location artifacts with pins."),
        _ => null,
    };

    // Two inputs rather than one, because `capture` has to be on the element before the
    // picker opens and only markup can guarantee that. Which one the files came from decides
    // whose re-encoded blobs get uploaded, so the choice is remembered rather than assumed.
    private readonly string _cameraInputId = $"nornis-pages-camera-{Guid.NewGuid():N}";
    private readonly string _libraryInputId = $"nornis-pages-library-{Guid.NewGuid():N}";
    private string? _activeInputId;
    private List<PickedFile> _pageFiles = [];
    private int _uploadingIndex;
    private int _uploadProgress;
    private DotNetObjectReference<Capture>? _selfRef;

    /// <summary>The ceiling on pages in one source, and the same number the browser bounds
    /// its re-encoded copies by — it holds a JPEG per page in memory until upload.</summary>
    private const int MaxPageFiles = 50;

    /// <summary>
    /// What a page image is re-encoded to before upload. A phone shoots twelve megapixels of
    /// HEIC; the API accepts neither the format nor, comfortably, the size, and the same
    /// pixels are billed as vision input. Handwriting stays legible far below what the camera
    /// produces, so this is the quality the transcription needs rather than the quality the
    /// camera offers.
    /// </summary>
    private const int PageMaxEdgePixels = 2048;

    private const double PageJpegQuality = 0.85;

    private async Task OnPagesSelected(InputFileChangeEventArgs e, string inputId)
    {
        var max = FilePlanForType is { Multiple: false } ? 1 : MaxPageFiles;
        _activeInputId = inputId;

        if (IsHandwritten)
        {
            // Re-encode first, then describe: the upload ticket is minted against a file name,
            // size and content type, and it must describe the bytes that will actually be PUT
            // rather than the HEIC the camera handed over.
            var prepared = await JS.InvokeAsync<PickedFile[]>(
                "nornisUpload.prepareImages", inputId, max, PageMaxEdgePixels, PageJpegQuality);
            _pageFiles = [.. prepared];
            _pagesUploaded = false;
            return;
        }

        _pageFiles = e.GetMultipleFiles(max)
            .Select(f => new PickedFile(f.Name, f.Size, f.ContentType))
            .ToList();
        _pagesUploaded = false;
    }

    [JSInvokable]
    public void OnUploadProgress(int percent)
    {
        _uploadProgress = percent;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Uploads each selected file via the SAS handshake under the given
    /// attachment kind. Returns null on success, or the failing file's error message.</summary>
    private async Task<string?> UploadFilesAsync(Guid worldId, Guid sourceId, string kind)
    {
        _selfRef ??= DotNetObjectReference.Create(this);

        for (var i = 0; i < _pageFiles.Count; i++)
        {
            _uploadingIndex = i;
            _uploadProgress = 0;
            StateHasChanged();

            var page = _pageFiles[i];
            var ticket = await Api.RequestSourceAttachmentUploadAsync(worldId, sourceId,
                new RequestSourceAttachmentUploadRequest(page.Name, page.Type, page.Size, kind, Ord: i));
            if (!ticket.IsSuccess)
            {
                return ticket.Error!.Message;
            }

            var sent = await JS.InvokeAsync<bool>("nornisUpload.sendAt",
                _activeInputId, i, ticket.Value!.UploadUrl, ticket.Value.Attachment.ContentType, _selfRef);
            if (!sent)
            {
                return $"File {i + 1} never reached storage. Try again.";
            }

            var confirmed = await Api.ConfirmSourceAttachmentUploadAsync(worldId, sourceId, ticket.Value.Attachment.Id);
            if (!confirmed.IsSuccess)
            {
                return confirmed.Error!.Message;
            }
        }

        return null;
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();

        try
        {
            await JS.InvokeVoidAsync("nornisUpload.release", _cameraInputId);
            await JS.InvokeVoidAsync("nornisUpload.release", _libraryInputId);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — the browser dropped the re-encoded pages with the page.
        }
    }

    /// <summary>
    /// The stored body's next value, and whether to clear it. Null-and-don't-clear means
    /// "leave what is there": a handwritten source before its reading has no editor on
    /// screen at all, and treating an absent editor like an emptied one would wipe the
    /// transcription the next step is about to write.
    /// </summary>
    private async Task<(string? Body, bool Clear)> ReadEditorAsync()
    {
        if (_editor is null || !_editor.Initialized)
        {
            return (null, false);
        }

        var markdown = await _editor.GetMarkdownAsync();
        return (markdown, markdown is null);
    }

    private DateTimeOffset? OccurredAtUtc =>
        // SpecifyKind: picker dates are Kind.Local, and DateTimeOffset's ctor throws
        // when the kind's implied offset disagrees with the one supplied.
        _occurredAt.HasValue
            ? new DateTimeOffset(DateTime.SpecifyKind(_occurredAt.Value, DateTimeKind.Utc), TimeSpan.Zero)
            : null;

    /// <summary>
    /// Creates the draft on first call and updates it on every call after, returning its id.
    /// One row for the whole page: transcribing needs somewhere to hang page images, saving
    /// needs somewhere to put the corrected text, and two rows would leave the photographs
    /// and the words that came out of them on different sources.
    /// </summary>
    private async Task<Guid?> EnsureSourceAsync()
    {
        var worldId = Worlds.Current!.Id;
        var (body, clearBody) = await ReadEditorAsync();

        if (_sourceId is { } existing)
        {
            var updated = await Api.UpdateSourceAsync(worldId, existing, new UpdateSourceRequest(
                Title: _title.Trim(),
                Body: body,
                ClearBody: clearBody,
                Uri: string.IsNullOrWhiteSpace(_uri) ? null : _uri,
                ClearUri: string.IsNullOrWhiteSpace(_uri),
                OccurredAt: OccurredAtUtc,
                ClearOccurredAt: OccurredAtUtc is null,
                Type: _type,
                Visibility: _visibility,
                CampaignId: _campaignId,
                ClearCampaign: _campaignId is null,
                ExtractionEnabled: _extractionEnabled));

            if (!updated.IsSuccess)
            {
                _error = updated.Error!.Message;
                return null;
            }

            return existing;
        }

        var created = await Api.CreateSourceAsync(worldId, new CreateSourceRequest(
            _title.Trim(),
            _type,
            _visibility,
            body,
            string.IsNullOrWhiteSpace(_uri) ? null : _uri,
            OccurredAtUtc,
            _campaignId,
            _extractionEnabled));

        if (!created.IsSuccess)
        {
            _error = created.Error!.Message;
            return null;
        }

        _sourceId = created.Value!.Id;
        return _sourceId;
    }

    /// <summary>Uploads the selected pages once. Both transcribing and saving need them in
    /// storage, and whichever happens first is the one that pays for it.</summary>
    private async Task<string?> EnsurePagesUploadedAsync(Guid worldId, Guid sourceId, string kind)
    {
        if (_pagesUploaded || _pageFiles.Count == 0)
        {
            return null;
        }

        var uploadError = await UploadFilesAsync(worldId, sourceId, kind);
        _pagesUploaded = uploadError is null;
        return uploadError;
    }

    private string MissingFilesMessage => _type switch
    {
        "HandwrittenNotes" => "Add at least one photo or image of your handwritten notes.",
        "Map" => "Add the map image.",
        _ => "Add at least one file — or switch the type to Session Note for text-only capture.",
    };

    /// <summary>
    /// Reads the photographed pages and puts the transcription in the editor for correction.
    /// The source is left a draft: nothing reaches extraction until the GM sends it.
    /// </summary>
    private async Task TranscribeAsync()
    {
        if (Worlds.Current is null || FilePlanForType is not { } plan)
        {
            return;
        }

        if (_pageFiles.Count == 0)
        {
            _error = MissingFilesMessage;
            return;
        }

        // The draft is created here, and Title is required to create a source at all — so ask
        // for it now rather than after a paid vision call has nowhere to land.
        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Title is required before Nornis can read the pages.";
            return;
        }

        _busy = true;
        _error = null;

        var sourceId = await EnsureSourceAsync();
        if (sourceId is null)
        {
            _busy = false;
            return;
        }

        var uploadError = await EnsurePagesUploadedAsync(Worlds.Current.Id, sourceId.Value, plan.Kind);
        if (uploadError is not null)
        {
            _busy = false;
            _error = $"Saved as a draft, but a photo did not reach storage: {uploadError}";
            return;
        }

        _reading = true;
        StateHasChanged();

        var read = await Api.TranscribeSourceAsync(Worlds.Current.Id, sourceId.Value);

        _reading = false;
        _busy = false;

        if (!read.IsSuccess)
        {
            _error = read.Error!.Message;
            return;
        }

        _transcription = read.Value!.Markdown;
        _transcriptionWasBlank = string.IsNullOrWhiteSpace(_transcription);
        _transcribed = true;
    }

    /// <summary>
    /// Throws the reading away along with the photographs it came from. The stored body has
    /// to go too: it is the guard that stops the pipeline transcribing again, so leaving it
    /// behind would extract text attributed to pages that are no longer there.
    /// </summary>
    private async Task RetakeAsync()
    {
        if (Worlds.Current is null || _sourceId is not { } sourceId)
        {
            return;
        }

        _busy = true;
        _error = null;

        var attachments = await Api.GetSourceAttachmentsAsync(Worlds.Current.Id, sourceId);
        if (!attachments.IsSuccess)
        {
            _busy = false;
            _error = attachments.Error!.Message;
            return;
        }

        foreach (var page in attachments.Value!.Where(a => a.Kind == "PageImage"))
        {
            var deleted = await Api.DeleteSourceAttachmentAsync(Worlds.Current.Id, sourceId, page.Id);
            if (!deleted.IsSuccess)
            {
                _busy = false;
                _error = deleted.Error!.Message;
                return;
            }
        }

        var cleared = await Api.UpdateSourceAsync(
            Worlds.Current.Id, sourceId, new UpdateSourceRequest(ClearBody: true));

        _busy = false;

        if (!cleared.IsSuccess)
        {
            _error = cleared.Error!.Message;
            return;
        }

        _transcribed = false;
        _transcriptionWasBlank = false;
        _transcription = null;
        _pageFiles = [];
        _pagesUploaded = false;
        // The editor is about to leave the render tree with the reading it was holding.
        _editor = null;

        await JS.InvokeVoidAsync("nornisUpload.release", _cameraInputId);
        await JS.InvokeVoidAsync("nornisUpload.release", _libraryInputId);
    }

    private async Task SaveAsync(bool process)
    {
        if (Worlds.Current is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Title is required.";
            return;
        }

        var filePlan = FilePlanForType;
        if (filePlan is not null && _pageFiles.Count == 0 && !_transcribed)
        {
            _error = MissingFilesMessage;
            return;
        }

        _busy = true;
        _error = null;

        var sourceId = await EnsureSourceAsync();
        if (sourceId is null)
        {
            _busy = false;
            return;
        }

        if (filePlan is not null)
        {
            var uploadError = await EnsurePagesUploadedAsync(Worlds.Current.Id, sourceId.Value, filePlan.Kind);
            if (uploadError is not null)
            {
                _busy = false;
                _error = $"Source saved as a draft, but a file upload failed: {uploadError}";
                return;
            }
        }

        if (process)
        {
            var ready = await Api.MarkSourceReadyAsync(Worlds.Current.Id, sourceId.Value);
            if (!ready.IsSuccess)
            {
                _busy = false;
                _error = $"Source saved, but could not queue it for processing: {ready.Error!.Message}";
                return;
            }
        }

        _busy = false;
        Snackbar.Add(
            !process ? "Draft saved."
            : _extractionEnabled ? "Source saved and queued for processing."
            : "Source stored in the record — no extraction.", Severity.Success);
        Nav.NavigateTo("/sources");
    }
}
