@page "/graph"
@page "/graph/{Focus}"
@inject NavigationManager Nav

@* The standalone graph page moved into the Artifacts browse page (graph view) and the
   artifact detail Connections section. This stub keeps old bookmarks working. *@

@code {
    /// <summary>The artifact key an old bookmark carried, slug or id; the artifact page resolves it.</summary>
    [Parameter] public string? Focus { get; set; }

    protected override void OnInitialized() =>
        Nav.NavigateTo(string.IsNullOrEmpty(Focus) ? "/artifacts" : $"/artifacts/{Uri.EscapeDataString(Focus)}", replace: true);
}
