@page "/extract"
@* The original address, kept working: the feature shipped as "import" and links to it exist. *@
@page "/import"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject Nornis.Web.State.AuthSessionState AuthSession
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Extract Campaign — Nornis</PageTitle>

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Extract your campaign</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Choose the notes to read — ones already in your world, or new ones pasted in — put them
            in order, then walk them one at a time, each read against the record the ones before
            it built.
        </MudText>
    </div>
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (!Worlds.IsGm)
{
    <MudAlert Severity="Severity.Info">Only the GM can extract a campaign.</MudAlert>
}
else if (_loading)
{
    <LoadingRows Rows="3" />
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    @if (_loadFailed)
    {
        @* Never offer "Start extracting" here: a run may well exist and the server would refuse
           to create a second one, leaving nowhere to go. *@
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Large" Class="nornis-comingsoon-icon" />
            <MudText Typo="Typo.h5" Class="nornis-serif">Could not load your extraction</MudText>
            <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
                This is a connection problem, not a lost backlog — if an extraction was in progress
                it is still there. Try again in a moment.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync" Disabled="@(_busy || _loading)" Class="mt-4">
                Try again
            </MudButton>
        </MudPaper>
    }
    else if (_session is null)
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
            <MudIcon Icon="@Icons.Material.Outlined.LibraryBooks" Size="Size.Large" Class="nornis-comingsoon-icon" />
            <MudText Typo="Typo.h5" Class="nornis-serif">No extraction in progress</MudText>
            <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
                Start one and add your notes oldest first. Nothing is read until you say go, and then
                only one note at a time — so the second session is read knowing what the first established.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync" Disabled="@_busy" Class="mt-4">
                Start extracting
            </MudButton>
        </MudPaper>
    }
    else if (_session.Status == "Draft")
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-4">
            <MudText Typo="Typo.h6" Class="nornis-serif mb-3">Add a note</MudText>
            <MudTextField @bind-Value="_title" Label="Title" Required="true" Immediate="true"
                          MaxLength="200" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_body" Label="What happened" Lines="8"
                          Variant="Variant.Outlined" Class="mb-3" />
            <MudDatePicker @bind-Date="_occurredAt" Label="Session date" Variant="Variant.Outlined"
                           Clearable="true" Class="mb-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddNoteAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_title))">
                Add to backlog
            </MudButton>
        </MudPaper>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-4">
            <div class="d-flex align-center justify-space-between mb-3">
                <div>
                    <MudText Typo="Typo.h6" Class="nornis-serif">Add notes you already have</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Stage existing sources to re-extract them in an order you choose.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           StartIcon="@(_showCandidates ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="ToggleCandidatesAsync" Disabled="@_busy">
                    @(_showCandidates ? "Hide" : "Choose sources")
                </MudButton>
            </div>

            @if (_showCandidates)
            {
                @if (_candidates is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="my-3" />
                }
                else if (_candidates.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        This world has no other sources with extraction enabled.
                    </MudText>
                }
                else
                {
                    var selectable = _candidates.Where(c => !c.AlreadyStaged).ToList();

                    <div class="d-flex gap-2 mb-2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_busy"
                                   OnClick="() => SelectCandidates(selectable.Select(c => c.SourceId))">
                            Select all (@selectable.Count)
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_busy"
                                   OnClick="() => SelectCandidates(selectable.Where(c => c.ExistingReferenceCount == 0).Select(c => c.SourceId))">
                            Only never-extracted
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_busy"
                                   OnClick="() => SelectCandidates([])">
                            Clear
                        </MudButton>
                    </div>

                    <div class="nornis-scroll-list">
                        @foreach (var candidate in _candidates)
                        {
                            var id = candidate.SourceId;
                            <div class="nornis-list-row">
                                <MudCheckBox T="bool" Dense="true"
                                             Value="@(_selected.Contains(id))"
                                             Disabled="@(_busy || candidate.AlreadyStaged)"
                                             ValueChanged="@((bool v) => ToggleCandidate(id, v))" />
                                <div class="nornis-list-body">
                                    <div class="nornis-list-title">@candidate.Title</div>
                                    <div class="nornis-list-sub">
                                        @candidate.Type
                                        &middot;
                                        @(candidate.IsDated
                                            ? candidate.StoryPosition.LocalDateTime.ToString("d MMM yyyy")
                                            : $"undated, filed {candidate.StoryPosition.LocalDateTime:d MMM yyyy}")
                                        @* A source that has never been submitted may be someone's
                                           unfinished note; say so rather than let it look extracted. *@
                                        @if (candidate.ProcessingStatus != "Processed")
                                        {
                                            <span> &middot; @candidate.ProcessingStatus</span>
                                        }
                                    </div>
                                </div>
                                @if (candidate.AlreadyStaged)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">In the run</MudChip>
                                }
                                else if (candidate.ExistingReferenceCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                        @candidate.ExistingReferenceCount in canon
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                        No knowledge yet
                                    </MudChip>
                                }
                            </div>
                        }
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3"
                               StartIcon="@Icons.Material.Filled.PlaylistAdd"
                               OnClick="AddSelectedAsync" Disabled="@(_busy || _selected.Count == 0)">
                        Add @_selected.Count to backlog
                    </MudButton>
                }
            }
        </MudPaper>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.h6" Class="nornis-serif">Backlog (@_session.Items.Count)</MudText>
                @if (_session.Items.Count > 1)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Sort"
                               OnClick="SortByDateAsync" Disabled="@_busy">
                        Sort by session date
                    </MudButton>
                }
            </div>

            @if (_session.Items.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Nothing here yet. Add your oldest session note first.
                </MudText>
            }
            else
            {
                @foreach (var (item, index) in _session.Items.Select((x, i) => (x, i)))
                {
                    var position = index;
                    var itemId = item.Id;
                    var draggable = item.State == "Waiting" && !_busy;
                    @* dragover carries preventDefault with no handler: it fires continuously as
                       the cursor moves, and a .NET callback per event would re-render the whole
                       backlog dozens of times a second. A Razor comment must stay OUT of the
                       attribute list — inside a tag it is emitted as an attribute name and the
                       browser kills the render batch with InvalidCharacterError. *@
                    <div class="nornis-list-row @DragClass(itemId)"
                         draggable="@(draggable ? "true" : "false")"
                         @ondragstart="() => OnDragStart(itemId)"
                         @ondragenter="() => OnDragEnter(itemId)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => OnDropAsync(itemId)"
                         @ondragend="OnDragEnd">
                        @if (draggable)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"
                                     Class="nornis-drag-grip" title="Drag to reorder" />
                        }
                        else
                        {
                            @* Keeps the rows aligned once a note starts and loses its grip. *@
                            <span class="nornis-drag-grip-spacer"></span>
                        }
                        <div class="nornis-list-thumb @(draggable ? "nornis-drag-handle" : null)">
                            <MudText Typo="Typo.caption">@(index + 1)</MudText>
                        </div>
                        <div class="nornis-list-body">
                            <div class="nornis-list-title">@item.Title</div>
                            <div class="nornis-list-sub">
                                @(item.OccurredAt is { } occurred ? occurred.LocalDateTime.ToString("d MMM yyyy") : "No session date")
                            </div>
                        </div>
                        @if (item.ExistingReferenceCount > 0)
                        {
                            <MudTooltip Text="Re-running this note replaces the knowledge it already contributed.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                    @item.ExistingReferenceCount in canon
                                </MudChip>
                            </MudTooltip>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                       Disabled="@(_busy || position == 0)"
                                       OnClick="() => MoveAsync(position, -1)" />
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                       Disabled="@(_busy || position == _session.Items.Count - 1)"
                                       OnClick="() => MoveAsync(position, 1)" />
                        @* Removing only drops the note from this run. Deleting the note itself is
                           offered solely for notes typed in here, which nothing else references. *@
                        <MudTooltip Text="Remove from this run. The note itself is kept.">
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small"
                                           Disabled="@_busy" OnClick="() => RemoveItemAsync(item.Id)" />
                        </MudTooltip>
                        @if (item.CreatedByImport)
                        {
                            <MudTooltip Text="Delete this note entirely. It was added here and has no knowledge yet.">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               Disabled="@_busy" OnClick="() => DeleteItemAsync(item.Id)" />
                            </MudTooltip>
                        }
                    </div>
                }
            }

            @if (_session.Items.Count > 0)
            {
                <div class="mt-4">
                    <ImportPacingNote Lead="@($"Nornis will read these {_session.Items.Count} notes one at a time, pausing for you between each.")" />
                </div>

                <div class="nornis-auto-accept mt-3">
                    <MudCheckBox T="bool" @bind-Value="_autoAccept" Dense="true" Color="Color.Warning"
                                 Label="Don't stop — accept everything it proposes" />

                    @if (_autoAccept)
                    {
                        <div class="nornis-auto-accept-warning">
                            <p>
                                <strong>Nothing will be shown to you before it goes in.</strong>
                                Nornis will read all @_session.Items.Count notes back to back and add every
                                proposal to your record — new people and places, changes to existing ones,
                                merges, facts and relationships alike. You will not see them first.
                            </p>
                            <p>
                                It is still read in order, so each note is understood against the ones
                                before it. What changes is only that nobody checks the reading. Anything
                                misread lands in your record as fact, and finding it afterwards means
                                going through the record rather than a review queue.
                            </p>
                            <p>
                                Reasonable when you trust the notes and would rather tidy up later than
                                make @_session.Items.Count decisions. Not what you want for a campaign
                                whose record you care about being right the first time.
                            </p>
                            <p class="nornis-pacing-aside">
                                It runs only while this page is open, and you can stop it at any point —
                                everything accepted up to then stays.
                            </p>
                        </div>
                    }
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartAsync" Disabled="@(_busy || _session.Items.Count == 0)">
                    Start extracting
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="AbandonAsync" Disabled="@_busy">
                    Abandon
                </MudButton>
            </div>
        </MudPaper>
    }
    else if (_session.Status == "InProgress")
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-4">
            <MudText Typo="Typo.h6" Class="nornis-serif">
                @(_session.CurrentIndex is { } n
                    ? $"Note {n} of {_session.Items.Count}"
                    : $"All {_session.Items.Count} notes settled")
            </MudText>
            <MudProgressLinear Color="Color.Secondary" Value="@ProgressPercent" Class="my-3" />

            @if (_autoAccept)
            {
                <div class="nornis-auto-running">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Warning" />
                    <div class="nornis-auto-running-body">
                        <div class="nornis-auto-running-title">Running without stopping</div>
                        <div class="nornis-auto-running-status">
                            @(_autoStatus ?? "Working…")
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Pause"
                               OnClick="@(() => { _autoAccept = false; _autoStatus = null; })">
                        Stop
                    </MudButton>
                </div>
            }
            else
            {
                <ImportPacingNote Lead="Each note is read against what you accepted before it." />

                @if (Current is not null)
                {
                    <div class="mt-2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.FastForward"
                                   OnClick="StartAutoAsync" Disabled="@_busy">
                            Finish the rest without stopping
                        </MudButton>
                    </div>
                }
            }

            @if (Current is { } current)
            {
                <MudText Typo="Typo.subtitle1" Class="mb-1">@current.Title</MudText>

                @switch (current.State)
                {
                    case "Waiting":
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            Ready when you are — this note has not been read yet.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="() => AdvanceAsync(false)" Disabled="@_busy">
                            Read this note
                        </MudButton>
                        break;

                    case "Extracting":
                        <div class="d-flex align-center gap-2 mb-3">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Nornis is reading this note…
                            </MudText>
                        </div>
                        @* An escape hatch even here: a worker that never answers must not
                           leave the GM with a spinner and no way forward. *@
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   OnClick="() => AdvanceAsync(true)" Disabled="@_busy">
                            Skip this note
                        </MudButton>
                        break;

                    case "Reviewing":
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @current.OpenProposalCount proposal@(current.OpenProposalCount == 1 ? "" : "s")
                            waiting on your decision. Clear them and the next note can be read against them.
                        </MudText>
                        <div class="d-flex gap-2 mb-4">
                            <MudButton Variant="Variant.Text" OnClick="() => AdvanceAsync(true)" Disabled="@_busy">
                                Skip this note
                            </MudButton>
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Href="/review">
                                Open the full queue
                            </MudButton>
                        </div>

                        @* Reviewing inline is the point: a hundred-note backlog is a hundred
                           round trips to /review otherwise. Scoped to this note, so the panel
                           empties exactly when the walk is free to move on. *@
                        <div class="nornis-inline-review">
                            <ReviewQueuePanel @ref="_reviewPanel"
                                              SourceIdFilter="@current.SourceId"
                                              OnQueueChanged="OnReviewQueueChangedAsync" />
                        </div>
                        break;

                    case "Failed":
                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-3">
                            Extraction failed for this note.
                        </MudText>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="RetryAsync" Disabled="@_busy">
                                Retry
                            </MudButton>
                            <MudButton Variant="Variant.Text" OnClick="() => AdvanceAsync(true)" Disabled="@_busy">
                                Skip this note
                            </MudButton>
                        </div>
                        break;
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Every note has been read or skipped.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Done"
                           OnClick="() => AdvanceAsync(false)" Disabled="@_busy">
                    Finish
                </MudButton>
            }
        </MudPaper>

        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            @*
                Settled notes fold away as the walk passes them, so the list on screen is the
                work that is left. Over ninety notes an ever-growing wall of green rows buries
                the one note the GM is actually being asked about — and seeing the remainder
                shrink is the only running feedback that the backlog is going down.
            *@
            @{
                var numbered = _session.Items.Select((x, i) => (Item: x, Index: i)).ToList();
                var settled = numbered.Where(n => n.Item.State is "Done" or "Skipped").ToList();
                var remaining = numbered.Where(n => n.Item.State is not ("Done" or "Skipped")).ToList();
            }

            @if (settled.Count > 0)
            {
                <div class="nornis-list-row nornis-settled-summary">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    <div class="nornis-list-body">
                        <div class="nornis-list-sub">
                            @ProcessedCount read@(SkippedCount > 0 ? $", {SkippedCount} skipped" : "") —
                            @remaining.Count still to go
                        </div>
                    </div>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="() => _showSettled = !_showSettled">
                        @(_showSettled ? "Hide" : "Show")
                    </MudButton>
                </div>
            }

            @foreach (var (item, index) in _showSettled ? numbered : remaining)
            {
                <div class="nornis-list-row @(item.State is "Done" or "Skipped" ? "nornis-row-settled" : null)">
                    <div class="nornis-list-thumb">
                        <MudText Typo="Typo.caption">@(index + 1)</MudText>
                    </div>
                    <div class="nornis-list-body">
                        <div class="nornis-list-title">@item.Title</div>
                        <div class="nornis-list-sub">
                            @(item.OccurredAt is { } occurred ? occurred.LocalDateTime.ToString("d MMM yyyy") : "No session date")
                        </div>
                    </div>
                    @if (item.State == "Reviewing")
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                            @item.OpenProposalCount open
                        </MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StateColor(item.State)">
                        @item.State
                    </MudChip>
                </div>
            }

            @if (remaining.Count == 0 && !_showSettled)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Nothing left in the queue.
                </MudText>
            }

            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="AbandonAsync" Disabled="@_busy">
                    Stop extracting
                </MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        @* Terminal: only reachable from the response that ended the session, because the
           API only serves the non-terminal one. Reloading the page returns to the start. *@
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Large" Class="nornis-comingsoon-icon" />
            <MudText Typo="Typo.h5" Class="nornis-serif">
                @(_session.Status == "Completed" ? "Campaign extracted" : "Extraction stopped")
            </MudText>
            <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
                @ProcessedCount read, @SkippedCount skipped, of @_session.Items.Count notes.
                @if (_session.Status == "Abandoned")
                {
                    <text>Nothing was deleted — notes not yet read are waiting as draft sources.</text>
                }
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/sources" Class="mt-4">
                Go to sources
            </MudButton>
        </MudPaper>
    }
}

@code {
    private ImportSessionDto? _session;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    /// <summary>The session could not be read, as distinct from there being none. Keeps the
    /// page off the empty state, whose only action is one the server will refuse.</summary>
    private bool _loadFailed;

    private string _title = string.Empty;
    private string? _body;
    private DateTime? _occurredAt;

    private bool _showCandidates;
    private IReadOnlyList<ImportCandidateDto>? _candidates;
    private readonly HashSet<Guid> _selected = [];

    // Drag reorder: the row being carried, and the row it is currently over. Both are cleared
    // on drop or dragend so an abandoned drag leaves no highlight behind.
    private Guid? _dragItemId;
    private Guid? _dragOverItemId;

    private ReviewQueuePanel? _reviewPanel;

    /// <summary>Reveal the notes the walk has already passed. Off by default — the list is
    /// meant to read as what is left, not as everything that ever was.</summary>
    private bool _showSettled;

    /// <summary>
    /// Drive the walk without stopping: accept every proposal and move to the next note.
    ///
    /// Deliberately held in the page rather than on the session, so it only ever runs while
    /// someone has this page open and can stop it. An unattended flag stored server-side would
    /// keep spending on extraction with nobody watching.
    /// </summary>
    private bool _autoAccept;

    /// <summary>Guards the driver against re-entering while a step is still in flight.</summary>
    private bool _autoStepping;

    /// <summary>What the driver is doing right now, shown live while it runs.</summary>
    private string? _autoStatus;

    private readonly CancellationTokenSource _cts = new();

    private ImportSessionItemDto? Current =>
        _session?.Items.FirstOrDefault(i => i.Id == _session.CurrentItemId);

    private int ProcessedCount => _session?.Items.Count(i => i.State == "Done") ?? 0;

    private int SkippedCount => _session?.Items.Count(i => i.State == "Skipped") ?? 0;

    private int ProgressPercent =>
        _session is null || _session.Items.Count == 0
            ? 0
            : (int)Math.Round(100.0 * _session.SettledCount / _session.Items.Count);

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
        _ = PollAsync();
    }

    private void OnWorldChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        if (Worlds.Current is null || !Worlds.IsGm)
        {
            _session = null;
            _loadFailed = false;
            _loading = false;
            return;
        }

        _loading = true;
        var result = await Api.GetCurrentImportSessionAsync(Worlds.Current.Id, _cts.Token);
        _loading = false;

        if (result.IsSuccess)
        {
            _session = result.Value;
            _loadFailed = false;
            _error = null;
            return;
        }

        // Only a 404 means "there is no import" — the empty state, not an error. Any other
        // failure (the API restarting under a deploy, a dropped connection) must NOT fall
        // through to the empty state: it offers "Start an import", which then 409s because a
        // session does exist, and the backlog view holding the Abandon button never renders.
        // That combination is a dead end with no way out of the page.
        _session = null;
        _loadFailed = result.Error!.Code is not "not_found";
        _error = _loadFailed ? result.Error!.Message : null;
    }

    /// <summary>Light poll so an extraction finishing moves the panel without a manual refresh.</summary>
    private async Task PollAsync()
    {
        try
        {
            // Two seconds: fast enough that an unattended run looks alive and its counters move,
            // slow enough not to hammer the API when nothing is happening. The body below does
            // almost nothing unless a note is actually in flight.
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            var tick = 0;

            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                tick++;

                // Stand down on an expired session — the nav owns surfacing it and probing
                // for recovery; a two-second poll is the worst offender in a 401 storm.
                if (AuthSession.Expired)
                {
                    continue;
                }

                if (_busy || _session is null || _session.Status != "InProgress")
                {
                    continue;
                }

                if (_autoAccept)
                {
                    await InvokeAsync(AutoStepAsync);
                    continue;
                }

                // Hand-driven: only a note in flight can change without the user, and once every
                // ten seconds is plenty to notice it.
                if (tick % 5 != 0 || Current?.State is not ("Extracting" or "Reviewing"))
                {
                    continue;
                }

                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    /// <summary>
    /// One step of the unattended walk. Each tick does at most one thing and then re-reads, so
    /// the screen tells the truth about where the run is at every moment.
    ///
    /// A failed note stops the driver rather than being skipped past: silently dropping notes
    /// out of a run the user has stopped watching is how a campaign quietly loses a session.
    /// </summary>
    private async Task AutoStepAsync()
    {
        // Re-checked here, not just at the call site: Stop can land between the two, and the
        // step about to run is the one that dispatches a note and spends on it.
        if (_autoStepping || _session is null || !_autoAccept)
        {
            return;
        }

        _autoStepping = true;
        try
        {
            var current = Current;

            if (current is null)
            {
                _autoStatus = "Finishing…";
                StateHasChanged();
                await AdvanceAsync(false);

                // The run is over — leave the flag off so a fresh one never inherits it.
                _autoAccept = false;
                _autoStatus = null;
                return;
            }

            switch (current.State)
            {
                case "Waiting":
                    _autoStatus = $"Reading “{current.Title}”…";
                    StateHasChanged();
                    await AdvanceAsync(false);
                    break;

                case "Extracting":
                    _autoStatus = $"Reading “{current.Title}”…";
                    StateHasChanged();
                    await LoadAsync();
                    break;

                case "Reviewing":
                    _autoStatus = $"Accepting {current.OpenProposalCount} from “{current.Title}”…";
                    StateHasChanged();

                    if (_reviewPanel is null)
                    {
                        // The panel renders with this state; if it has not mounted yet, wait a tick.
                        await LoadAsync();
                        break;
                    }

                    await _reviewPanel.RefreshAsync();
                    var accepted = await _reviewPanel.AcceptAllOpenAsync();
                    if (!accepted)
                    {
                        StopAuto("Some proposals could not be accepted. Auto-accept stopped so you can look.");
                        break;
                    }

                    await LoadAsync();
                    break;

                case "Failed":
                    StopAuto($"Extraction failed for “{current.Title}”. Auto-accept stopped — retry or skip it.");
                    break;

                default:
                    await LoadAsync();
                    break;
            }
        }
        finally
        {
            _autoStepping = false;
            StateHasChanged();
        }
    }

    private void StopAuto(string message)
    {
        _autoAccept = false;
        _autoStatus = null;
        Snackbar.Add(message, Severity.Warning);
    }

    /// <summary>
    /// Switching to unattended part-way through. This path never showed the warning beside the
    /// checkbox, so the whole of it has to be said here — turning off review for the rest of a
    /// run is not something to discover afterwards.
    /// </summary>
    private async Task StartAutoAsync()
    {
        if (_session is null)
        {
            return;
        }

        var remaining = _session.Items.Count(i => i.State is not ("Done" or "Skipped"));

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Finish without stopping?",
            $"Nornis will read the remaining {remaining} note{(remaining == 1 ? "" : "s")} back to back and "
                + "accept every proposal into your record without showing you any of them. Anything it "
                + "misreads becomes part of your record, and you would find it by going through the "
                + "record rather than a review queue. It runs only while this page is open, and you can "
                + "stop it at any point — everything accepted stays.",
            yesText: "Yes, don't stop", cancelText: "Keep reviewing");

        if (confirmed == true)
        {
            _autoAccept = true;
            _autoStatus = "Starting…";
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    /// <summary>
    /// The inline queue reports how many proposals it has left. Once it hits zero this note is
    /// settled, so the session is re-read — that is what turns the panel into the next note's
    /// "Read this note" button without the GM going anywhere.
    /// </summary>
    private async Task OnReviewQueueChangedAsync(int remaining)
    {
        // Re-reading the session either way keeps the progress header honest as proposals are
        // decided, and at zero it is what flips this note to Done and offers the next one.
        // No loop: the reload leaves the panel's source filter unchanged, so it does not
        // re-fetch and does not report again.
        _ = remaining;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task CreateAsync()
    {
        if (Worlds.Current is null)
        {
            return;
        }

        _busy = true;
        var result = await Api.CreateImportSessionAsync(Worlds.Current.Id, _cts.Token);
        _busy = false;

        if (result.IsSuccess)
        {
            _session = result.Value;
            _loadFailed = false;
            _error = null;
            return;
        }

        // The world already has one and this screen was out of date — that is not a failure
        // the user can act on, it just means "here it is". Show it rather than an error the
        // page offers no way past.
        if (result.Error!.Code == "import_session_active")
        {
            await LoadAsync();
            return;
        }

        Snackbar.Add(result.Error!.Message, Severity.Error);
    }

    private async Task AddNoteAsync()
    {
        var title = _title.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        var occurred = _occurredAt is { } date
            ? new DateTimeOffset(DateTime.SpecifyKind(date, DateTimeKind.Utc))
            : (DateTimeOffset?)null;

        var added = await ActAsync(worldId => Api.AddImportNoteAsync(
            worldId, _session!.Id, new AddImportNoteRequest(title, _body, occurred), _cts.Token));

        if (added)
        {
            _title = string.Empty;
            _body = null;
            _occurredAt = null;
        }
    }

    private async Task ToggleCandidatesAsync()
    {
        _showCandidates = !_showCandidates;
        if (_showCandidates)
        {
            await LoadCandidatesAsync();
        }
    }

    private async Task LoadCandidatesAsync()
    {
        if (Worlds.Current is null || _session is null)
        {
            return;
        }

        _candidates = null;
        var result = await Api.ListImportCandidatesAsync(Worlds.Current.Id, _session.Id, _cts.Token);
        if (result.IsSuccess)
        {
            _candidates = result.Value;
            // A source staged by another tab since this list was drawn cannot be chosen again.
            _selected.RemoveWhere(id => _candidates!.Any(c => c.SourceId == id && c.AlreadyStaged));
        }
        else
        {
            _error = result.Error?.Message ?? "Could not load your sources.";
        }

        StateHasChanged();
    }

    private void ToggleCandidate(Guid sourceId, bool selected)
    {
        if (selected)
        {
            _selected.Add(sourceId);
        }
        else
        {
            _selected.Remove(sourceId);
        }
    }

    private void SelectCandidates(IEnumerable<Guid> sourceIds)
    {
        _selected.Clear();
        foreach (var id in sourceIds)
        {
            _selected.Add(id);
        }
    }

    private async Task AddSelectedAsync()
    {
        if (_session is null || _selected.Count == 0)
        {
            return;
        }

        var chosen = _selected.ToList();
        var added = await ActAsync(worldId => Api.AddExistingImportSourcesAsync(
            worldId, _session.Id, chosen, _cts.Token));

        if (added)
        {
            _selected.Clear();
            await LoadCandidatesAsync();
        }
    }

    // ------------------------------------------------------------ drag reorder --

    private string? DragClass(Guid itemId)
    {
        if (_dragItemId == itemId)
        {
            return "nornis-dragging";
        }

        // Only mark a drop target while a drag is actually in flight.
        return _dragItemId is not null && _dragOverItemId == itemId ? "nornis-drag-over" : null;
    }

    private void OnDragStart(Guid itemId) => _dragItemId = itemId;

    private void OnDragEnter(Guid itemId)
    {
        if (_dragItemId is not null && _dragItemId != itemId)
        {
            _dragOverItemId = itemId;
        }
    }

    private void OnDragEnd()
    {
        _dragItemId = null;
        _dragOverItemId = null;
    }

    /// <summary>
    /// Drops the carried note onto the target's slot, sliding everything between them along.
    /// Only not-yet-started notes take part, and the server is sent the whole ordered set —
    /// the same contract the arrow buttons use.
    /// </summary>
    private async Task OnDropAsync(Guid targetItemId)
    {
        var dragged = _dragItemId;
        OnDragEnd();

        if (_session is null || dragged is null || dragged == targetItemId)
        {
            return;
        }

        var movable = _session.Items.Where(i => i.State == "Waiting").Select(i => i.Id).ToList();
        var from = movable.IndexOf(dragged.Value);
        var to = movable.IndexOf(targetItemId);

        // A note that has already started is not a valid source or destination.
        if (from < 0 || to < 0)
        {
            return;
        }

        movable.RemoveAt(from);
        movable.Insert(to, dragged.Value);

        await ActAsync(worldId => Api.ReorderImportItemsAsync(worldId, _session.Id, movable, _cts.Token));
    }

    private async Task MoveAsync(int index, int delta)
    {
        if (_session is null)
        {
            return;
        }

        // Only not-yet-started notes can move, and the API wants all of their ids in order.
        var movable = _session.Items.Where(i => i.State == "Waiting").Select(i => i.Id).ToList();
        var item = _session.Items[index];
        var from = movable.IndexOf(item.Id);
        var to = from + delta;

        if (from < 0 || to < 0 || to >= movable.Count)
        {
            return;
        }

        (movable[from], movable[to]) = (movable[to], movable[from]);

        await ActAsync(worldId => Api.ReorderImportItemsAsync(worldId, _session.Id, movable, _cts.Token));
    }

    private async Task SortByDateAsync()
    {
        if (_session is null)
        {
            return;
        }

        // Stable: notes with no session date keep their relative place after the dated ones.
        var movable = _session.Items
            .Where(i => i.State == "Waiting")
            .OrderBy(i => i.OccurredAt ?? DateTimeOffset.MaxValue)
            .Select(i => i.Id)
            .ToList();

        await ActAsync(worldId => Api.ReorderImportItemsAsync(worldId, _session.Id, movable, _cts.Token));
    }

    /// <summary>Drops the note from this run only — the source is untouched.</summary>
    private async Task RemoveItemAsync(Guid itemId)
    {
        var removed = await ActAsync(worldId => Api.RemoveImportItemAsync(worldId, _session!.Id, itemId, _cts.Token));
        if (removed && _showCandidates)
        {
            // The freed source becomes selectable again.
            await LoadCandidatesAsync();
        }
    }

    /// <summary>Deletes the note itself. Only offered for notes typed into this import.</summary>
    private async Task DeleteItemAsync(Guid itemId) =>
        await ActAsync(worldId => Api.DeleteImportItemAsync(worldId, _session!.Id, itemId, _cts.Token));

    private async Task StartAsync() =>
        await ActAsync(worldId => Api.StartImportSessionAsync(worldId, _session!.Id, _cts.Token));

    /// <summary>Advances the walk, naming the note on screen so a stale view (another tab, a
    /// retried click after an error) can never skip a note the GM never saw.</summary>
    private async Task AdvanceAsync(bool skipCurrent)
    {
        var expected = _session?.CurrentItemId;
        var moved = await ActAsync(worldId => Api.AdvanceImportSessionAsync(
            worldId, _session!.Id, skipCurrent, expected, _cts.Token));

        if (!moved)
        {
            // The refusal may have been "the walk moved on" — resync so the screen tells the truth.
            await LoadAsync();
        }
    }

    private async Task AbandonAsync() =>
        await ActAsync(worldId => Api.AbandonImportSessionAsync(worldId, _session!.Id, _cts.Token));

    /// <summary>Retry a failed note through the ordinary Failed → Ready path.</summary>
    private async Task RetryAsync()
    {
        if (Worlds.Current is null || Current is null)
        {
            return;
        }

        _busy = true;
        var result = await Api.MarkSourceReadyAsync(Worlds.Current.Id, Current.SourceId, _cts.Token);
        _busy = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            return;
        }

        await LoadAsync();
    }

    /// <summary>Runs a session mutation and folds the returned session back into the page.</summary>
    private async Task<bool> ActAsync(Func<Guid, Task<ApiResult<ImportSessionDto>>> call)
    {
        if (Worlds.Current is null)
        {
            return false;
        }

        _busy = true;
        var result = await call(Worlds.Current.Id);
        _busy = false;

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            return false;
        }

        _session = result.Value;
        _loadFailed = false;
        _error = null;
        return true;
    }

    private static Color StateColor(string state) => state switch
    {
        "Done" => Color.Success,
        "Failed" => Color.Error,
        "Reviewing" => Color.Warning,
        "Extracting" => Color.Info,
        "Skipped" => Color.Dark,
        _ => Color.Default
    };

    public void Dispose()
    {
        Worlds.Changed -= OnWorldChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
