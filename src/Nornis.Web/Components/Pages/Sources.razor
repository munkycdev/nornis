@page "/sources"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject Nornis.Web.State.AuthSessionState AuthSession
@inject NavigationManager Nav

<PageTitle>Sources — Nornis</PageTitle>

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Sources</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">The layers beneath your epic.</MudText>
        <AiTrialLine Class="mt-1" />
    </div>
    <div class="nornis-page-head-actions">
        @if (_campaigns.Count > 0)
        {
            @* Dense margin so the filter matches the button beside it rather than towering over it. *@
            <MudSelect T="string" Value="_campaignFilter" ValueChanged="OnCampaignFilterChanged"
                       Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="nornis-role-select">
                <MudSelectItem T="string" Value="@("")">All campaigns</MudSelectItem>
                <MudSelectItem T="string" Value="@("none")">No campaign</MudSelectItem>
                @foreach (var c in _campaigns)
                {
                    <MudSelectItem T="string" Value="@c.Id.ToString()">@c.Name</MudSelectItem>
                }
            </MudSelect>
        }
        @if (Worlds.IsGm)
        {
            @* The backlog import is the GM's way in for a campaign that already happened. *@
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.LibraryBooks"
                       Href="/import"
                       Disabled="@(Worlds.Current is null)">
                Import past sessions
            </MudButton>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/capture"
                   Disabled="@(Worlds.Current is null)">
            Capture source
        </MudButton>
    </div>
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (_loading)
{
    <LoadingRows Rows="3" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_sources.Count == 0)
{
    @* No status chips here: an empty world has nothing to filter. *@
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <Stonemark Kind="StonemarkKind.Branch" Class="nornis-comingsoon-mark" />
        <MudText Typo="Typo.h5" Class="nornis-serif">No sources yet</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Capture your first session note, journal, or link and Nornis will start building the record.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Href="/capture" Class="mt-4">
            Capture source
        </MudButton>
    </MudPaper>
}
else
{
    <SourcesNeedingAttention Sources="_sources" OnRetried="LoadSourcesAsync" />

    @* The list opens on sessions (3.37); the row says so by having those chips on, and "All"
         is one click. Only types the world has are offered, so the row stays short. *@
    <div class="nornis-filter-row mb-2" role="group" aria-label="Filter by type">
        <span class="nornis-filter-label">Type</span>
        <MudChip T="string"
                 Variant="@(_typeFilter.Count == 0 ? Variant.Filled : Variant.Outlined)"
                 Color="@(_typeFilter.Count == 0 ? Color.Secondary : Color.Default)"
                 OnClick="ShowAllTypes">All</MudChip>
        @foreach (var type in TypesPresent)
        {
            var t = type;
            <MudChip T="string"
                     Variant="@(_typeFilter.Contains(t) ? Variant.Filled : Variant.Outlined)"
                     Color="@(_typeFilter.Contains(t) ? Color.Secondary : Color.Default)"
                     OnClick="() => ToggleType(t)">@SourceTypeDisplay.Label(t)</MudChip>
        }
    </div>
    <div class="nornis-filter-row mb-3" role="group" aria-label="Filter by status">
        <span class="nornis-filter-label">Status</span>
        <MudChip T="string" Size="Size.Small"
                 Variant="@(_statusFilter is null ? Variant.Filled : Variant.Outlined)"
                 Color="@(_statusFilter is null ? Color.Secondary : Color.Default)"
                 OnClick="() => _statusFilter = null">All</MudChip>
        @foreach (var status in SourceStatusDisplay.FilterOrder)
        {
            var s = status;
            <MudChip T="string" Size="Size.Small"
                     Variant="@(_statusFilter == s ? Variant.Filled : Variant.Outlined)"
                     Color="@(_statusFilter == s ? SourceStatusDisplay.StatusColor(s) : Color.Default)"
                     OnClick="() => _statusFilter = s">@SourceStatusDisplay.Label(s)</MudChip>
        }
    </div>

    @if (FilteredSources.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@NothingMatches</MudText>
    }
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
        @foreach (var source in FilteredSources)
        {
            <a href="@Links.Source(source.Slug, source.Id)" class="nornis-list-row nornis-list-link">
                <div class="nornis-list-thumb" title="@SourceTypeDisplay.Label(source.Type)">
                    <MudIcon Icon="@SourceTypeDisplay.Icon(source.Type)" Size="Size.Small" />
                </div>
                <div class="nornis-list-body">
                    <div class="nornis-list-title">@source.Title</div>
                    @* The date is when it happened, which is also what the list is ordered by. A source
                         with no date says when it was filed, and says that is what the date is. *@
                    <div class="nornis-list-sub">@SourceTypeDisplay.Label(source.Type) · @(source.OccurredAt is { } occurred ? DateDisplay.Day(occurred) : $"filed {DateDisplay.Day(source.CreatedAt)}")</div>
                </div>
                @if (source.CampaignName is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary"
                             Href="@Links.Campaign(source.CampaignSlug, source.CampaignId!.Value)">@source.CampaignName</MudChip>
                }
                @if (VisibilityDisplay.IsWorthShowing(source.Visibility))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@VisibilityDisplay.Label(source.Visibility)</MudChip>
                }
                @if (SourceStatusDisplay.IsWorthShowing(source.ProcessingStatus))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@SourceStatusDisplay.StatusColor(source.ProcessingStatus)">
                        @SourceStatusDisplay.Label(source.ProcessingStatus)
                    </MudChip>
                }
            </a>
        }
    </MudPaper>
}

@code {
    /// <summary>
    /// Preselects the campaign filter, so a campaign page can hand off to "all its sources".
    /// A campaign from another world simply filters to nothing — the server scopes the query
    /// by world regardless.
    /// </summary>
    [SupplyParameterFromQuery(Name = "campaign")]
    public Guid? CampaignQuery { get; set; }

    /// <summary>
    /// The types to show, comma-separated, or <c>all</c>. Absent means the default (the
    /// sessions), so a plain <c>/sources</c> opens on the record of play. The choice lives in
    /// the address, as the Codex's does, so Back from a source, a refresh and a shared link all
    /// show the same list.
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    private bool _loading;
    private string? _error;
    private IReadOnlyList<SourceListItem> _sources = [];
    private IReadOnlyList<CampaignDto> _campaigns = [];
    private string _campaignFilter = string.Empty;
    private string? _statusFilter;

    // Empty means every type. It is never a sentinel for "the default": the default is a set
    // like any other (SourceTypeDisplay.DefaultFilter), and only the address spells it as absent.
    private readonly HashSet<string> _typeFilter = new(SourceTypeDisplay.DefaultFilter, StringComparer.Ordinal);

    private IReadOnlyList<SourceListItem> FilteredSources =>
        _sources
            .Where(s => _typeFilter.Count == 0 || _typeFilter.Contains(s.Type))
            .Where(s => _statusFilter is null || SourceStatusDisplay.Matches(_statusFilter, s.ProcessingStatus))
            .ToList();

    // The chips on offer: the types this list holds, in display order. A type the world has
    // never seen would be a chip that can only ever show nothing.
    private IEnumerable<string> TypesPresent
    {
        get
        {
            var present = _sources.Select(s => s.Type).ToHashSet(StringComparer.Ordinal);
            return SourceTypeDisplay.FilterOrder.Where(present.Contains)
                .Concat(present.Where(t => !SourceTypeDisplay.FilterOrder.Contains(t)).Order(StringComparer.Ordinal));
        }
    }

    private string NothingMatches
    {
        get
        {
            var types = _typeFilter.Count == 0 ? null
                : _typeFilter.SetEquals(SourceTypeDisplay.DefaultFilter) ? "sessions" : "sources of the chosen types";
            var status = _statusFilter is null ? null : SourceStatusDisplay.Label(_statusFilter).ToLowerInvariant();
            return (types, status) switch
            {
                ("sessions", null) => "No sessions here yet. Choose All to see every source.",
                ({ } t, null) => $"No {t} here.",
                (null, { } st) => $"No sources are {st}.",
                ({ } t, { } st) => $"No {t} are {st}.",
                _ => "No sources here.",
            };
        }
    }

    private void ToggleType(string type)
    {
        // Picking a type when every type is showing narrows to that type, as on the Codex.
        if (!_typeFilter.Remove(type))
        {
            _typeFilter.Add(type);
        }

        // A filter left holding only types this list does not have would show nothing with no
        // chip lit to say why; with nothing chosen that can be seen, it is every type.
        if (!_typeFilter.Overlaps(TypesPresent))
        {
            _typeFilter.Clear();
        }
        SyncUrl();
    }

    private void ShowAllTypes()
    {
        _typeFilter.Clear();
        SyncUrl();
    }

    private void ResetTypeFilter()
    {
        _typeFilter.Clear();
        _typeFilter.UnionWith(SourceTypeDisplay.DefaultFilter);
    }

    // Every time the address changes, not only on first load: the sidebar's Sources link lands
    // on this same page instance, and must bring back the default rather than keep "All".
    protected override void OnParametersSet() => RestoreTypeFilter();

    private void RestoreTypeFilter()
    {
        ResetTypeFilter();
        if (string.IsNullOrWhiteSpace(TypeQuery))
        {
            return;
        }

        if (string.Equals(TypeQuery.Trim(), Links.SourcesAllTypes, StringComparison.OrdinalIgnoreCase))
        {
            _typeFilter.Clear();
            return;
        }

        var asked = TypeQuery.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(v => SourceTypeDisplay.FilterOrder.FirstOrDefault(t => t.Equals(v, StringComparison.OrdinalIgnoreCase)))
            .OfType<string>()
            .ToList();

        // A link naming no type this version knows keeps the default rather than showing nothing.
        if (asked.Count > 0)
        {
            _typeFilter.Clear();
            _typeFilter.UnionWith(asked);
        }
    }

    // Replace, not push: a chip is a refinement of this page, not a step Back should undo.
    private void SyncUrl()
    {
        var type = _typeFilter.Count == 0 ? Links.SourcesAllTypes
            : _typeFilter.SetEquals(SourceTypeDisplay.DefaultFilter) ? null
            : string.Join(',', SourceTypeDisplay.FilterOrder.Where(_typeFilter.Contains));
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["type"] = type,
            // The campaign picker writes the address too, or Back from a source would restore
            // the campaign this page was opened on rather than the one picked since. "No
            // campaign" is not a Guid the parameter can carry, so it is dropped.
            ["campaign"] = Guid.TryParse(_campaignFilter, out var campaign) ? campaign : null,
        });
        if (uri != Nav.Uri)
        {
            Nav.NavigateTo(uri, replace: true);
        }
    }

    // Extraction runs out-of-process; poll while any source is mid-pipeline so the
    // list moves Queued -> Processing -> Processed without a manual refresh.
    private static readonly string[] ActiveStatuses = ["Ready", "Queued", "Processing"];
    private readonly CancellationTokenSource _pollCts = new();

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        _campaignFilter = CampaignQuery?.ToString() ?? string.Empty;
        // Independent reads: the filter list and the list it filters. Serially, the page waits
        // for the sum of two round trips to show anything.
        await Task.WhenAll(LoadCampaignsAsync(), LoadSourcesAsync());
        _ = PollWhileProcessingAsync();
    }

    private void OnWorldChanged() => InvokeAsync(async () =>
    {
        _campaignFilter = string.Empty;
        ResetTypeFilter();
        SyncUrl();
        await Task.WhenAll(LoadCampaignsAsync(), LoadSourcesAsync());
    });

    private async Task LoadCampaignsAsync()
    {
        if (Worlds.Current is null)
        {
            _campaigns = [];
            return;
        }

        var result = await Api.GetCampaignsAsync(Worlds.Current.Id);
        _campaigns = result.IsSuccess ? result.Value! : [];
    }

    private async Task OnCampaignFilterChanged(string value)
    {
        _campaignFilter = value;
        SyncUrl();
        await LoadSourcesAsync();
    }

    private async Task PollWhileProcessingAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
            while (await timer.WaitForNextTickAsync(_pollCts.Token))
            {
                // An expired session turns this four-second poll into a 401 storm; the nav owns
                // telling the user and probing for recovery, so this one just stands down.
                if (AuthSession.Expired)
                    continue;

                if (Worlds.Current is null || !_sources.Any(x => ActiveStatuses.Contains(x.ProcessingStatus)))
                    continue;

                // Quiet refresh: no loading state, just swap the data in place.
                var worldId = Worlds.Current.Id;
                var campaignFilter = CampaignFilterOrNull;
                var result = await Api.GetSourcesAsync(worldId, campaignFilter, _pollCts.Token);

                // Four seconds is long enough to switch world or campaign filter mid-poll, and
                // a quiet swap gives no hint that the list now describes somewhere else.
                if (result.IsSuccess
                    && Worlds.Current?.Id == worldId
                    && CampaignFilterOrNull == campaignFilter)
                {
                    _sources = result.Value!;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page disposed.
        }
    }

    private async Task LoadSourcesAsync()
    {
        if (Worlds.Current is null)
        {
            _sources = [];
            _error = null;
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        var worldId = Worlds.Current.Id;
        var campaignFilter = CampaignFilterOrNull;
        var result = await Api.GetSourcesAsync(worldId, campaignFilter);

        // Changing the campaign filter fires a fresh load without cancelling the last, and
        // they do not return in order — the slower one would otherwise repopulate the list
        // with the filter the user just moved off.
        if (Worlds.Current?.Id != worldId || CampaignFilterOrNull != campaignFilter)
        {
            return;
        }

        _loading = false;
        if (result.IsSuccess)
        {
            _sources = result.Value!;
        }
        else
        {
            _error = result.Error!.Message;
            _sources = [];
        }
        StateHasChanged();
    }

    private string? CampaignFilterOrNull => string.IsNullOrEmpty(_campaignFilter) ? null : _campaignFilter;


    public void Dispose()
    {
        _pollCts.Cancel();
        _pollCts.Dispose();
        Worlds.Changed -= OnWorldChanged;
    }
}
