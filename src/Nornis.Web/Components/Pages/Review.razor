@page "/review"
@implements IDisposable
@inject WorldState Worlds

<PageTitle>Review Queue — Nornis</PageTitle>

@*
    Page chrome only. The queue itself lives in ReviewQueuePanel so the campaign import can
    host the same thing inline instead of sending the GM here and back for every note.
*@

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Review Queue</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Accept, edit, or reject proposed updates to your record.</MudText>
    </div>
    @if (_count > 0)
    {
        <span class="nornis-count-badge">@_count</span>
    }
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else
{
    <ReviewQueuePanel @ref="_panel" OnQueueChanged="OnCountChanged" />
}

@code {
    private ReviewQueuePanel? _panel;
    private int _count;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
    }

    private void OnWorldChanged() =>
        InvokeAsync(async () =>
        {
            if (_panel is not null)
            {
                await _panel.RefreshAsync();
            }
            StateHasChanged();
        });

    private void OnCountChanged(int count)
    {
        _count = count;
        StateHasChanged();
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
