@page "/review"
@implements IDisposable
@inject WorldState Worlds

<PageTitle>Review — Nornis</PageTitle>

@*
    Page chrome only. The queue itself lives in ReviewQueuePanel so the campaign import can
    host the same thing inline instead of sending the GM here and back for every note.
*@

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Review</MudText>
        @* A player's queue holds only what Nornis proposes from the sources they added, and
           what they accept goes into the record. The page said neither (3.32). *@
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(Worlds.Current is null || Worlds.IsGm
                ? "Accept, edit, or reject what Nornis proposes for your record."
                : "What Nornis proposes from the notes you added. What you accept goes into the world's record.")
        </MudText>
    </div>
    @if (_count > 0)
    {
        <span class="nornis-count-badge">@_count</span>
    }
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else
{
    <ReviewQueuePanel @ref="_panel" OnQueueChanged="OnCountChanged" />
}

@code {
    private ReviewQueuePanel? _panel;
    private int _count;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
    }

    private void OnWorldChanged() =>
        InvokeAsync(async () =>
        {
            if (_panel is not null)
            {
                await _panel.RefreshAsync();
            }
            StateHasChanged();
        });

    private void OnCountChanged(int count) => _count = count;

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
