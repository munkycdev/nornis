@page "/profile"
@inject ThemeState Theme
@inject NavigationManager Nav

<PageTitle>Your account — Nornis</PageTitle>

<div>
    <MudText Typo="Typo.h4" Class="nornis-serif">Your account</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        What follows you to every world: the AI your worlds run on, and how you sign in. What is yours
        at one table (your display name and characters) is on that world's
        <a href="@Links.WorldSettingsYou" class="nornis-link">World settings</a>.
    </MudText>

    @* Two tabs (Nornis 3.31), the shown one in the URL. The world-specific tab moved to World
       settings, so this page is the account alone. Each card saves on its own. *@
    <TabStrip Tabs="Tabs" Active="@_tab" Selected="ShowTab" Label="Your account" Class="nornis-profile-tabs" />

    <div class="nornis-profile nornis-profile-tab-@_tab">
        @switch (_tab)
        {
            case AccountTab:
                <SignInsCard Outcome="@SignInOutcome" />
                <BibliotaphConnectionCard Outcome="@BibliotaphOutcome" />
                <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mb-4">
                    <div class="nornis-detail-section-title">Appearance</div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Paper by day, ink by night, or whichever this device is set to. Kept on this device,
                        not on your account.
                    </MudText>
                    <MudRadioGroup T="ThemePreference" Value="Theme.Preference" ValueChanged="SetThemeAsync">
                        <MudRadio T="ThemePreference" Value="ThemePreference.System" Color="Color.Primary">Match this device</MudRadio>
                        <MudRadio T="ThemePreference" Value="ThemePreference.Light" Color="Color.Primary">Light</MudRadio>
                        <MudRadio T="ThemePreference" Value="ThemePreference.Dark" Color="Color.Primary">Dark</MudRadio>
                    </MudRadioGroup>
                </MudPaper>
                break;

            default:
                @* Who pays is the thing a member gets wrong, so it is said first and plainly (feature 39:
                   a world spends its creator's keys, whoever asked). *@
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4 nornis-profile-ai-scope">
                    <strong>Every world you create runs its AI on these keys and models, for everyone in it.</strong>
                    When anyone in one of your worlds asks the Loremaster, captures a session or drafts in
                    Prep, your provider bills you. Worlds someone else created run on theirs, so you only
                    need a key for the worlds you create.
                </MudAlert>
                <AiKeysCard Changed="ReloadModelsAsync" />
                <AiModelsCard @ref="_models" />
                break;
        }
    </div>
</div>

@code {
    public const string AiTab = "ai";
    public const string AccountTab = "account";

    public static readonly IReadOnlyList<TabStrip.Item> Tabs =
    [
        new(AiTab, "AI"),
        new(AccountTab, "Account"),
    ];

    /// <summary>
    /// The tab to show: the one the URL names, whatever its case; else Account when a sign-in link
    /// or a Bibliotaph connect has just come back here to say how it went; else AI.
    /// </summary>
    public static string TabFor(string? tab, string? signInOutcome, string? bibliotaphOutcome) =>
        Tabs.FirstOrDefault(t => string.Equals(t.Key, tab?.Trim(), StringComparison.OrdinalIgnoreCase))?.Key
        ?? (signInOutcome is not null || bibliotaphOutcome is not null ? AccountTab : AiTab);

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string _tab = AiTab;

    // The URL is the authority on the tab, so Back and a pasted link both land where they say.
    protected override void OnParametersSet() => _tab = TabFor(Tab, SignInOutcome, BibliotaphOutcome);

    private void ShowTab(string tab)
    {
        _tab = tab;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tab), replace: true);
    }

    private Task SetThemeAsync(ThemePreference preference) => Theme.SetPreferenceAsync(preference);

    private AiModelsCard? _models;

    private Task ReloadModelsAsync() => _models?.ReloadAsync() ?? Task.CompletedTask;

    /// <summary>How a Bibliotaph connect attempt ended, when it brought the browser back here.</summary>
    [SupplyParameterFromQuery(Name = "bibliotaph")] public string? BibliotaphOutcome { get; set; }

    /// <summary>How linking another sign-in ended, when it brought the browser back here.</summary>
    [SupplyParameterFromQuery(Name = "signin")] public string? SignInOutcome { get; set; }
}
