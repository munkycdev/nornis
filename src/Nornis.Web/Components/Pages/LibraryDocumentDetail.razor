@page "/library/{Key}"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject BreadcrumbState Crumbs

<PageTitle>@(_document?.Title ?? "Library") — Nornis</PageTitle>

<div>
    @if (Worlds.Current is null)
    {
        <NoWorld />
    }
    else if (_loading)
    {
        <LoadingRows Rows="3" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">This document doesn't exist or you can't see it.</MudAlert>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_document is null)
    {
        <MudAlert Severity="Severity.Warning">This document doesn't exist or you can't see it.</MudAlert>
    }
    else
    {
        <EntityPage>
        <Body>
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            <div class="d-flex align-center gap-3 mb-2">
                @if (_document.HasCover && Worlds.Current is not null)
                {
                    <img src="@($"/library-covers/{Worlds.Current.Id}/{_document.Id}")" alt="" class="nornis-library-cover-large" loading="lazy" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Large" Color="Color.Secondary" />
                }
                <div class="flex-grow-1">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.h5" Class="nornis-serif">@_document.Title</MudText>
                        @if (Worlds.IsGm)
                        {
                            <MudTooltip Text="Rename">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                               OnClick="RenameAsync" aria-label="Rename document" />
                            </MudTooltip>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @if (_document.IsFromBibliotaph)
                        {
                            @_document.Category
                        }
                        else
                        {
                            @($"{_document.Category} · {_document.FileName} · {DisplayText.FormatSize(_document.SizeBytes)}")
                        }
                        @(_document.PageCount is { } p ? $" · {p} pages" : "")
                    </MudText>
                    @if (Worlds.IsGm && _document.AdventureId is { } adventureId)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-library-printed">
                            Printed from <a href="@Links.Adventure(null, adventureId)" class="nornis-link">Prep</a>
                        </MudText>
                    }
                </div>
                <BibliotaphBadge Document="_document" />
                <LibraryVisibilityChip Document="_document" OnChanged="LoadAsync" />
                @if (!_document.IsFromBibliotaph)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@LibraryDisplay.StatusColor(_document.Status)">
                        @LibraryDisplay.StatusLabel(_document.Status, _document.ChunkCount)
                    </MudChip>
                }
            </div>

            @if (_document.IsFromBibliotaph)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    This book lives in the world's Bibliotaph collection. The Loremaster quotes it
                    from there@(Worlds.IsGm ? ", and it leaves this Library when you take it out of the collection in Bibliotaph" : "").
                </MudText>
            }

            @if (_document.Status == "Indexed")
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    The Loremaster can quote this book — ask it anything and citations will
                    point back here with page numbers.
                </MudText>
            }
            else if (_document.Status == "IndexFailed")
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    Indexing failed: @_document.ErrorMessage
                </MudAlert>
            }

            <div class="d-flex gap-2">
                @if (_document.InBibliotaph)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.AutoStories" OnClick="OpenAsync">
                        Open
                    </MudButton>
                }
                @if (!_document.IsFromBibliotaph)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Download" OnClick="DownloadAsync">
                        Download
                    </MudButton>
                }
                @if (_document.Status == "IndexFailed")
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Refresh" OnClick="ReindexAsync">
                        Retry indexing
                    </MudButton>
                }
                <MudSpacer />
                @if (Worlds.IsGm && !_document.IsFromBibliotaph)
                {
                    <MudTooltip Text="@(_document.Status == "Indexing" ? "Available once indexing finishes" : null)">
                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Outlined.Delete"
                                   Disabled="@(_document.Status == "Indexing")"
                                   OnClick="DeleteAsync">
                            Delete
                        </MudButton>
                    </MudTooltip>
                }
            </div>
        </MudPaper>

        @if (Worlds.IsGm && _document.IsOrganisable)
        {
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4 nornis-library-organise">
                <div class="nornis-detail-section-title">Organise</div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    A document that belongs to an adventure stays off the Library's shelf and shows
                    under that adventure instead. Players see it as they do now; only you see where it belongs.
                </MudText>
                <div class="d-flex gap-3 align-center flex-wrap">
                    <MudSelect T="string" Value="@_document.Category" ValueChanged="SetCategoryAsync" Label="Category"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_organising"
                               Class="nornis-library-category-select" Style="max-width: 12rem;">
                        @foreach (var (category, _) in LibraryDisplay.ChoosableCategories)
                        {
                            <MudSelectItem Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Value="@(_document.LinkedAdventureId?.ToString() ?? NoAdventure)" ValueChanged="SetAdventureAsync"
                               Label="Belongs to" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_organising"
                               Class="flex-grow-1 nornis-library-belongs-select" Style="max-width: 20rem;">
                        <MudSelectItem Value="@NoAdventure">No adventure</MudSelectItem>
                        @foreach (var adventure in _adventures)
                        {
                            <MudSelectItem Value="@adventure.Id.ToString()">@adventure.Title</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_document.LinkedAdventureId is { } linkedId)
                    {
                        <a href="@Links.Adventure(null, linkedId)" class="nornis-link nornis-library-belongs-link">Open the adventure</a>
                    }
                </div>
            </MudPaper>
        }

        @if (Worlds.IsGm && _document.InBibliotaph)
        {
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                <MudText Typo="Typo.h6" Class="nornis-serif mb-2">Opened by</MudText>
                @if (_opens.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Nobody has opened this book from Nornis yet.</MudText>
                }
                else
                {
                    @foreach (var open in _opens)
                    {
                        <div class="nornis-list-sub">
                            @open.ViewerName@(open.FromShelfLink ? " (shelf link)" : "") · @DateDisplay.DayAndTime(open.OpenedAt)
                        </div>
                    }
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">Kept for 90 days.</MudText>
            </MudPaper>
        }

        @if (Worlds.IsGm && (_document.Status == "Indexed" || _document.InBibliotaph))
        {
            <MudPaper Elevation="0" Class="nornis-card nornis-card-pad mt-4">
                <div class="nornis-detail-section-title">File pages as a source</div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Choose the pages that are about something in your world and file them as a
                    source. They go through extraction like a session note, and what they say
                    arrives in Review as proposals — for the entry you name here, if you name one.
                    @if (_document.InBibliotaph)
                    {
                        <text> The pages are read from your Bibliotaph, up to 12 at a time.</text>
                    }
                </MudText>
                <div class="d-flex gap-3 align-center flex-wrap">
                    <MudNumericField T="int?" @bind-Value="_pageFrom" Label="From page" Min="1"
                                     Max="@(_document.PageCount ?? int.MaxValue)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 9rem;" />
                    <MudNumericField T="int?" @bind-Value="_pageTo" Label="To page" Min="1"
                                     Max="@(_document.PageCount ?? int.MaxValue)"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 9rem;" />
                    <MudAutocomplete T="ArtifactListItem" @bind-Value="_excerptArtifact"
                                     SearchFunc="SearchArtifactsAsync"
                                     ToStringFunc="@(a => a?.Name)"
                                     Label="For codex entry (optional)" Variant="Variant.Outlined" Dense="true"
                                     Class="flex-grow-1" Clearable="true" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.PostAdd"
                               OnClick="FileExcerptAsync" Disabled="@(_filing || _pageFrom is null || _pageTo is null)">
                        File as source
                    </MudButton>
                </div>
                @if (_excerptError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_excerptError</MudAlert>
                }
            </MudPaper>
        }
        </Body>
        <Rail>
            <ContextRail Rows="@RailRows" Related="@RailRelated" RowsTitle="This document" />
        </Rail>
        </EntityPage>
    }
</div>

@code {
    /// <summary>The slug, or an id from a link minted before slugs; see <see cref="Links"/>.</summary>
    [Parameter] public string Key { get; set; } = string.Empty;

    private bool _loading;
    private bool _notFound;
    private string? _error;
    private string? _loadedKey;
    private LibraryDocumentDto? _document;
    private IReadOnlyList<LibraryOpenDto> _opens = [];

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Guard on the id we last ATTEMPTED, not the loaded row — a failed load must
        // not leave the page refusing to retry when the route changes.
        if (Key != _loadedKey)
        {
            await LoadAsync();
        }
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private IReadOnlyList<ContextRail.RailRow> RailRows => _document is null ? [] :
    [
        new("Category", _document.Category),
        new("Pages", _document.PageCount?.ToString() ?? "—"),
        new("Passages", _document.ChunkCount.ToString()),
        new("Status", _document.Status),
    ];

    private IReadOnlyList<ContextRail.RailLink> RailRelated => [];

    // BL0012 is off for this method: the visibility chip runs it as an event handler, which is
    // what the rule sees, but WorldState.Changed also runs it through InvokeAsync, and other
    // handlers call it after their own awaits. Nothing renders there unless this does.
#pragma warning disable BL0012
    private async Task LoadAsync()
    {
        if (Worlds.Current is null)
        {
            _document = null;
            StateHasChanged();
            return;
        }

        _loading = true;
        _notFound = false;
        _error = null;
        _loadedKey = Key;
        StateHasChanged();

        var result = await Api.GetLibraryDocumentAsync(Worlds.Current.Id, Key);
        _loading = false;
        if (result.IsSuccess)
        {
            _document = result.Value;
            if (_document is not null)
            {
                if (!Links.IsCanonical(Key, _document.Slug))
                {
                    _loadedKey = _document.Slug;
                    Nav.NavigateTo(Links.LibraryDocument(_document.Slug, _document.Id), replace: true);
                }
                Crumbs.Set(Links.LibraryDocument(_document.Slug, _document.Id), new Crumb("Library", "/library"), new Crumb(_document.Title));
                await LoadOpensAsync();
                await LoadAdventuresAsync();
            }
        }
        else if (result.Error!.Code == "not_found")
        {
            _notFound = true;
            _document = null;
        }
        else
        {
            // A transient API failure is not "this document doesn't exist" — say what
            // actually happened, like the source and artifact detail pages do.
            _error = result.Error!.Message;
            _document = null;
        }
        StateHasChanged();
    }
#pragma warning restore BL0012

    private async Task OpenAsync()
    {
        if (Worlds.Current is null || _document is null) return;
        var result = await Api.ReadLibraryDocumentAsync(Worlds.Current.Id, _document.Id, null);
        if (result.IsSuccess)
        {
            await JS.TryInvokeVoidAsync("nornisUpload.open", result.Value!.Url);
            await LoadOpensAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Warning);
        }
    }

    private async Task LoadOpensAsync()
    {
        _opens = [];
        if (Worlds.Current is null || _document is not { InBibliotaph: true } || !Worlds.IsGm)
        {
            return;
        }

        var result = await Api.GetLibraryOpensAsync(Worlds.Current.Id, _document.Id);
        _opens = result.IsSuccess ? result.Value! : [];
        StateHasChanged();
    }

    // Organise (feature 36, GM): an upload's category and the Adventure it belongs to. The API
    // refuses both for prints and Bibliotaph books, which is why the card only shows for uploads.
    private const string NoAdventure = "none";
    private IReadOnlyList<AdventureSummaryDto> _adventures = [];
    private bool _organising;

    private async Task LoadAdventuresAsync()
    {
        _adventures = [];
        if (Worlds.Current is null || _document is not { IsOrganisable: true } || !Worlds.IsGm)
        {
            return;
        }

        var result = await Api.GetAdventuresAsync(Worlds.Current.Id);
        _adventures = result.IsSuccess
            ? result.Value!.OrderBy(a => a.Title, StringComparer.CurrentCultureIgnoreCase).ToList()
            : [];
        StateHasChanged();
    }

    private Task SetCategoryAsync(string category) =>
        OrganiseAsync(id => Api.SetLibraryKindAsync(Worlds.Current!.Id, id, LibraryDisplay.KindFor(category)));

    private Task SetAdventureAsync(string value) =>
        OrganiseAsync(id => Api.SetLibraryAdventureLinkAsync(Worlds.Current!.Id, id,
            Guid.TryParse(value, out var adventureId) ? adventureId : null));

    private async Task OrganiseAsync(Func<Guid, Task<ApiResult<LibraryDocumentDto>>> change)
    {
        if (Worlds.Current is null || _document is null) return;

        _organising = true;
        var result = await change(_document.Id);
        _organising = false;
        if (result.IsSuccess)
        {
            _document = result.Value!;
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task DownloadAsync()
    {
        if (Worlds.Current is null || _document is null) return;
        var result = await Api.GetLibraryDownloadAsync(Worlds.Current.Id, _document.Id);
        if (result.IsSuccess)
        {
            await JS.TryInvokeVoidAsync("nornisUpload.open", result.Value!.DownloadUrl);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task ReindexAsync()
    {
        if (Worlds.Current is null || _document is null) return;
        var result = await Api.ReindexLibraryDocumentAsync(Worlds.Current.Id, _document.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add("Indexing queued.", Severity.Info);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    private async Task RenameAsync()
    {
        if (Worlds.Current is null || _document is null) return;

        var parameters = new DialogParameters<RenameLibraryDocumentDialog>
        {
            { d => d.WorldId, Worlds.Current.Id },
            { d => d.DocumentId, _document.Id },
            { d => d.CurrentTitle, _document.Title },
        };

        var dialog = await DialogService.ShowAsync<RenameLibraryDocumentDialog>("Rename document", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: LibraryDocumentDto renamed })
        {
            _document = renamed;
            Snackbar.Add("Document renamed.", Severity.Success);
        }
    }

    private async Task DeleteAsync()
    {
        if (Worlds.Current is null || _document is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete document?",
            $"Remove \"{_document.Title}\" from the library? Its file and indexed passages are deleted.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var result = await Api.DeleteLibraryDocumentAsync(Worlds.Current.Id, _document.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add($"\"{_document.Title}\" removed.", Severity.Success);
            Nav.NavigateTo("/library");
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
    }

    // File pages as a source (GM): a page range of this document becomes an excerpt source,
    // optionally filed for a codex entry. The server bounds the range; this only asks.
    private int? _pageFrom;
    private int? _pageTo;
    private ArtifactListItem? _excerptArtifact;
    private bool _filing;
    private string? _excerptError;

    private async Task<IEnumerable<ArtifactListItem>> SearchArtifactsAsync(string value, CancellationToken ct)
    {
        if (Worlds.Current is null)
        {
            return [];
        }

        var result = await Api.GetArtifactsAsync(Worlds.Current.Id, ct: ct);
        if (!result.IsSuccess)
        {
            return [];
        }

        return result.Value!
            .Where(a => string.IsNullOrWhiteSpace(value) || a.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.Name)
            .Take(15);
    }

    private async Task FileExcerptAsync()
    {
        if (Worlds.Current is null || _document is null || _pageFrom is null || _pageTo is null)
        {
            return;
        }

        _filing = true;
        _excerptError = null;

        var result = await Api.FileLibraryExcerptAsync(Worlds.Current.Id, _document.Id,
            new FileLibraryExcerptRequest(null, _pageFrom, _pageTo, _excerptArtifact?.Id));

        _filing = false;
        if (!result.IsSuccess)
        {
            _excerptError = result.Error!.Message;
            return;
        }

        var sourceLink = Links.Source(result.Value!.Slug, result.Value.SourceId);
        Snackbar.Add($"Filed “{result.Value.Title}” — extraction queued.", Severity.Success, options =>
        {
            options.Action = "Open";
            options.OnClick = _ =>
            {
                Nav.NavigateTo(sourceLink);
                return Task.CompletedTask;
            };
        });
        _pageFrom = null;
        _pageTo = null;
        _excerptArtifact = null;
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
