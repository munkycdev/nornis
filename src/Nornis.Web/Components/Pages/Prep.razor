@page "/prep"
@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject BreadcrumbState Crumbs

<PageTitle>Prep — Nornis</PageTitle>

<div class="nornis-page-head">
    <div>
        <MudText Typo="Typo.h4" Class="nornis-serif">Prep</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Adventures you're getting ready to run. Only you see them, and nothing here is canon
            until you send it into Nornis.
        </MudText>
        @if (_budget is { } budget)
        {
            <MudText Typo="Typo.caption" Color="@(budget.IsExceeded ? Color.Error : Color.Secondary)" Class="nornis-prep-spend">
                Drafting this month: @PrepSpend(budget)
            </MudText>
        }
    </div>
    @if (Worlds.Current is not null && Worlds.IsGm)
    {
        <div class="nornis-page-head-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.FileUpload" OnClick="ImportAsync">
                Import Markdown
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync">
                New adventure
            </MudButton>
        </div>
    }
</div>

@if (Worlds.Current is null)
{
    <NoWorld />
}
else if (!Worlds.IsGm)
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Class="nornis-comingsoon-icon" />
        <MudText Typo="Typo.h5" Class="nornis-serif">GMs only</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Prep is the GM's planning, and it can hold anything the players haven't learned yet.
        </MudText>
    </MudPaper>
}
else if (_loading)
{
    <LoadingRows Rows="3" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_adventures.Count == 0)
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-comingsoon">
        <MudIcon Icon="@Icons.Material.Outlined.HistoryEdu" Size="Size.Large" Class="nornis-comingsoon-icon" />
        <MudText Typo="Typo.h5" Class="nornis-serif">Nothing in prep yet</MudText>
        <MudText Typo="Typo.body1" Class="nornis-comingsoon-text mt-2">
            Start an adventure from an outline of scenes, or import one you've already written in Markdown.
        </MudText>
    </MudPaper>
}
else
{
    <div class="nornis-filter-row mb-3 nornis-prep-filters">
        @foreach (var filter in PrepDisplay.Filters)
        {
            var f = filter;
            <MudChip T="string" Size="@(f == PrepListFilter.All ? Size.Medium : Size.Small)"
                     Variant="@(_filter == f ? Variant.Filled : Variant.Outlined)"
                     Color="@(_filter == f ? Color.Secondary : Color.Default)"
                     OnClick="() => _filter = f">@f</MudChip>
        }
    </div>

    @if (FilteredAdventures.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-prep-filter-empty">@PrepDisplay.EmptyFilterText(_filter)</MudText>
    }
    else
    {
        <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
            @foreach (var adventure in FilteredAdventures)
            {
                <a href="@Links.Adventure(adventure.Slug, adventure.Id)" class="nornis-list-row nornis-list-link nornis-prep-row">
                    <div class="nornis-list-thumb">
                        <MudIcon Icon="@Icons.Material.Outlined.HistoryEdu" Size="Size.Small" />
                    </div>
                    <div class="nornis-list-body">
                        <div class="nornis-list-title">@adventure.Title</div>
                        <div class="nornis-list-sub">
                            @CampaignName(adventure.CampaignId) · @PrepDisplay.Progress(adventure.FilledSectionCount, adventure.SectionCount) · edited @RelativeTime.Ago(adventure.UpdatedAt)
                        </div>
                    </div>
                    @if (adventure.IsExported)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Tertiary" Class="nornis-prep-exported">Exported</MudChip>
                    }
                    @if (PrepDisplay.IsPublished(adventure))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="nornis-prep-published">Published</MudChip>
                    }
                </a>
            }
        </MudPaper>
    }
}

@code {
    private bool _loading;
    private string? _error;
    private IReadOnlyList<AdventureSummaryDto> _adventures = [];
    private IReadOnlyList<CampaignDto> _campaigns = [];
    private PrepBudgetDto? _budget;
    private PrepListFilter _filter = PrepListFilter.All;

    private IReadOnlyList<AdventureSummaryDto> FilteredAdventures =>
        _adventures.Where(a => PrepDisplay.Matches(_filter, a)).ToList();

    /// <summary>The month's drafting spend against its ceiling, as the Settings card states it.</summary>
    private static string PrepSpend(PrepBudgetDto budget) =>
        budget.MonthlyBudgetUsd is { } cap
            ? $"${budget.SpentThisMonthUsd:0.00} of ${cap:0.00}{(budget.IsExceeded ? ", spent until next month" : "")}"
            : $"${budget.SpentThisMonthUsd:0.00}, no monthly limit";

    protected override async Task OnInitializedAsync()
    {
        Crumbs.Set("/prep", new Crumb("Prep"));
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadAsync();
    }

    private void OnWorldChanged() => InvokeAsync(LoadAsync);

    private string CampaignName(Guid? campaignId) =>
        campaignId is { } id && _campaigns.FirstOrDefault(c => c.Id == id) is { } campaign
            ? campaign.Name
            : "World-level";

    private async Task LoadAsync()
    {
        if (Worlds.Current is null || !Worlds.IsGm)
        {
            _adventures = [];
            _budget = null;
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        var worldId = Worlds.Current.Id;
        var adventures = await Api.GetAdventuresAsync(worldId);
        var campaigns = await Api.GetCampaignsAsync(worldId);
        var budget = await Api.GetPrepBudgetAsync(worldId);
        _budget = budget.Value;

        _loading = false;
        if (adventures.IsSuccess)
        {
            _adventures = adventures.Value!;
        }
        else
        {
            _error = adventures.Error!.Message;
        }

        _campaigns = campaigns.Value ?? [];
        StateHasChanged();
    }

    private Task CreateAsync() => OpenAsync<AdventureDetailsDialog>("New adventure");

    private Task ImportAsync() => OpenAsync<ImportAdventureDialog>("Import Markdown");

    /// <summary>Both dialogs take the same parameters and close with the new Adventure, which opens.</summary>
    private async Task OpenAsync<TDialog>(string title) where TDialog : IComponent
    {
        if (Worlds.Current is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["WorldId"] = Worlds.Current.Id,
            ["Campaigns"] = _campaigns,
            ["DefaultCampaignId"] = Worlds.Current.CurrentCampaignId,
        };
        var dialog = await DialogService.ShowAsync<TDialog>(title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AdventureDto created })
        {
            Nav.NavigateTo(Links.Adventure(created.Slug, created.Id));
        }
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
