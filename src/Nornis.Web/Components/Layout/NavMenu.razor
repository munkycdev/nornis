<a href="/" class="nornis-brand nornis-brand-link" aria-label="Nornis home">
    <img src="images/logo.png" alt="Nornis" class="nornis-brand-logo" />
    <div class="nornis-brand-name">NORNIS</div>
    <div class="nornis-brand-tagline">Your world, remembered.</div>
</a>

@* MudBlazor 9 does not wire a click onto ActivatorContent — only the Label form renders a
   button that opens itself. Any menu with custom activator content has to open itself, so the
   @ref and the @onclick below are what make this clickable at all. *@
<MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="nornis-world-menu" @ref="_worldMenu">
    <ActivatorContent>
        <div class="nornis-world @(Worlds.ViewingAsPlayer ? "nornis-world-viewas" : null)"
             @onclick="OpenWorldMenuAsync">
            <MudIcon Icon="@Icons.Material.Outlined.Terrain" Class="nornis-world-icon" />
            <div class="flex-grow-1">
                <div class="nornis-world-name">@(Worlds.Current?.Name ?? "No world")</div>
                @if (Worlds.Current is null)
                {
                    <div class="nornis-world-label">Select or create</div>
                }
                else if (Worlds.ViewingAsPlayer)
                {
                    <div class="nornis-world-label">
                        <button type="button" class="nornis-role-chip nornis-role-chip-active"
                                title="Return to GM view"
                                @onclick="ExitPlayerView" @onclick:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="nornis-role-chip-icon" />
                            Viewing as player · back to GM
                        </button>
                    </div>
                }
                else
                {
                    <div class="nornis-world-label d-flex align-center gap-1">
                        World ·
                        @if (Worlds.Current.MyRole == WorldRoles.Gm)
                        {
                            <button type="button" class="nornis-role-chip"
                                    title="See this world as your players do"
                                    @onclick="EnterPlayerView" @onclick:stopPropagation="true">
                                GM
                                <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="nornis-role-chip-icon" />
                            </button>
                        }
                        else
                        {
                            <span class="nornis-role-chip nornis-role-chip-static">@Worlds.Current.MyRole</span>
                        }
                    </div>
                }
            </div>
            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
        </div>
    </ActivatorContent>
    <ChildContent>
        @foreach (var world in EverydayWorlds)
        {
            <MudMenuItem OnClick="@(() => SelectWorldAsync(world.Id))">@world.Name</MudMenuItem>
        }
        @* Template masters are still selectable — exporting a template runs through the
           normal world UI — but they are filed away so they don't crowd the real worlds. *@
        @if (TemplateWorlds.Count > 0)
        {
            <MudDivider />
            <div class="nornis-menu-caption">Templates</div>
            @foreach (var world in TemplateWorlds)
            {
                <MudMenuItem OnClick="@(() => SelectWorldAsync(world.Id))">@world.Name</MudMenuItem>
            }
        }
        @if (Worlds.Worlds.Count > 0)
        {
            <MudDivider />
        }
        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="CreateWorld">New world</MudMenuItem>
        @if (Worlds.Current?.MyRole == WorldRoles.Gm && !Worlds.ViewingAsPlayer)
        {
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Visibility" OnClick="EnterPlayerView">View as player</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ChatBubbleOutline">Ask</MudNavLink>
    <MudNavLink Href="/capture" Icon="@Icons.Material.Outlined.EditNote">Capture</MudNavLink>
    <MudNavLink Href="/review" Icon="@Icons.Material.Outlined.FactCheck">
        Review
        @if (_activity is { PendingProposals: > 0 })
        {
            <span class="nornis-nav-count">@(_activity.PendingProposalsCapped ? "200+" : _activity.PendingProposals.ToString())</span>
        }
    </MudNavLink>
    <MudNavLink Href="/artifacts" Icon="@Icons.Material.Outlined.Hub">Codex</MudNavLink>
    <MudNavLink Href="/timeline" Icon="@Icons.Material.Outlined.Route">Timeline</MudNavLink>
    <MudNavLink Href="/locations" Icon="@Icons.Material.Outlined.Place">Locations</MudNavLink>
    <MudNavLink Href="/learned" Icon="@Icons.Material.Outlined.MarkEmailRead">
        What you learned
        @* Absent at zero, per the requirement: a badge reading "0" is a page telling you
           there is nothing, which is exactly the thing this feature must not volunteer. *@
        @if (_activity is { UnseenDisclosures: > 0 })
        {
            <span class="nornis-nav-count" title="new to you">@_activity.UnseenDisclosures</span>
        }
    </MudNavLink>
    <MudNavLink Href="/library" Icon="@Icons.Material.Outlined.MenuBook">Library</MudNavLink>
    <MudNavLink Href="/sources" Icon="@Icons.Material.Outlined.Layers">
        Sources
        @if (_activity is { Failed: > 0 })
        {
            <span class="nornis-nav-count nornis-nav-count-failed" title="@($"{_activity.Failed} failed")">@_activity.Failed</span>
        }
        else if (_activity is { InFlight: > 0 })
        {
            <span class="nornis-nav-count" title="processing">@_activity.InFlight</span>
        }
    </MudNavLink>
    @if (Worlds.IsGm)
    {
        <MudNavLink Href="/convergence" Icon="@Icons.Material.Outlined.Visibility">Convergence</MudNavLink>
        <MudNavLink Href="/admin" Icon="@Icons.Material.Outlined.Tune">Admin</MudNavLink>
    }
</MudNavMenu>

@if (Worlds.IsGm)
{
<div class="nornis-memory">
    <div class="nornis-memory-title">World Memory</div>
    <div class="nornis-memory-row">
        <div class="nornis-ring">
            <MudProgressCircular Value="@(Worlds.Continuity?.EffectiveScore ?? 0)" Min="0" Max="100"
                                 Color="@HealthColor" Size="Size.Medium" StrokeWidth="4" Class="nornis-ring-onnavy" />
        </div>
        <div class="nornis-memory-figure">
            @if (Worlds.Continuity is { HasData: true } a)
            {
                <span class="nornis-memory-pct">@a.EffectiveScore%</span>
                <span class="nornis-memory-state nornis-memory-state-ok">AI assessed</span>
            }
            else
            {
                <span class="nornis-memory-pct">N/A</span>
                <span class="nornis-memory-state">Not yet assessed</span>
            }
        </div>
    </div>
    <MudButton Variant="Variant.Text"
               Color="Color.Secondary"
               EndIcon="@Icons.Material.Filled.ArrowForward"
               Href="/world-memory"
               Class="nornis-collapse pa-0">
        View details
    </MudButton>
</div>
}

@if (AuthSession.Expired)
{
    @* The person whose poll is failing is the one person the failure is invisible to — the badge
       just stops moving. Say so, and offer the fix: a full page load re-runs the cookie path,
       which either refreshes the tokens silently or ends the session cleanly at the login page. *@
    <div class="px-3 py-1">
        <MudAlert Severity="Severity.Warning" Dense="true">
            Your session has expired.
            <MudLink OnClick="ReloadToSignIn" Typo="Typo.body2"><b>Sign in again</b></MudLink>
        </MudAlert>
    </div>
}

@if (Auth.Enabled)
{
    <AuthorizeView>
        <Authorized>
            <div class="nornis-member-row px-4 py-2">
                <a href="/profile" class="nornis-link d-flex align-center gap-2 flex-grow-1" title="Your settings">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                    <span class="nornis-list-sub">@context.User.Identity?.Name</span>
                </a>
                <MudTooltip Text="Sign out">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small"
                                   Href="/account/logout" aria-label="Sign out" />
                </MudTooltip>
            </div>
        </Authorized>
    </AuthorizeView>
}
else
{
    @* Dev auth: no identity to show, but the profile page still needs its entry point. *@
    <div class="nornis-member-row px-4 py-2">
        <a href="/profile" class="nornis-link d-flex align-center gap-2 flex-grow-1" title="Your settings">
            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
            <span class="nornis-list-sub">Your settings</span>
        </a>
    </div>
}

<MudButton Variant="Variant.Text"
           StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
           OnClick="OnCollapse"
           Class="nornis-collapse">
    Collapse
</MudButton>

@implements IAsyncDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject Nornis.Web.State.ActivitySignal Activity
@inject NavigationManager Nav
@inject Nornis.Web.Authentication.AuthFeature Auth
@inject Nornis.Web.State.AuthSessionState AuthSession
@inject IDialogService DialogService
@inject IJSRuntime JS

@code {
    private MudMenu? _worldMenu;

    private Task OpenWorldMenuAsync() =>
        _worldMenu?.OpenMenuAsync(EventArgs.Empty) ?? Task.CompletedTask;

    [Parameter]
    public EventCallback OnCollapse { get; set; }

    /// <summary>Worlds the GM actually plays in — everything that isn't a template master.</summary>
    private IReadOnlyList<WorldSummary> EverydayWorlds =>
        Worlds.Worlds.Where(w => !w.IsTemplate).ToList();

    /// <summary>Template masters, shown in their own subdued group. Empty for almost everyone.</summary>
    private IReadOnlyList<WorldSummary> TemplateWorlds =>
        Worlds.Worlds.Where(w => w.IsTemplate).ToList();

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldsChanged;

        // The two things that used to leave the badges stale: a change this browser made, and
        // arriving on a page after making one somewhere else.
        Activity.Changed += OnActivitySignal;
        Nav.LocationChanged += OnLocationChanged;
        AuthSession.Changed += OnAuthSessionChanged;

        // Everything below is wasted during the static prerender pass. The authenticated shell
        // renders nothing but a boot spinner then — MainLayout gates @Body on Worlds.Ready, which
        // cannot become true without JS interop — and the circuit that follows starts a fresh DI
        // scope, so this WorldState instance and its dedupe cache are discarded either way. Doing
        // the work anyway meant every full page load fetched the world list twice and briefly ran
        // two copies of the poll timer below.
        //
        // Prerendering itself is deliberately left on: the public /w/{slug} pages use
        // PublicLayout, render real content, and want to be indexable and unfurlable.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await Worlds.EnsureLoadedAsync();
        await RefreshActivityAsync();
        _ = PollActivityAsync();
    }

    // A signal means this browser just wrote something, so the counts are known to be stale —
    // never let the freshness window swallow it.
    private void OnActivitySignal() => InvokeAsync(() => RefreshActivityAsync(force: true));

    // Navigation alone changes nothing server-side, so this one respects the freshness window.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(() => RefreshActivityAsync());

    // The session flipped between working and expired. Show or clear the banner, and cut the
    // current wait short so the loop recomputes its cadence now — in both directions: dropping
    // to the slow probe immediately is the point of the fix, and picking the normal cadence
    // back up immediately is what makes recovery feel like nothing was ever wrong.
    private void OnAuthSessionChanged() => InvokeAsync(() =>
    {
        _pollWake?.Cancel();
        StateHasChanged();
    });

    /// <summary>
    /// A full document load — not a circuit navigation — so the request runs the cookie path:
    /// <c>Auth0TokenRefresher.ValidatePrincipalAsync</c> either refreshes the tokens and writes
    /// them back into the cookie, or rejects the principal and the user lands on a clean login.
    /// A circuit can do neither for itself: it makes no full HTTP requests, and a cookie cannot
    /// be rewritten over an established SignalR connection.
    /// </summary>
    private void ReloadToSignIn() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    // Light poll so processing/review badges move without navigation.
    private SourceActivity? _activity;
    private readonly CancellationTokenSource _activityCts = new();

    /// <summary>
    /// Whether something will change these numbers without the user doing anything.
    ///
    /// Only the pipeline states count. A review backlog is deliberately excluded: pending
    /// proposals sit at a nonzero count for as long as the GM takes to walk the queue, so
    /// including it pinned every open tab to the fast cadence indefinitely — exactly the load
    /// this cadence exists to shed. New proposals arrive when an extraction finishes, and that
    /// transition is already covered by <c>Queued</c>/<c>Processing</c> being non-zero while it
    /// is happening.
    ///
    /// <c>Ready</c> stays in: it is normally a brief hop before <c>Queued</c>, and the alternative
    /// is a badge that lags a just-marked-ready source by up to 90 seconds. It can strand there if
    /// an enqueue fails, which pins the fast poll — rare, and the visible cost of being wrong in
    /// the safe direction.
    /// </summary>
    private bool HasWorkInFlight => _activity is not null
        && (_activity.Queued > 0 || _activity.Processing > 0 || _activity.Ready > 0);

    /// <summary>
    /// Whether this tab is in the foreground. Assumed true until the browser says otherwise, so a
    /// failed interop leaves the old always-poll behaviour rather than a badge that never updates.
    /// </summary>
    private bool _tabVisible = true;

    private DotNetObjectReference<NavMenu>? _selfRef;
    private int? _visibilityToken;

    /// <summary>
    /// Called from <c>nornis-nav.js</c> on every <c>visibilitychange</c>.
    ///
    /// <para>Coming back to a tab is the one moment the badges are guaranteed to be stale — the
    /// poll has been parked for however long the tab sat in the background — so this refreshes
    /// immediately and skips the freshness window. Going away just stops the poll; there is
    /// nothing to fetch for.</para>
    /// </summary>
    [JSInvokable]
    public Task OnTabVisibilityChanged(bool visible) => InvokeAsync(async () =>
    {
        var wasVisible = _tabVisible;
        _tabVisible = visible;

        if (NavActivityCadence.ShouldRefreshOnVisibilityChange(wasVisible, visible))
        {
            await RefreshActivityAsync(force: true);
            StateHasChanged();

            // The loop is sitting in a wait sized for a hidden tab. Cut it short so the next
            // interval reflects being back in the foreground.
            _pollWake?.Cancel();
        }
    });

    private Task PollActivityAsync() => NavActivityCadence.RunAsync(
        isTabVisible: () => _tabVisible,
        hasWorkInFlight: () => HasWorkInFlight,
        isSessionExpired: () => AuthSession.Expired,
        waitAsync: WaitForNextPollAsync,
        fetchAsync: () => RefreshActivityAsync(),
        ct: _activityCts.Token);

    /// <summary>
    /// Cancelled to cut a poll wait short when the tab comes back, so the loop can pick up the
    /// fast cadence instead of finishing the ninety-second wait it started while hidden.
    /// </summary>
    private CancellationTokenSource? _pollWake;

    private async Task<bool> WaitForNextPollAsync(TimeSpan interval, CancellationToken ct)
    {
        using var wake = CancellationTokenSource.CreateLinkedTokenSource(ct);
        _pollWake = wake;

        try
        {
            using var timer = new PeriodicTimer(interval);
            return await timer.WaitForNextTickAsync(wake.Token);
        }
        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
        {
            // Woken, not disposed.
            return false;
        }
        finally
        {
            _pollWake = null;
        }
    }

    /// <param name="force">
    /// Skip the freshness window. Used when something is known to have changed the numbers —
    /// a write this browser made — where showing a stale badge would look like a lost update.
    /// </param>
    private async Task RefreshActivityAsync(bool force = false)
    {
        if (Worlds.Current is null)
        {
            _activity = null;
            return;
        }

        // A refresh can be triggered from several places at once — a signal and a navigation often
        // land together. Only one runs; the loser records that it wanted one rather than vanishing,
        // because a dropped trigger used to leave the badge stale until the next poll tick, which
        // on an idle world is 90 seconds away.
        if (_activityRefreshing)
        {
            _refreshRequestedWhileBusy = true;
            _forceRequestedWhileBusy |= force;
            return;
        }

        // The concurrency guard above only collapses *simultaneous* triggers. Sequential ones
        // still each cost a request, and they arrive in bursts: boot raises Worlds.Changed three
        // times, and a navigation often lands right behind another trigger. A short freshness
        // window collapses those into one fetch.
        //
        // Keyed on world AND effective role, because the API answers differently for each: the
        // client stamps X-Nornis-View-As on every call and the server rewrites the member role
        // from it. Keyed on world alone, toggling "view as player" within the window kept the
        // GM's counts on screen beside a preview claiming to show a player's view.
        var key = ActivityKey();
        if (!force
            && _activityKey == key
            && _activityFetchedAt is { } last
            && DateTimeOffset.UtcNow - last < FreshnessWindow)
        {
            return;
        }

        _activityRefreshing = true;
        try
        {
            var worldId = Worlds.Current.Id;
            var result = await Api.GetSourceActivityAsync(worldId, _activityCts.Token);

            // Discard a response for a world or role the user has since moved away from —
            // otherwise a slow fetch can paint the previous world's totals under the new name.
            if (result.IsSuccess && Worlds.Current?.Id == worldId && ActivityKey() == key)
            {
                _activity = result.Value;
                _activityKey = key;
                _activityFetchedAt = DateTimeOffset.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away or disposed mid-flight.
        }
        finally
        {
            _activityRefreshing = false;
        }

        // Serve whoever was turned away while this ran. Bounded: the re-run clears the flags
        // before it starts, so a steady stream of triggers collapses into one follow-up rather
        // than recursing per trigger.
        if (_refreshRequestedWhileBusy)
        {
            var forceRerun = _forceRequestedWhileBusy;
            _refreshRequestedWhileBusy = false;
            _forceRequestedWhileBusy = false;
            await RefreshActivityAsync(forceRerun);
        }
    }

    private bool _activityRefreshing;
    private bool _refreshRequestedWhileBusy;
    private bool _forceRequestedWhileBusy;

    /// <summary>
    /// How long a just-fetched set of counts is considered current. Deliberately shorter than any
    /// poll interval — this exists to collapse trigger bursts, not to slow the badge down.
    /// </summary>
    private static readonly TimeSpan FreshnessWindow = TimeSpan.FromSeconds(3);

    private DateTimeOffset? _activityFetchedAt;

    /// <summary>
    /// What the counts we hold describe: the world, and the role they were fetched under. Both
    /// matter — the API answers differently when a GM is viewing as a player.
    /// </summary>
    private (Guid World, string? Role)? _activityKey;

    private (Guid World, string? Role)? ActivityKey() =>
        Worlds.Current is null ? null : (Worlds.Current.Id, Worlds.EffectiveRole);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Complete the boot: WorldState picks the saved world (localStorage needs JS, so
        // after render). Until this flips Worlds.Ready, the layout shows a loading screen
        // instead of any world's content.
        await Worlds.EnsureSelectionRestoredAsync();

        await StartWatchingTabVisibilityAsync();
    }

    /// <summary>
    /// Subscribes to tab visibility so the activity poll can stand down in a background tab.
    ///
    /// <para>Best-effort throughout: every failure path leaves <see cref="_tabVisible"/> true,
    /// which is the old behaviour of polling regardless. A badge that costs a request every 90
    /// seconds is a much smaller problem than a badge that stops updating.</para>
    /// </summary>
    private async Task StartWatchingTabVisibilityAsync()
    {
        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            _visibilityToken = await JS.InvokeAsync<int>("nornisNav.watchVisibility", _selfRef);

            // The listener only fires on a CHANGE, and a tab can already be in the background by
            // the time the circuit is live — a restored session, or a ctrl-clicked link. Without
            // this the poll would run at full rate in a tab nobody has ever looked at.
            _tabVisible = await JS.InvokeAsync<bool>("nornisNav.isTabVisible");
        }
        catch
        {
            _tabVisible = true;
        }
    }

    private Task SelectWorldAsync(Guid worldId) => Worlds.SelectAsync(worldId);

    private void OnWorldsChanged() => InvokeAsync(async () =>
    {
        await RefreshActivityAsync();
        StateHasChanged();
    });

    private Color HealthColor => (Worlds.Continuity?.EffectiveScore ?? 0) switch
    {
        >= 70 => Color.Success,
        >= 50 => Color.Warning,
        _ => Color.Error,
    };

    private void EnterPlayerView() => Worlds.SetViewingAsPlayer(true);

    private void ExitPlayerView() => Worlds.SetViewingAsPlayer(false);

    private async Task CreateWorld()
    {
        var dialog = await DialogService.ShowAsync<CreateWorldDialog>("New world");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is WorldSummary created)
        {
            await Worlds.ReloadAsync();
            await SelectWorldAsync(created.Id);
        }
    }

    private bool _disposed;

    public async ValueTask DisposeAsync()
    {
        // Blazor disposes a component once, but tests drive this directly and Cancel() after
        // Dispose() throws — which would skip the JS cleanup below.
        if (_disposed)
        {
            return;
        }

        _disposed = true;

        _activityCts.Cancel();
        _activityCts.Dispose();
        Activity.Changed -= OnActivitySignal;
        Nav.LocationChanged -= OnLocationChanged;
        AuthSession.Changed -= OnAuthSessionChanged;
        Worlds.Changed -= OnWorldsChanged;

        if (_visibilityToken is { } token)
        {
            try
            {
                await JS.InvokeVoidAsync("nornisNav.unwatchVisibility", token);
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — the browser cleaned up with the page.
            }
        }

        _selfRef?.Dispose();
    }
}
