<a href="/" class="nornis-brand nornis-brand-link" aria-label="Nornis home">
    <img src="images/logo.png" alt="Nornis" class="nornis-brand-logo" />
    <div class="nornis-brand-name">NORNIS</div>
    <div class="nornis-brand-tagline">Your world, remembered.</div>
</a>

<MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Class="nornis-world-menu">
    <ActivatorContent>
        <div class="nornis-world @(Worlds.ViewingAsPlayer ? "nornis-world-viewas" : null)">
            <MudIcon Icon="@Icons.Material.Outlined.Terrain" Class="nornis-world-icon" />
            <div class="flex-grow-1">
                <div class="nornis-world-name">@(Worlds.Current?.Name ?? "No world")</div>
                @if (Worlds.Current is null)
                {
                    <div class="nornis-world-label">Select or create</div>
                }
                else if (Worlds.ViewingAsPlayer)
                {
                    <div class="nornis-world-label">
                        <button type="button" class="nornis-role-chip nornis-role-chip-active"
                                title="Return to GM view"
                                @onclick="ExitPlayerView" @onclick:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="nornis-role-chip-icon" />
                            Viewing as player · back to GM
                        </button>
                    </div>
                }
                else
                {
                    <div class="nornis-world-label d-flex align-center gap-1">
                        World ·
                        @if (Worlds.Current.MyRole == "GM")
                        {
                            <button type="button" class="nornis-role-chip"
                                    title="See this world as your players do"
                                    @onclick="EnterPlayerView" @onclick:stopPropagation="true">
                                GM
                                <MudIcon Icon="@Icons.Material.Outlined.Visibility" Class="nornis-role-chip-icon" />
                            </button>
                        }
                        else
                        {
                            <span class="nornis-role-chip nornis-role-chip-static">@Worlds.Current.MyRole</span>
                        }
                    </div>
                }
            </div>
            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
        </div>
    </ActivatorContent>
    <ChildContent>
        @foreach (var world in EverydayWorlds)
        {
            <MudMenuItem OnClick="@(() => SelectWorldAsync(world.Id))">@world.Name</MudMenuItem>
        }
        @* Template masters are still selectable — exporting a template runs through the
           normal world UI — but they are filed away so they don't crowd the real worlds. *@
        @if (TemplateWorlds.Count > 0)
        {
            <MudDivider />
            <div class="nornis-menu-caption">Templates</div>
            @foreach (var world in TemplateWorlds)
            {
                <MudMenuItem OnClick="@(() => SelectWorldAsync(world.Id))">@world.Name</MudMenuItem>
            }
        }
        @if (Worlds.Worlds.Count > 0)
        {
            <MudDivider />
        }
        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="CreateWorld">New world</MudMenuItem>
        @if (Worlds.Current?.MyRole == "GM" && !Worlds.ViewingAsPlayer)
        {
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Visibility" OnClick="EnterPlayerView">View as player</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ChatBubbleOutline">Ask</MudNavLink>
    <MudNavLink Href="/capture" Icon="@Icons.Material.Outlined.EditNote">Capture</MudNavLink>
    <MudNavLink Href="/review" Icon="@Icons.Material.Outlined.FactCheck">
        Review
        @if (_activity is { PendingProposals: > 0 })
        {
            <span class="nornis-nav-count">@(_activity.PendingProposalsCapped ? "200+" : _activity.PendingProposals.ToString())</span>
        }
    </MudNavLink>
    <MudNavLink Href="/artifacts" Icon="@Icons.Material.Outlined.Hub">Codex</MudNavLink>
    <MudNavLink Href="/timeline" Icon="@Icons.Material.Outlined.Route">Timeline</MudNavLink>
    <MudNavLink Href="/locations" Icon="@Icons.Material.Outlined.Place">Locations</MudNavLink>
    <MudNavLink Href="/library" Icon="@Icons.Material.Outlined.MenuBook">Library</MudNavLink>
    <MudNavLink Href="/sources" Icon="@Icons.Material.Outlined.Layers">
        Sources
        @if (_activity is { Failed: > 0 })
        {
            <span class="nornis-nav-count nornis-nav-count-failed" title="@($"{_activity.Failed} failed")">@_activity.Failed</span>
        }
        else if (_activity is { InFlight: > 0 })
        {
            <span class="nornis-nav-count" title="processing">@_activity.InFlight</span>
        }
    </MudNavLink>
    @if (Worlds.EffectiveRole == "GM")
    {
        <MudNavLink Href="/admin" Icon="@Icons.Material.Outlined.Tune">Admin</MudNavLink>
    }
</MudNavMenu>

@if (Worlds.EffectiveRole == "GM")
{
<div class="nornis-memory">
    <div class="nornis-memory-title">World Memory</div>
    <div class="nornis-memory-row">
        <div class="nornis-ring">
            <MudProgressCircular Value="@(Worlds.Continuity?.EffectiveScore ?? 0)" Min="0" Max="100"
                                 Color="@HealthColor" Size="Size.Medium" StrokeWidth="4" Class="nornis-ring-onnavy" />
        </div>
        <div class="nornis-memory-figure">
            @if (Worlds.Continuity is { HasData: true } a)
            {
                <span class="nornis-memory-pct">@a.EffectiveScore%</span>
                <span class="nornis-memory-state nornis-memory-state-ok">AI assessed</span>
            }
            else
            {
                <span class="nornis-memory-pct">N/A</span>
                <span class="nornis-memory-state">Not yet assessed</span>
            }
        </div>
    </div>
    <MudButton Variant="Variant.Text"
               Color="Color.Secondary"
               EndIcon="@Icons.Material.Filled.ArrowForward"
               Href="/world-memory"
               Class="nornis-collapse pa-0">
        View details
    </MudButton>
</div>
}

@if (Auth.Enabled)
{
    <AuthorizeView>
        <Authorized>
            <div class="nornis-member-row px-4 py-2">
                <a href="/profile" class="nornis-link d-flex align-center gap-2 flex-grow-1" title="Your settings">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                    <span class="nornis-list-sub">@context.User.Identity?.Name</span>
                </a>
                <MudTooltip Text="Sign out">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small"
                                   Href="/account/logout" aria-label="Sign out" />
                </MudTooltip>
            </div>
        </Authorized>
    </AuthorizeView>
}
else
{
    @* Dev auth: no identity to show, but the profile page still needs its entry point. *@
    <div class="nornis-member-row px-4 py-2">
        <a href="/profile" class="nornis-link d-flex align-center gap-2 flex-grow-1" title="Your settings">
            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
            <span class="nornis-list-sub">Your settings</span>
        </a>
    </div>
}

<MudButton Variant="Variant.Text"
           StartIcon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
           OnClick="OnCollapse"
           Class="nornis-collapse">
    Collapse
</MudButton>

@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject Nornis.Web.State.ActivitySignal Activity
@inject NavigationManager Nav
@inject Nornis.Web.Authentication.AuthFeature Auth
@inject IDialogService DialogService
@inject IJSRuntime JS

@code {
    [Parameter]
    public EventCallback OnCollapse { get; set; }

    /// <summary>Worlds the GM actually plays in — everything that isn't a template master.</summary>
    private IReadOnlyList<WorldSummary> EverydayWorlds =>
        Worlds.Worlds.Where(w => !w.IsTemplate).ToList();

    /// <summary>Template masters, shown in their own subdued group. Empty for almost everyone.</summary>
    private IReadOnlyList<WorldSummary> TemplateWorlds =>
        Worlds.Worlds.Where(w => w.IsTemplate).ToList();

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldsChanged;

        // The two things that used to leave the badges stale: a change this browser made, and
        // arriving on a page after making one somewhere else.
        Activity.Changed += OnActivitySignal;
        Nav.LocationChanged += OnLocationChanged;

        // Everything below is wasted during the static prerender pass. The authenticated shell
        // renders nothing but a boot spinner then — MainLayout gates @Body on Worlds.Ready, which
        // cannot become true without JS interop — and the circuit that follows starts a fresh DI
        // scope, so this WorldState instance and its dedupe cache are discarded either way. Doing
        // the work anyway meant every full page load fetched the world list twice and briefly ran
        // two copies of the poll timer below.
        //
        // Prerendering itself is deliberately left on: the public /w/{slug} pages use
        // PublicLayout, render real content, and want to be indexable and unfurlable.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await Worlds.EnsureLoadedAsync();
        await RefreshActivityAsync();
        _ = PollActivityAsync();
    }

    // A signal means this browser just wrote something, so the counts are known to be stale —
    // never let the freshness window swallow it.
    private void OnActivitySignal() => InvokeAsync(() => RefreshActivityAsync(force: true));

    // Navigation alone changes nothing server-side, so this one respects the freshness window.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(() => RefreshActivityAsync());

    // Light poll so processing/review badges move without navigation.
    private SourceActivity? _activity;
    private readonly CancellationTokenSource _activityCts = new();

    /// <summary>Poll cadence while something is actually moving.</summary>
    private static readonly TimeSpan ActiveInterval = TimeSpan.FromSeconds(15);

    /// <summary>
    /// Cadence when the world is idle. Nothing changes these numbers without either this browser
    /// acting — which raises <c>ActivitySignal</c> and refreshes immediately — or the worker
    /// finishing something, which only happens when work was queued. So the fast poll buys
    /// nothing on an idle world, and it used to run forever in every open tab.
    /// </summary>
    private static readonly TimeSpan IdleInterval = TimeSpan.FromSeconds(90);

    /// <summary>Anything in flight, or anything waiting to be reviewed.</summary>
    private bool HasWorkInFlight => _activity is not null
        && (_activity.Queued > 0 || _activity.Processing > 0 || _activity.Ready > 0
            || _activity.PendingProposals > 0);

    private async Task PollActivityAsync()
    {
        try
        {
            // Rebuilt each iteration so the cadence can follow the world's state. PeriodicTimer's
            // Period is settable, but recreating keeps the intent obvious at the call site.
            while (!_activityCts.IsCancellationRequested)
            {
                using var timer = new PeriodicTimer(HasWorkInFlight ? ActiveInterval : IdleInterval);
                if (!await timer.WaitForNextTickAsync(_activityCts.Token))
                {
                    return;
                }

                await RefreshActivityAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    /// <param name="force">
    /// Skip the freshness window. Used when something is known to have changed the numbers —
    /// a write this browser made — where showing a stale badge would look like a lost update.
    /// </param>
    private async Task RefreshActivityAsync(bool force = false)
    {
        if (Worlds.Current is null)
        {
            _activity = null;
            return;
        }

        // A refresh can now be triggered from several places at once — a signal and a navigation
        // often land together — and each is a round trip. One at a time is plenty; the loser
        // drops out rather than queueing a duplicate fetch of the same numbers.
        if (_activityRefreshing)
        {
            return;
        }

        // The concurrency guard above only collapses *simultaneous* triggers. Sequential ones
        // still each cost a request, and they arrive in bursts: boot raises Worlds.Changed three
        // times, and a navigation often lands right behind another trigger. A short freshness
        // window collapses those into one fetch.
        //
        // It applies only when the counts we hold are for the world being asked about — these
        // numbers are per-world, so a world switch must always refetch or the badge would show
        // the previous world's totals.
        var sameWorld = _activityWorldId == Worlds.Current.Id;
        if (!force
            && sameWorld
            && _activityFetchedAt is { } last
            && DateTimeOffset.UtcNow - last < FreshnessWindow)
        {
            return;
        }

        _activityRefreshing = true;
        try
        {
            var worldId = Worlds.Current.Id;
            var result = await Api.GetSourceActivityAsync(worldId, _activityCts.Token);
            if (result.IsSuccess)
            {
                _activity = result.Value;
                _activityWorldId = worldId;
                _activityFetchedAt = DateTimeOffset.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away or disposed mid-flight.
        }
        finally
        {
            _activityRefreshing = false;
        }
    }

    private bool _activityRefreshing;

    /// <summary>
    /// How long a just-fetched set of counts is considered current. Deliberately shorter than any
    /// poll interval — this exists to collapse trigger bursts, not to slow the badge down.
    /// </summary>
    private static readonly TimeSpan FreshnessWindow = TimeSpan.FromSeconds(3);

    private DateTimeOffset? _activityFetchedAt;

    /// <summary>Which world the counts we are holding belong to — the window must not suppress a
    /// refetch after a world switch.</summary>
    private Guid? _activityWorldId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Complete the boot: WorldState picks the saved world (localStorage needs JS, so
        // after render). Until this flips Worlds.Ready, the layout shows a loading screen
        // instead of any world's content.
        await Worlds.EnsureSelectionRestoredAsync();
    }

    private async Task SelectWorldAsync(Guid worldId)
    {
        Worlds.Select(worldId);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", WorldState.StorageKey, worldId.ToString());
        }
        catch
        {
            // Best-effort persist.
        }
    }

    private void OnWorldsChanged() => InvokeAsync(async () =>
    {
        await RefreshActivityAsync();
        StateHasChanged();
    });

    private Color HealthColor => (Worlds.Continuity?.EffectiveScore ?? 0) switch
    {
        >= 70 => Color.Success,
        >= 50 => Color.Warning,
        _ => Color.Error,
    };

    private void EnterPlayerView() => Worlds.SetViewingAsPlayer(true);

    private void ExitPlayerView() => Worlds.SetViewingAsPlayer(false);

    private async Task CreateWorld()
    {
        var dialog = await DialogService.ShowAsync<CreateWorldDialog>("New world");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is WorldSummary created)
        {
            await Worlds.ReloadAsync();
            await SelectWorldAsync(created.Id);
        }
    }

    public void Dispose()
    {
        _activityCts.Cancel();
        _activityCts.Dispose();
        Activity.Changed -= OnActivitySignal;
        Nav.LocationChanged -= OnLocationChanged;
        Worlds.Changed -= OnWorldsChanged;
    }
}
