@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject WorldState Worlds
@inject BreadcrumbState Crumbs
@inject QuickSwitcherState Switcher
@inject WorldMenuState WorldMenu
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudThemeProvider Theme="NornisTheme.Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<QuickSwitcher />

<MudLayout>
    @* Persistent from md up; below that it closes itself and reopens as an overlay from the topbar. *@
    @* Wider than MudBlazor's 240px default: the world switcher at the top of the drawer is the
       widest thing in it, and at 240 a world name landed on top of its chevron. *@
    <MudDrawer @bind-Open="_navOpen"
               Fixed="true"
               Width="272px"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Class="nornis-sidebar">
        <NavMenu OnCollapse="ToggleNav" />
    </MudDrawer>

    <MudMainContent Class="nornis-main">
        @* Rendered only when it has something in it — search needs a world, and the menu
           button only appears once the drawer has closed itself. *@
        @if (!_navOpen || Worlds.Current is not null)
        {
            <header class="nornis-topbar">
                @if (!_navOpen)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleNav" aria-label="Show navigation" />
                }
                <Breadcrumb OnWorldClick="WorldMenu.Open" />
                <div class="flex-grow-1"></div>
                <GmNoteButton />
            </header>
        }

        <div class="nornis-page">
            @* Boot gate: nothing world-scoped renders until the saved world selection is
               restored — otherwise pages flash the wrong world's content and re-fetch. *@
            @if (Worlds.Ready)
            {
                @Body
            }
            else
            {
                <div class="nornis-boot" aria-busy="true" aria-label="Loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Secondary" Size="Size.Large" />
                </div>
            }
        </div>

        <TutorialChecklist />

        <footer class="nornis-footer">
            <nav class="nornis-footer-links" aria-label="Legal and info">
                <a href="/about">About</a>
                <a href="/features">Features</a>
                <a href="/changelog">Changelog</a>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
                <a href="/licenses">Licenses</a>
            </nav>
            <span class="nornis-footer-made">Made with ❤️ by 👨 and 🤖 for people who love 🎲</span>
            <a href="/welcome" class="nornis-footer-version">© @DateTime.UtcNow.Year Nornis · v@(Nornis.Web.AppVersion.Display)</a>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _navOpen = true;
    private DotNetObjectReference<MainLayout>? _selfRef;

    private void ToggleNav() => _navOpen = !_navOpen;

    protected override void OnInitialized()
    {
        Worlds.Changed += OnWorldChanged;
        Nav.LocationChanged += OnLocationChanged;
        // The route default for the first page; a page that knows more replaces it.
        Crumbs.SetFromRoute(Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0]);
    }

    // The top bar comes and goes with the world selection, so it has to re-render on change.
    private void OnWorldChanged() => InvokeAsync(StateHasChanged);

    // Fires before the new page renders, so the route default lands first and the page's own
    // trail (set from data it already holds) wins afterwards.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        Crumbs.SetFromRoute(Nav.ToBaseRelativePath(e.Location).Split('?')[0]);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("nornisNav.watchQuickSwitcher", _selfRef);
        }
        catch
        {
            // No JS, no shortcut; the sidebar's search box still opens it.
        }
    }

    /// <summary>Ctrl+K (or ⌘K) from anywhere in the member app.</summary>
    [JSInvokable]
    public void OpenQuickSwitcher() => Switcher.Open();

    public async ValueTask DisposeAsync()
    {
        Worlds.Changed -= OnWorldChanged;
        Nav.LocationChanged -= OnLocationChanged;
        try
        {
            await JS.InvokeVoidAsync("nornisNav.unwatchQuickSwitcher");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — the browser cleaned up with the page.
        }
        catch (InvalidOperationException)
        {
            // Prerender pass: there was never a JS side to unwatch.
        }
        _selfRef?.Dispose();
    }
}
