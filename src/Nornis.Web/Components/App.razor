<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @* Assets[...] resolves to the fingerprinted, precompressed variant emitted by
       MapStaticAssets, which also sets immutable Cache-Control. That replaces the hand-rolled
       "?v=" busters these tags used to carry — a fingerprinted URL changes when the content
       changes, so a stale app.css can no longer pair old layout rules with new markup. *@
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <title>Nornis</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    @* Fingerprinted via Assets[...] — the "?v=" busters these carried are now redundant, and
       unlike them a content hash cannot be forgotten when the file changes. *@
    <script src="@Assets["lib/force-graph.min.js"]"></script>
    <script src="@Assets["js/nornis-graph.js"]"></script>
    <script src="@Assets["lib/tiptap.bundle.min.js"]"></script>
    <script src="@Assets["js/nornis-editor.js"]"></script>
    <script src="@Assets["js/nornis-timeline.js"]"></script>
    <script src="@Assets["js/nornis-journey.js"]"></script>
    <script src="@Assets["js/nornis-map-edit.js"]"></script>
    <script src="@Assets["js/nornis-upload.js"]"></script>
    <script src="@Assets["js/nornis-ink.js"]"></script>
    <script src="@Assets["js/nornis-nav.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
