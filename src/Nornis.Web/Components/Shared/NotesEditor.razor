@using Nornis.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@* TipTap WYSIWYG for capture notes (ported from Chronicis, styling only — no wiki links or
   external references). Edits HTML in the browser; the page pulls markdown once at save via
   GetMarkdownAsync. Markdown-style typing (**bold**, # heading, - list) and the usual
   hotkeys work alongside the toolbar. *@

<div class="nornis-editor @(ReadOnly ? "nornis-editor-ro" : "") @(_maximized ? "nornis-editor-max" : "")"
     @onkeydown="OnKeyDownAsync">
    @if (!ReadOnly)
    {
    <div class="nornis-editor-toolbar">
        <MudTooltip Text="Bold (Ctrl+B)">
            <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small"
                           OnClick="@(() => ExecAsync("bold"))" aria-label="Bold" />
        </MudTooltip>
        <MudTooltip Text="Italic (Ctrl+I)">
            <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" Size="Size.Small"
                           OnClick="@(() => ExecAsync("italic"))" aria-label="Italic" />
        </MudTooltip>
        <MudTooltip Text="Strikethrough">
            <MudIconButton Icon="@Icons.Material.Filled.FormatStrikethrough" Size="Size.Small"
                           OnClick="@(() => ExecAsync("strike"))" aria-label="Strikethrough" />
        </MudTooltip>

        <span class="nornis-editor-toolbar-sep"></span>

        <MudTooltip Text="Heading 1 (or type # )">
            <MudIconButton Icon="@Icons.Material.Filled.LooksOne" Size="Size.Small"
                           OnClick="@(() => ExecAsync("h1"))" aria-label="Heading 1" />
        </MudTooltip>
        <MudTooltip Text="Heading 2 (or type ## )">
            <MudIconButton Icon="@Icons.Material.Filled.LooksTwo" Size="Size.Small"
                           OnClick="@(() => ExecAsync("h2"))" aria-label="Heading 2" />
        </MudTooltip>
        <MudTooltip Text="Heading 3 (or type ### )">
            <MudIconButton Icon="@Icons.Material.Filled.Looks3" Size="Size.Small"
                           OnClick="@(() => ExecAsync("h3"))" aria-label="Heading 3" />
        </MudTooltip>

        <span class="nornis-editor-toolbar-sep"></span>

        <MudTooltip Text="Bullet list (or type - )">
            <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small"
                           OnClick="@(() => ExecAsync("bulletList"))" aria-label="Bullet list" />
        </MudTooltip>
        <MudTooltip Text="Numbered list (or type 1. )">
            <MudIconButton Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small"
                           OnClick="@(() => ExecAsync("orderedList"))" aria-label="Numbered list" />
        </MudTooltip>

        <span class="nornis-editor-toolbar-sep"></span>

        <MudTooltip Text="Quote">
            <MudIconButton Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small"
                           OnClick="@(() => ExecAsync("blockquote"))" aria-label="Quote" />
        </MudTooltip>
        <MudTooltip Text="Code block">
            <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small"
                           OnClick="@(() => ExecAsync("codeBlock"))" aria-label="Code block" />
        </MudTooltip>
        <MudTooltip Text="Divider">
            <MudIconButton Icon="@Icons.Material.Filled.HorizontalRule" Size="Size.Small"
                           OnClick="@(() => ExecAsync("hr"))" aria-label="Divider" />
        </MudTooltip>

        <span class="nornis-editor-toolbar-sep"></span>

        <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" @ref="_tableMenu">
            <ActivatorContent>
                <MudTooltip Text="Table">
                    <MudIconButton Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" aria-label="Table"
                                   OnClick="@(() => _tableMenu!.OpenMenuAsync(EventArgs.Empty))" />
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => ExecAsync("insertTable"))">Insert table</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExecAsync("addRowAfter"))">Add row below</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExecAsync("addColumnAfter"))">Add column right</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExecAsync("toggleHeaderRow"))">Toggle header row</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExecAsync("deleteRow"))">Delete row</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExecAsync("deleteColumn"))">Delete column</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExecAsync("deleteTable"))">Delete table</MudMenuItem>
            </ChildContent>
        </MudMenu>

        @if (AllowMaximize)
        {
            @* Long session notes want the whole screen, not a 320px box inside a card. The
               toggle sits at the toolbar's far end, apart from the formatting controls. *@
            <span class="nornis-editor-toolbar-grow"></span>
            <MudTooltip Text="@(_maximized ? "Restore (Esc)" : "Maximize")">
                <MudIconButton Icon="@(_maximized ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                               Size="Size.Small" OnClick="ToggleMaximizeAsync"
                               aria-label="@(_maximized ? "Restore editor size" : "Maximize editor")"
                               aria-pressed="@(_maximized ? "true" : "false")" />
            </MudTooltip>
        }
    </div>
    }
    <div id="@_elementId" class="nornis-editor-content"></div>
</div>

@code {
    private MudMenu? _tableMenu;

    /// <summary>Markdown to load into the editor on first render.</summary>
    [Parameter] public string? InitialMarkdown { get; set; }

    /// <summary>Pre-rendered HTML to load instead of markdown — used by read views that
    /// parse markdown with Markdig (better CommonMark fidelity than the JS converter).</summary>
    [Parameter] public string? InitialHtml { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Display mode: no toolbar, not editable, chrome stripped by CSS.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Offers a toolbar toggle that grows the editor to the whole viewport. Off by default:
    /// a sheet on a character page or a body being corrected in place fits where it is; the
    /// capture page, where a session's notes are typed from scratch, turns it on.
    /// </summary>
    [Parameter] public bool AllowMaximize { get; set; }

    /// <summary>
    /// When set, what is typed is kept under this key in the browser's localStorage as it goes
    /// (written by nornis-editor.js, never across the circuit) and comes back on the next mount
    /// with empty initial content. Null means no safety net — the read views and the in-place
    /// edits that already have a saved body behind them.
    /// </summary>
    [Parameter] public string? BackupKey { get; set; }

    /// <summary>
    /// Load the kept notes even over non-empty initial content. An edit page seeds the editor
    /// with the stored body, and the kept copy is newer edits on top of it; the capture page
    /// leaves this off, because its non-empty initial content is a fresh transcription that must
    /// not be overwritten by an older abandoned note.
    /// </summary>
    [Parameter] public bool PreferBackup { get; set; }

    /// <summary>Raised once, after first render, with the time the restored notes were kept at.</summary>
    [Parameter] public EventCallback<DateTimeOffset> Restored { get; set; }

    /// <summary>Puts this text in the editor and forgets the kept copy — "discard my unsaved changes".</summary>
    public async Task ReplaceAsync(string? markdown)
    {
        if (!_initialized)
        {
            return;
        }

        await ClearBackupAsync();
        await JS.InvokeVoidAsync("nornisEditor.setContent", _elementId, markdown ?? string.Empty);
    }

    private readonly string _elementId = $"nornis-editor-{Guid.NewGuid():N}";
    private bool _initialized;
    private bool _maximized;

    /// <summary>Empties the editor and forgets its backup — "start fresh".</summary>
    public async Task ClearAsync()
    {
        if (!_initialized)
        {
            return;
        }

        await ClearBackupAsync();
        await JS.InvokeVoidAsync("nornisEditor.setContent", _elementId, string.Empty);
    }

    /// <summary>Forgets the kept notes. The page calls this the moment a save has succeeded.</summary>
    public async Task ClearBackupAsync()
    {
        if (BackupKey is not null)
        {
            await JS.InvokeVoidAsync("nornisEditor.clearBackup", BackupKey);
        }
    }

    /// <summary>
    /// A presentation state, not content: the TipTap instance stays mounted in the same element
    /// and only the wrapper's class changes, so nothing typed is at risk in the toggle.
    /// </summary>
    private async Task ToggleMaximizeAsync()
    {
        _maximized = !_maximized;
        StateHasChanged();

        // The button took the focus; hand it back to the text so typing carries on.
        if (_initialized)
        {
            await JS.InvokeVoidAsync("nornisEditor.focus", _elementId);
        }
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        _maximized && e.Key == "Escape" ? ToggleMaximizeAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ensureHtml on the JS side auto-detects HTML vs markdown content. The return is
            // the ISO time of a backup loaded in place of empty content, or null.
            var restoredAt = await JS.InvokeAsync<string?>("nornisEditor.init",
                _elementId, InitialHtml ?? InitialMarkdown, ReadOnly ? null : Placeholder, !ReadOnly,
                ReadOnly ? null : BackupKey, PreferBackup);
            _initialized = true;

            if (DateTimeOffset.TryParse(restoredAt, null, System.Globalization.DateTimeStyles.RoundtripKind, out var keptAt))
            {
                await Restored.InvokeAsync(keptAt);
            }
        }
    }

    /// <summary>
    /// True once the JS editor has been initialised. Callers that treat an empty result as
    /// an intentional clear MUST check this first — see <see cref="GetMarkdownAsync"/>.
    /// </summary>
    public bool Initialized => _initialized;

    /// <summary>
    /// Current content as markdown, or null when effectively empty.
    ///
    /// Throws when the editor never initialised, which is the point: this used to return
    /// null in that case, indistinguishable from "the user emptied the box". Now that an
    /// empty body is a instruction to clear the stored one, a failed JS init returning
    /// null silently would erase a source's contents. Loud beats lossy.
    /// </summary>
    public async Task<string?> GetMarkdownAsync()
    {
        if (!_initialized)
        {
            throw new InvalidOperationException(
                "NotesEditor has not initialised; check Initialized before reading content.");
        }

        var html = await JS.InvokeAsync<string>("nornisEditor.getHtml", _elementId);
        var markdown = HtmlToMarkdownConverter.Convert(html);
        return string.IsNullOrWhiteSpace(markdown) ? null : markdown;
    }

    private async Task ExecAsync(string command) =>
        await JS.InvokeVoidAsync("nornisEditor.exec", _elementId, command);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("nornisEditor.destroy", _elementId);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — the browser cleaned the editor up with the page.
        }
    }
}
