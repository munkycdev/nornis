@inject WorldState Worlds
@inject NornisApiClient Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

@* Chronicis's 3-step SAS handshake from Blazor Server: request-upload mints the write URL,
   nornis-upload.js PUTs the file straight to blob storage (never over the SignalR circuit),
   and confirm verifies arrival — queueing indexing when it's a PDF.
   A Prep print is not uploaded here: the print page files it in one click (feature 34). *@

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_title" Label="Title" Required="true" Immediate="true"
                      MaxLength="200" Variant="Variant.Outlined" Class="mb-3" />

        <div class="d-flex gap-3 mb-3">
            <MudSelect @bind-Value="_kind" Label="Category" Variant="Variant.Outlined" Class="flex-grow-1">
                @foreach (var (category, kind) in LibraryDisplay.ChoosableCategories)
                {
                    <MudSelectItem Value="@kind">@category</MudSelectItem>
                }
            </MudSelect>
            @if (Worlds.IsGm)
            {
                <MudSelect @bind-Value="_visibility" Label="Visibility" Variant="Variant.Outlined" Class="flex-grow-1">
                    <MudSelectItem Value="@("GMOnly")">GM only</MudSelectItem>
                    <MudSelectItem Value="@("PartyVisible")">Party visible</MudSelectItem>
                </MudSelect>
            }
        </div>

        @if (Worlds.IsGm && _adventures.Count > 0)
        {
            <MudSelect T="string" @bind-Value="_belongsTo" Label="Belongs to" Variant="Variant.Outlined"
                       HelperText="An adventure's documents stay off the shelf and show under that adventure."
                       Class="mb-3 nornis-upload-belongs">
                <MudSelectItem Value="@NoAdventure">The shelf (no adventure)</MudSelectItem>
                @foreach (var adventure in _adventures)
                {
                    <MudSelectItem Value="@adventure.Id.ToString()">@adventure.Title</MudSelectItem>
                }
            </MudSelect>
        }

        @* Plain file input: nornis-upload.js reads it by id for the direct-to-blob PUT. *@
        <InputFile id="@_inputId" OnChange="OnFileSelected" class="nornis-upload-input"
                   accept=".pdf,.png,.jpg,.jpeg,.gif,.webp" />

        @if (_fileName is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@_fileName (@DisplayText.FormatSize(_fileSize))</MudText>
        }

        @if (_uploading)
        {
            <MudProgressLinear Value="@_progress" Color="Color.Primary" Class="mt-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Uploading… @_progress%</MudText>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_uploading">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="UploadAsync"
                   Disabled="@(_uploading || _fileName is null || string.IsNullOrWhiteSpace(_title))">
            Upload
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string NoAdventure = "none";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The Adventure the upload starts out belonging to (feature 36). Preset when the dialog is
    /// opened from an Adventure; the GM can still change it.
    /// </summary>
    [Parameter] public Guid? AdventureId { get; set; }

    /// <summary>The kind the upload starts out as (feature 38: the Handouts card presets Handout); Sourcebook when unset.</summary>
    [Parameter] public string? Kind { get; set; }

    private IReadOnlyList<AdventureSummaryDto> _adventures = [];
    private string _belongsTo = NoAdventure;

    protected override async Task OnInitializedAsync()
    {
        _belongsTo = AdventureId?.ToString() ?? NoAdventure;
        _kind = Kind ?? _kind;
        if (Worlds.Current is null || !Worlds.IsGm)
        {
            return;
        }

        var result = await Api.GetAdventuresAsync(Worlds.Current.Id);
        _adventures = result.IsSuccess
            ? result.Value!.OrderBy(a => a.Title, StringComparer.CurrentCultureIgnoreCase).ToList()
            : [];
    }

    private readonly string _inputId = $"nornis-upload-{Guid.NewGuid():N}";
    private string _title = string.Empty;
    private string _kind = "Sourcebook";
    private string _visibility = "GMOnly";
    private string? _fileName;
    private string _contentType = string.Empty;
    private long _fileSize;
    private bool _uploading;
    private int _progress;
    private string? _error;
    private DotNetObjectReference<LibraryUploadDialog>? _selfRef;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _fileName = file.Name;
        _fileSize = file.Size;
        _contentType = file.ContentType;
        if (string.IsNullOrWhiteSpace(_title))
        {
            _title = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    [JSInvokable]
    public void OnUploadProgress(int percent)
    {
        _progress = percent;
        InvokeAsync(StateHasChanged);
    }

    private async Task UploadAsync()
    {
        if (Worlds.Current is null || _fileName is null)
        {
            return;
        }

        _uploading = true;
        _progress = 0;
        _error = null;

        var visibility = Worlds.IsGm ? _visibility : "PartyVisible";
        Guid? belongsTo = Worlds.IsGm && Guid.TryParse(_belongsTo, out var adventureId) ? adventureId : null;
        var ticket = await Api.RequestLibraryUploadAsync(Worlds.Current.Id,
            new RequestLibraryUploadRequest(_title.Trim(), _fileName, _contentType, _fileSize, _kind, visibility, belongsTo));

        if (!ticket.IsSuccess)
        {
            _uploading = false;
            _error = ticket.Error!.Message;
            return;
        }

        _selfRef ??= DotNetObjectReference.Create(this);
        var uploaded = await JS.InvokeAsync<bool>("nornisUpload.send",
            _inputId, ticket.Value!.UploadUrl, ticket.Value.Document.ContentType, _selfRef);

        if (!uploaded)
        {
            _uploading = false;
            _error = "Upload failed — the file never reached storage. Try again.";
            return;
        }

        var confirmed = await Api.ConfirmLibraryUploadAsync(Worlds.Current.Id, ticket.Value.Document.Id);
        _uploading = false;

        if (!confirmed.IsSuccess)
        {
            _error = confirmed.Error!.Message;
            return;
        }

        var isPdf = confirmed.Value!.Status == "Indexing";
        Snackbar.Add(isPdf
            ? $"\"{_title.Trim()}\" uploaded — indexing for the Loremaster now."
            : $"\"{_title.Trim()}\" uploaded.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(confirmed.Value));
    }

    private void Cancel() => MudDialog.Cancel();
    public void Dispose() => _selfRef?.Dispose();

}
