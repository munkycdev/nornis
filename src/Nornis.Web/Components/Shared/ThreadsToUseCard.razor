@inject NornisApiClient Api

@* Threads to use (feature 30): the hidden truths the convergence gauge ranks as closest to
   being revealed, shown on the Overview so the GM can build the adventure toward one. It reads
   the gauge's plain GET, never its narration, so it costs no AI. Use in this adventure only
   hands a line to the page's instruction box; nothing here writes to a section. *@

<div class="nornis-prep-threads mb-3">
    <MudText Typo="Typo.subtitle2">Threads to use</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-2" />
    }
    else if (_error is not null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-prep-threads-error">
            Threads to use couldn't be loaded. Drafting still works.
        </MudText>
    }
    else if (_threads.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-prep-threads-empty">
            Nothing hidden yet. Mark a fact or entry Hidden and it shows up here when it is ready to pay off.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Hidden truths your world ranks as most ready to reveal. Draft also sees these.
        </MudText>
        @foreach (var thread in _threads)
        {
            <div class="nornis-prep-thread">
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body2"><strong>@thread.AnchorName</strong>: @thread.Description</MudText>
                    <div class="nornis-convergence-chips">
                        @foreach (var phrase in ConvergenceDisplay.Phrases(thread))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@phrase</MudChip>
                        }
                    </div>
                </div>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="nornis-prep-thread-use"
                           StartIcon="@Icons.Material.Outlined.AddCircleOutline" Disabled="@Disabled"
                           OnClick="() => OnUse.InvokeAsync(InstructionLine(thread))">
                    Use in this adventure
                </MudButton>
            </div>
        }
    }
</div>

@code {
    /// <summary>How many threads show. Mirrors <c>AdventureDraftPrompt.MaxThreads</c>, so the card shows what a draft sees; pinned by a test.</summary>
    public const int MaxThreads = 5;

    [Parameter] public Guid WorldId { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Called with the line to add to the instruction box.</summary>
    [Parameter] public EventCallback<string> OnUse { get; set; }

    private IReadOnlyList<ConvergenceCandidateDto> _threads = [];
    private bool _loading = true;
    private string? _error;
    private Guid _loadedFor;

    /// <summary>The line Use in this adventure adds: the thread named, so the GM can edit it like their own words.</summary>
    public static string InstructionLine(ConvergenceCandidateDto thread) =>
        $"Build toward this hidden thread: {thread.AnchorName}: {thread.Description.Trim()}";

    protected override async Task OnParametersSetAsync()
    {
        if (WorldId == _loadedFor)
        {
            return;
        }

        _loadedFor = WorldId;
        _loading = true;
        var result = await Api.GetConvergenceAsync(WorldId);
        _loading = false;
        if (result.IsSuccess)
        {
            _threads = result.Value!.Candidates.Take(MaxThreads).ToList();
            _error = null;
        }
        else
        {
            _error = result.Error!.Message;
        }
    }
}
