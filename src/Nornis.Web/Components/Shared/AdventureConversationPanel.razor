@inject NornisApiClient Api
@inject IDialogService DialogService
@inject IJSRuntime JS

@* Talk it through: the Adventure's side conversation with the Loremaster (feature 30). GM-only
   like the page it sits on. The GM's message is saved before the answer starts, and an answer is
   saved only when it ends cleanly, so the panel reloads from the server after every turn and
   says so under a question that has no answer. Put in section is the page's to do (it owns the
   editor, whose typing must be saved first); the panel only asks which section and how. *@

<MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-prep-talk">
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.overline" Color="Color.Secondary" Class="flex-grow-1">Talk it through</MudText>
        @if (_messages.Count > 0)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.DeleteSweep"
                       Class="nornis-prep-talk-clear" Disabled="@_streaming" OnClick="ClearAsync">
                Clear
            </MudButton>
        }
    </div>

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_loadError</MudAlert>
    }
    else if (_messages.Count == 0 && !_streaming)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 nornis-prep-talk-empty">
            @if (DraftMode)
            {
                @:Talk the draft through with the Loremaster. It sees the whole draft, and when you ask it
                @:to write or change something it does so in the draft. Undo on the draft takes a change back.
            }
            else
            {
                @:Ask the Loremaster about this adventure. It knows your world, Hidden truth included, and
                @:the section you have open. Nothing here changes the adventure until you put an answer in.
            }
        </MudText>
    }

    <div class="nornis-prep-talk-messages" aria-live="polite" @ref="_list">
        @foreach (var (message, index) in _messages.Select((m, i) => (m, i)))
        {
            <div class="nornis-prep-talk-message @(message.IsAnswer ? "nornis-prep-talk-answer" : "nornis-prep-talk-question")"
                 data-talk-index="@index">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@(message.IsAnswer ? "Loremaster" : "You")</MudText>
                <div class="nornis-prep-talk-text">@(message.Prose ?? message.Content)</div>
                @if (message.IsAnswer && message.WebResearch is { } research)
                {
                    @* Feature 40: the pages the answer drew on, never copied into the adventure. *@
                    <div class="nornis-prep-talk-web">
                        @if (research.Pages.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="nornis-prep-talk-web-none">Searched the web; no pages cited.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">From the web</MudText>
                            <ul class="nornis-prep-talk-web-pages">
                                @foreach (var webPage in research.Pages)
                                {
                                    <li><a href="@webPage.Url" target="_blank" rel="noopener noreferrer nofollow">@webPage.Title</a></li>
                                }
                            </ul>
                        }
                        @if (research.SuggestionsHtml is { } suggestions)
                        {
                            @* The provider's own search suggestions, which its terms ask to be shown (Gemini).
                               Sandboxed without allow-scripts or allow-same-origin, so nothing in it runs
                               or reaches Nornis's page; its links open in a new tab. *@
                            <iframe class="nornis-prep-talk-web-suggestions" title="Search suggestions"
                                    sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"
                                    srcdoc="@SuggestionsDocument(suggestions)"></iframe>
                        }
                    </div>
                }
                @if (message.IsAnswer && message.EditsWereApplied && message.Edits is { Count: > 0 } written)
                {
                    @* Feature 41: the server put this answer's edits into the draft as it ended. *@
                    <div class="nornis-prep-talk-wrote">
                        <MudText Typo="Typo.caption" Color="@(AppliedCount(message) > 0 ? Color.Success : Color.Warning)" Class="nornis-prep-talk-wrote-summary">
                            @WroteSummary(message)
                        </MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Class="nornis-prep-talk-show-changes"
                                   OnClick="() => ToggleChanges(message.Id)">
                            @(_showingChanges.Contains(message.Id) ? "Hide changes" : "Show changes")
                        </MudButton>
                    </div>
                }
                @if (message.IsAnswer && message.Edits is { Count: > 0 } edits)
                {
                    @foreach (var (edit, editIndex) in edits.Select((e, i) => (e, i)))
                    {
                        var at = editIndex;
                        var applied = _applied.Contains((message.Id, at)) || message.IsApplied(at);
                        if (message.EditsWereApplied && applied && !_showingChanges.Contains(message.Id))
                        {
                            continue;
                        }
                        <div class="nornis-prep-edit">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="nornis-prep-edit-label">@EditLabel(message, applied) @(edits.Count > 1 ? $"{at + 1} of {edits.Count}" : "")</MudText>
                            <div class="nornis-prep-edit-before">@(edit.Find.Length == 0 ? "(the empty draft)" : edit.Find)</div>
                            <div class="nornis-prep-edit-after">@(edit.Replace.Length == 0 ? "(taken out)" : edit.Replace)</div>
                            @if (applied)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="nornis-prep-edit-applied">@(message.IsApplied(at) && message.EditsWereApplied ? "In the draft. Undo on the draft takes it back." : "Applied. Undo on the draft takes it back.")</MudText>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="nornis-prep-edit-apply"
                                           StartIcon="@Icons.Material.Outlined.Check" Disabled="@(_streaming || _applying || !DraftMode || ApplyEdit is null)"
                                           OnClick="() => ApplyAsync(message, at)">
                                    Apply
                                </MudButton>
                                @if (!DraftMode)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Open the Design tab to apply it.</MudText>
                                }
                            }
                        </div>
                    }
                }
                @if (message.IsAnswer && DraftMode && !message.EditsWereApplied)
                {
                    <MudMenu Label="Put in draft" StartIcon="@Icons.Material.Outlined.PostAdd" Variant="Variant.Text" Size="Size.Small"
                             Color="Color.Primary" Dense="true" Class="nornis-prep-talk-put-draft" Disabled="@(_streaming || PutInDraft is null)">
                        <MudMenuItem OnClick="() => PutInDraftAsync(message, PutInSectionRequest.Append)">Add to the end of the draft</MudMenuItem>
                        <MudMenuItem OnClick="() => PutInDraftAsync(message, PutInSectionRequest.Replace)">Replace the whole draft</MudMenuItem>
                    </MudMenu>
                }
                else if (message.IsAnswer)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="nornis-prep-talk-put"
                               StartIcon="@Icons.Material.Outlined.PostAdd" Disabled="@(_streaming || Sections.Count == 0)"
                               OnClick="() => PutAsync(message)">
                        Put in section
                    </MudButton>
                }
                else if (!_streaming && (index == _messages.Count - 1 || !_messages[index + 1].IsAnswer))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="nornis-prep-talk-unanswered">
                        No answer was saved. Send it again to ask once more.
                    </MudText>
                }
            </div>
        }

        @if (_streaming)
        {
            <div class="nornis-prep-talk-message nornis-prep-talk-answer nornis-prep-talk-streaming">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Loremaster</MudText>
                <div class="nornis-prep-talk-text">@(_answer is { Length: > 0 } ? _answer : _writingDraft ? "" : _researching ? "Searching the web…" : "Thinking…")</div>
                @if (_writingDraft)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="nornis-prep-talk-writing">Writing into the draft…</MudText>
                }
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <AiErrorAlert Error="_error" OtherSeverity="Severity.Warning" Class="mt-2 nornis-prep-talk-error" />
    }

    @if (_isFull)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2 nornis-prep-talk-full">
            This conversation is as long as one can be. Clear it to start again; the adventure keeps
            everything you put in.
        </MudAlert>
    }
    else
    {
        @* data-submit-on-enter: nornis-compose.js stops Enter typing a newline here, and
           OnInputKeyDown sends instead. Shift+Enter still makes a new line. *@
        <div data-submit-on-enter>
            <MudTextField @bind-Value="_text" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 nornis-prep-talk-input"
                          Label="Ask, or ask it to write something" Lines="3" MaxLength="@MaxMessageChars" Immediate="true"
                          HelperText="Enter to send, Shift+Enter for a new line"
                          OnKeyDown="OnInputKeyDown" Disabled="@_streaming" />
        </div>
        <div class="d-flex gap-2 mt-2 align-center">
            @if (_streaming)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Stop" OnClick="Stop" Class="nornis-prep-talk-stop">
                    Stop
                </MudButton>
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else
            {
                @* Feature 40: off for every turn, and off again after each send, so every search is a choice. *@
                <MudSwitch T="bool" @bind-Value="_webResearch" Color="Color.Primary" Class="nornis-prep-talk-research"
                           Label="Web research" Disabled="@(_researchUnavailable is not null)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send"
                           Class="nornis-prep-talk-send" Disabled="@string.IsNullOrWhiteSpace(_text)" OnClick="SendAsync">
                    Send
                </MudButton>
            }
        </div>
        @if (!_streaming && _researchUnavailable is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="nornis-prep-talk-research-reason">@_researchUnavailable</MudText>
        }
    }
</MudPaper>

@code {
    /// <summary>The longest message the API takes. Mirrors <c>PrepOptions.MaxConversationMessageChars</c>; pinned by a test.</summary>
    public const int MaxMessageChars = 4_000;

    [Parameter] public Guid WorldId { get; set; }
    [Parameter] public Guid AdventureId { get; set; }
    [Parameter] public IReadOnlyList<AdventureSectionDto> Sections { get; set; } = [];

    /// <summary>The section open in the editor: sent with each message as context, and offered first by Put in section.</summary>
    [Parameter] public Guid? SelectedSectionId { get; set; }

    /// <summary>Writes the answer into the chosen section. The page saves the editor first and reports the outcome.</summary>
    [Parameter] public Func<ConversationMessageDto, PutInSectionChoice, Task>? PutInSection { get; set; }

    /// <summary>
    /// Design mode (feature 37): each message is sent with the whole draft instead of the open
    /// section, answers' suggested edits can be applied, and Put in draft replaces Put in section.
    /// </summary>
    [Parameter] public bool DraftMode { get; set; }

    /// <summary>Applies the answer's edit at the index. The page saves the editor first; true when it was applied.</summary>
    [Parameter] public Func<ConversationMessageDto, int, Task<bool>>? ApplyEdit { get; set; }

    /// <summary>Puts the whole answer into the draft, Replace or Append.</summary>
    [Parameter] public Func<ConversationMessageDto, string, Task>? PutInDraft { get; set; }

    /// <summary>
    /// Runs before a Design turn is sent (feature 41): the page saves what was typed in the draft,
    /// so the turn sees it and its edits land on it. False keeps the message unsent.
    /// </summary>
    [Parameter] public Func<Task<bool>>? BeforeSend { get; set; }

    /// <summary>True as a turn starts and false as it ends, so the page can hold the draft still meanwhile.</summary>
    [Parameter] public EventCallback<bool> OnTurnRunning { get; set; }

    /// <summary>A Design turn's edits landed in the draft (feature 41): the page shows the new draft.</summary>
    [Parameter] public EventCallback OnDraftEdited { get; set; }

    /// <summary>Answers whose applied edits are shown, from Show changes.</summary>
    private readonly HashSet<Guid> _showingChanges = [];
    private ElementReference _list;
    private bool _writingDraft;

    private readonly HashSet<(Guid MessageId, int Index)> _applied = [];
    private bool _applying;

    private List<ConversationMessageDto> _messages = [];
    private bool _isFull;
    private string? _loadError;
    private ApiError? _error;
    private string _text = string.Empty;
    private bool _streaming;
    private string? _answer;
    private CancellationTokenSource? _cts;
    private Guid _loadedFor;
    private bool _webResearch;
    private bool _researching;

    /// <summary>Why the switch is off, as the API says; null when a turn can search.</summary>
    private string? _researchUnavailable = "Web research isn't available right now.";

    protected override async Task OnParametersSetAsync()
    {
        if (AdventureId != _loadedFor)
        {
            _loadedFor = AdventureId;
            _applied.Clear();
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        var result = await Api.GetAdventureConversationAsync(WorldId, AdventureId);
        if (result.IsSuccess)
        {
            _messages = result.Value!.Messages.ToList();
            _isFull = result.Value.IsFull;
            _researchUnavailable = result.Value.WebResearch switch
            {
                { Available: true } => null,
                { Reason: { } reason } => reason,
                _ => "Web research isn't available right now.",
            };
            _webResearch &= _researchUnavailable is null;
            _loadError = null;
        }
        else
        {
            _loadError = result.Error!.Message;
        }
    }

    /// <summary>
    /// Enter on its own sends; with Shift (or another modifier) it is the textarea's own newline.
    /// Mirrors <c>nornisCompose.sendsOnEnter</c> in nornis-compose.js, which stops the newline in
    /// the browser: no compiler spans the two, so <c>SubmitOnEnterMirrorTests</c> holds them together.
    /// </summary>
    internal static bool SendsOnEnter(KeyboardEventArgs e) =>
        e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey && !e.AltKey && !e.MetaKey && !e.IsComposing;

    private Task OnInputKeyDown(KeyboardEventArgs e) => SendsOnEnter(e) ? SendAsync() : Task.CompletedTask;

    private async Task SendAsync()
    {
        var text = _text.Trim();
        if (text.Length == 0 || _streaming)
        {
            return;
        }

        var onDraft = DraftMode;
        if (onDraft && BeforeSend is not null && !await BeforeSend())
        {
            return;
        }

        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _streaming = true;
        _answer = string.Empty;
        _error = null;
        _researching = _webResearch && _researchUnavailable is null;
        _webResearch = false;
        _writingDraft = false;
        var draftEdited = false;
        // Shown at once; the reload after the turn replaces it with the saved copy.
        _messages.Add(new ConversationMessageDto(Guid.Empty, ConversationMessageDto.UserRole, text, null, DateTimeOffset.UtcNow));
        var asked = _messages.Count - 1;
        _text = string.Empty;
        await OnTurnRunning.InvokeAsync(true);
        StateHasChanged();
        await ScrollToAsync(asked);
        try
        {
            await foreach (var e in Api.StreamAdventureConversationAsync(WorldId, AdventureId,
                               onDraft
                                   ? new SendConversationMessageRequest(text, null, SendConversationMessageRequest.DraftScope, _researching)
                                   : new SendConversationMessageRequest(text, SelectedSectionId, WebResearch: _researching), _cts.Token))
            {
                switch (e)
                {
                    case ConversationStreamEvent.Delta delta:
                        _answer += delta.Text;
                        StateHasChanged();
                        break;
                    case ConversationStreamEvent.WritingDraft:
                        _writingDraft = true;
                        StateHasChanged();
                        break;
                    case ConversationStreamEvent.Done done:
                        draftEdited = done.Answer.DraftEditOutcomes?.Contains(ConversationMessageDto.AppliedOutcome) == true;
                        break;
                    case ConversationStreamEvent.Failed failed:
                        _error = failed.Error;
                        break;
                }
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            _error = new ApiError("stopped", "Stopped. The answer wasn't saved.");
        }
        finally
        {
            _streaming = false;
            _researching = false;
            _writingDraft = false;
            _answer = null;
            await ReloadAsync();
            if (draftEdited)
            {
                await OnDraftEdited.InvokeAsync();
            }

            await OnTurnRunning.InvokeAsync(false);
            StateHasChanged();
            await ScrollToAsync(asked);
        }
    }

    /// <summary>
    /// Puts the GM's message at the top of the list, so a long answer reads down from the
    /// question rather than leaving the GM at its end (feature 41). Nothing follows the answer
    /// as it grows. A browser that can't (a prerender, a test) keeps its scroll.
    /// </summary>
    private async Task ScrollToAsync(int index)
    {
        try
        {
            await JS.InvokeVoidAsync("nornisCompose.scrollToMessage", _list, index);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// What an edit card is: a suggestion the GM may apply, or (feature 41) a change the server
    /// already made, or one it couldn't make, so an applied change never reads as a suggestion.
    /// </summary>
    private static string EditLabel(ConversationMessageDto message, bool applied) =>
        !message.EditsWereApplied ? "Suggested edit" : applied ? "Change" : "Change not made";

    private void ToggleChanges(Guid messageId)
    {
        if (!_showingChanges.Remove(messageId))
        {
            _showingChanges.Add(messageId);
        }
    }

    private int AppliedCount(ConversationMessageDto message) =>
        Enumerable.Range(0, message.Edits?.Count ?? 0).Count(i => message.IsApplied(i) || _applied.Contains((message.Id, i)));

    /// <summary>What the answer did to the draft, in a line: the edits' text is behind Show changes.</summary>
    private string WroteSummary(ConversationMessageDto message)
    {
        var total = message.Edits?.Count ?? 0;
        var applied = AppliedCount(message);
        if (applied == total)
        {
            return total == 1
                ? "Changed the draft. Undo on the draft takes it back."
                : $"Changed the draft ({total} edits). Undo on the draft takes it back.";
        }

        if (applied > 0)
        {
            return $"Changed the draft ({applied} of {total} edits). The rest didn't fit the draft; apply them below if you still want them.";
        }

        return message.DraftEditOutcomes?.Contains(ConversationMessageDto.NotAppliedOutcome) == true
            ? "The draft changed while this was written, so nothing was applied. Apply the edits below if you still want them."
            : "None of these edits fit the draft as it is now, so nothing changed.";
    }

    private void Stop() => _cts?.Cancel();

    /// <summary>
    /// The suggestions as the sandboxed frame's whole document: the provider's markup as it sent
    /// it, after a base that opens every link in a new tab, since the frame may not navigate itself
    /// to a search page that refuses to be framed.
    /// </summary>
    internal static string SuggestionsDocument(string suggestionsHtml) =>
        "<!doctype html><html><head><meta charset=\"utf-8\"><base target=\"_blank\"></head><body style=\"margin:0\">"
        + suggestionsHtml + "</body></html>";

    private async Task ClearAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Clear the conversation?",
            "Every message goes. The adventure and anything you put in it stay as they are.",
            yesText: "Clear", cancelText: "Keep it");
        if (confirmed != true)
        {
            return;
        }

        var result = await Api.ClearAdventureConversationAsync(WorldId, AdventureId);
        _error = result.IsSuccess ? null : result.Error;
        await ReloadAsync();
    }

    private async Task ApplyAsync(ConversationMessageDto message, int index)
    {
        if (ApplyEdit is null)
        {
            return;
        }

        _applying = true;
        try
        {
            if (await ApplyEdit(message, index))
            {
                _applied.Add((message.Id, index));
            }
        }
        finally
        {
            _applying = false;
        }
    }

    private async Task PutInDraftAsync(ConversationMessageDto message, string mode)
    {
        if (PutInDraft is not null)
        {
            await PutInDraft(message, mode);
        }
    }

    private async Task PutAsync(ConversationMessageDto message)
    {
        if (PutInSection is null)
        {
            return;
        }

        var parameters = new DialogParameters<PutInSectionDialog>
        {
            { d => d.Sections, Sections },
            { d => d.DefaultSectionId, SelectedSectionId },
        };
        var dialog = await DialogService.ShowAsync<PutInSectionDialog>("Put in section", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: PutInSectionChoice choice })
        {
            await PutInSection(message, choice);
        }
    }
}
