@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@* The world's members with the GM's controls. Lifted whole from WorldSettingsPanel on
   2026-09-09 so the Members page could exist without a second copy. Every member may read
   it; only the GM sees the role select, the remove button and the add-member picker, and
   the API enforces the same gate regardless of what is rendered. *@

@if (_loadingMembers)
{
    <LoadingRows Rows="3" Height="48px" />
}
else if (_membersError is not null)
{
    <MudAlert Severity="Severity.Error">@_membersError</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
        @foreach (var m in _members)
        {
            <div class="nornis-member-row">
                <MudAvatar Color="Color.Primary" Size="Size.Small">@MemberDisplay.Initial(m)</MudAvatar>
                <div class="nornis-list-body">
                    <div class="nornis-list-title">@MemberDisplay.Name(m)</div>
                </div>
                @if (_isGm)
                {
                    var isMe = m.UserId == _myUserId;
                    @* The only GM cannot step down or leave: the API refuses both, so the page
                       does not offer them (3.32). With a second GM, your own row offers Leave. *@
                    var onlyGm = isMe && IsOnlyGm(m);
                    <MudSelect T="string" Value="m.Role" ValueChanged="(string r) => ChangeRoleAsync(m, r)"
                               Dense="true" Variant="Variant.Outlined" Class="nornis-role-select"
                               Disabled="@(onlyGm || _busyMembers.Contains(m.UserId))"
                               HelperText="@(onlyGm ? "A world keeps at least one GM." : null)">
                        @foreach (var role in _roles)
                        {
                            <MudSelectItem Value="@role">@MemberDisplay.RoleLabel(role)</MudSelectItem>
                        }
                    </MudSelect>
                    @if (!isMe)
                    {
                        <MudTooltip Text="@($"Remove {MemberDisplay.Name(m)} from this world")">
                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => RemoveAsync(m)" Disabled="@_busyMembers.Contains(m.UserId)" aria-label="Remove member" />
                        </MudTooltip>
                    }
                    else if (!onlyGm)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                   OnClick="() => LeaveAsync(m)" Disabled="@_busyMembers.Contains(m.UserId)">
                            Leave world
                        </MudButton>
                    }
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@MemberDisplay.RoleLabel(m.Role)</MudChip>
                }
            </div>
        }

        @if (_isGm)
        {
            <div class="nornis-add-member mt-3">
                <MudAutocomplete T="UserSummaryDto" @bind-Value="_newUser"
                                 SearchFunc="SearchAddableUsersAsync"
                                 ToStringFunc="@(u => u?.Username ?? string.Empty)"
                                 Label="Add member" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                 Placeholder="Search by username"
                                 HelperText="@_searchError"
                                 MinCharacters="2" DebounceInterval="200" MaxItems="10"
                                 Clearable="true" CoerceText="false" ResetValueOnEmptyText="true"
                                 Class="flex-grow-1" />
                <MudSelect T="string" @bind-Value="_newRole" Dense="true" Variant="Variant.Outlined" Class="nornis-role-select">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem Value="@role">@MemberDisplay.RoleLabel(role)</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="AddMemberAsync" Disabled="@(_addingMember || _newUser is null)">
                    Add
                </MudButton>
            </div>
            @if (_addError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_addError</MudAlert>
            }
        }
    </MudPaper>
}

@code {
    private readonly string[] _roles = [WorldRoles.Gm, WorldRoles.Player, WorldRoles.Observer];

    private bool _isGm => Worlds.IsGm;

    private bool _loadingMembers = true;
    private string? _membersError;
    private IReadOnlyList<WorldMember> _members = [];
    private readonly HashSet<Guid> _busyMembers = [];

    // Which row is the reader's own. Null until known (or if the lookup fails), and then every
    // row is treated as someone else's: the API still refuses what must not happen.
    private Guid? _myUserId;

    private bool IsOnlyGm(WorldMember member) =>
        member.Role == WorldRoles.Gm && _members.Count(x => x.Role == WorldRoles.Gm) == 1;

    private UserSummaryDto? _newUser;
    private string? _searchError;
    private string _newRole = "Player";
    private bool _addingMember;
    private string? _addError;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadMembersAsync();
    }

    private void OnWorldChanged() => InvokeAsync(async () =>
    {
        // The panel stays mounted across a world switch, so a candidate picked for the previous
        // world would otherwise still be sitting there — and Add would put them in this one.
        _newUser = null;
        _searchError = null;
        _addError = null;
        await LoadMembersAsync();
    });

    /// <summary>
    /// Candidates for the add-member picker. The server excludes existing members, requires a
    /// search term and caps the result, so this searches rather than filtering a directory the
    /// client downloaded — which is what stopped any authenticated caller from reading the whole
    /// user table in one request.
    /// </summary>
    private async Task<IEnumerable<UserSummaryDto>> SearchAddableUsersAsync(string value, CancellationToken ct)
    {
        _searchError = null;

        if (Worlds.Current is null)
        {
            return [];
        }

        var result = await Api.GetAddableUsersAsync(Worlds.Current.Id, value, ct);

        if (!result.IsSuccess)
        {
            // Returning an empty list on failure reads as "nobody by that name", which is a
            // different and much more misleading thing than "that did not work".
            _searchError = result.Error!.Message;
            return [];
        }

        return result.Value!;
    }

    private async Task LoadMembersAsync()
    {
        if (Worlds.Current is null)
        {
            _members = [];
            _loadingMembers = false;
            return;
        }

        _loadingMembers = true;
        _membersError = null;
        StateHasChanged();

        var mineTask = Api.GetMyMembershipAsync(Worlds.Current.Id);
        var result = await Api.GetMembersAsync(Worlds.Current.Id);
        _myUserId = (await mineTask) is { IsSuccess: true, Value: { } mine } ? mine.UserId : null;

        _loadingMembers = false;
        if (result.IsSuccess)
        {
            _members = result.Value!;
        }
        else
        {
            _membersError = result.Error!.Message;
            _members = [];
        }
        StateHasChanged();
    }

    private async Task ChangeRoleAsync(WorldMember member, string newRole)
    {
        if (newRole == member.Role)
        {
            return;
        }

        // A role applied the moment it was picked, with nothing to say what it would change;
        // a slip of the wheel over the select demoted someone. It asks first now (3.32).
        var isMe = member.UserId == _myUserId;
        var consequence = (member.Role, newRole) switch
        {
            (_, WorldRoles.Gm) => "They will see everything in this world, GM-only material included, and can change its settings.",
            (WorldRoles.Gm, _) when isMe => "You will lose the GM's pages and everything marked GM only, and only another GM can give them back.",
            (WorldRoles.Gm, _) => "They will lose the GM's pages and everything marked GM only.",
            (_, WorldRoles.Observer) => "They will be able to read what the party sees, and not add to it.",
            _ => "They will be able to add sources and review what theirs propose.",
        };
        var whose = isMe ? "your own role" : $"{MemberDisplay.Name(member)}'s role";
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Change {whose} to {MemberDisplay.RoleLabel(newRole)}?",
            consequence,
            yesText: "Change role", cancelText: "Cancel");
        if (confirmed != true)
        {
            StateHasChanged(); // the select snaps back to the role that still stands
            return;
        }

        _busyMembers.Add(member.UserId);
        var result = await Api.UpdateMemberRoleAsync(Worlds.Current!.Id, member.UserId, newRole);
        _busyMembers.Remove(member.UserId);

        if (result.IsSuccess)
        {
            _members = _members.Select(x => x.UserId == member.UserId ? x with { Role = newRole } : x).ToList();
            Snackbar.Add($"Role updated to {MemberDisplay.RoleLabel(newRole)}.", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
        StateHasChanged();
    }

    /// <summary>A GM leaving a world that keeps another GM. The list they were reading is no longer theirs.</summary>
    private async Task LeaveAsync(WorldMember me)
    {
        var world = Worlds.Current!;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Leave {world.Name}?",
            "You will lose access to this world until someone invites you back. The world and everything in it stays.",
            yesText: "Leave world", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busyMembers.Add(me.UserId);
        var result = await Api.RemoveMemberAsync(world.Id, me.UserId);
        _busyMembers.Remove(me.UserId);

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            StateHasChanged();
            return;
        }

        Snackbar.Add($"You left {world.Name}.", Severity.Info);
        await Worlds.ReloadAsync();
        Nav.NavigateTo("/dashboard");
    }

    private async Task RemoveAsync(WorldMember member)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove member?",
            $"Remove {MemberDisplay.Name(member)} from this world?",
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busyMembers.Add(member.UserId);
        var result = await Api.RemoveMemberAsync(Worlds.Current!.Id, member.UserId);
        _busyMembers.Remove(member.UserId);

        if (result.IsSuccess)
        {
            _members = _members.Where(x => x.UserId != member.UserId).ToList();
            Snackbar.Add("Member removed.", Severity.Info);
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task AddMemberAsync()
    {
        _addError = null;

        if (_newUser is null)
        {
            return;
        }

        _addingMember = true;
        var result = await Api.AddMemberAsync(Worlds.Current!.Id, new AddMemberRequest(_newUser.Id, _newRole));
        _addingMember = false;

        if (result.IsSuccess)
        {
            _members = _members.Append(result.Value!).ToList();
            _newUser = null;
            Snackbar.Add("Member added.", Severity.Success);
        }
        else
        {
            _addError = result.Error!.Message;
        }
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
