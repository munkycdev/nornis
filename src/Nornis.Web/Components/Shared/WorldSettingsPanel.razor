@inject WorldState Worlds
@inject NornisApiClient Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* One group of the world's settings as a card with its own Save (Nornis 3.23). The Settings page
   owns the form, so what was typed on a tab survives moving to another; this card sends only its
   own section, and the API leaves every other field as it is. GM-only: the page shows it to no one
   else, and the API refuses the update to anyone below GM regardless. *@

<MudPaper Elevation="0" Class="@($"nornis-card nornis-card-pad nornis-settings-card nornis-settings-{Section.ToString().ToLowerInvariant()} {Class}")">
    @switch (Section)
    {
        case WorldSettingsSection.World:
            <div class="nornis-detail-section-title">World</div>
            <MudTextField @bind-Value="Form.Name" Label="Name" Required="true" Immediate="true"
                          MaxLength="200" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="Form.Description" Label="Description" Lines="3"
                          Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="Form.GameSystem" Label="Game system" Placeholder="e.g. D&D 5e"
                          Variant="Variant.Outlined" Class="mb-3" />
            break;

        case WorldSettingsSection.PublicPage:
            <div class="nornis-detail-section-title">Public page</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Share this world's party-visible knowledge (codex, timeline and sessions) with anyone
                through a read-only link. GM-only and private material never appears.
            </MudText>
            <MudTextField @bind-Value="Form.PublicSlug" Label="Public URL slug" Immediate="true"
                          Placeholder="@SuggestedSlug" MaxLength="60"
                          HelperText="Lowercase letters, digits, and hyphens (3–60 characters)."
                          Variant="Variant.Outlined" Class="mb-2"
                          Adornment="Adornment.Start" AdornmentText="nornis.app/w/" />
            <div class="d-flex align-center flex-wrap gap-3 mb-3">
                <MudSwitch T="bool" @bind-Value="Form.PublicAccessEnabled" Color="Color.Secondary"
                           Label="Publicly accessible" Disabled="@(string.IsNullOrWhiteSpace(Form.PublicSlug))" />
                @if (Form.PublicAccessEnabled && !string.IsNullOrWhiteSpace(Form.PublicSlug))
                {
                    <MudTooltip Text="Copy public link">
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                       OnClick="CopyPublicLinkAsync" aria-label="Copy public link" />
                    </MudTooltip>
                    <a href="@PublicUrl" target="_blank" rel="noopener" class="nornis-link">@PublicUrl</a>
                }
            </div>
            <MudNumericField T="decimal?" @bind-Value="Form.PublicAskMonthlyBudget" Label="Public Ask budget (USD / month)"
                             Placeholder="off" Min="0.01m" Max="1000m" Step="1m"
                             HelperText="Let visitors to the public page Ask the Loremaster, capped at this AI spend per calendar month. Leave empty to keep public questions off."
                             Variant="Variant.Outlined" Class="mb-3" />
            break;

        case WorldSettingsSection.Budgets:
            <div class="nornis-detail-section-title">Budgets</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                The most this world's AI may spend. The public Ask budget is on the Public page tab.
            </MudText>
            <MudNumericField T="decimal?" @bind-Value="Form.DailyAiBudget" Label="Daily AI budget (USD)"
                             Placeholder="server default" Min="0.01m" Max="100m" Step="0.5m"
                             HelperText="Cap on this world's AI spend per day (extraction, Loremaster, audits). Leave empty to use the server default."
                             Variant="Variant.Outlined" Class="mb-3" />
            @* Prep's own pool (feature 29): drafting never spends the daily budget above. *@
            <MudNumericField T="decimal?" @bind-Value="Form.PrepMonthlyBudget" Label="Prep budget (USD / month)"
                             Placeholder="default" Min="0.01m" Max="1000m" Step="1m"
                             HelperText="The most AI drafting in Prep may spend each calendar month. Separate from the daily budget, so prep never holds up extraction. Leave empty for the default."
                             Variant="Variant.Outlined" Class="mb-3" />
            break;

        case WorldSettingsSection.Review:
            <div class="nornis-detail-section-title">Summary updates</div>
            <MudSwitch T="bool" @bind-Value="Form.SummaryReviewRequired" Color="Color.Secondary"
                       Label="Review summary updates" Class="mb-1" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                After you accept changes, Nornis refreshes the affected artifacts' summaries
                automatically. Turn this on to route those refreshed summaries through the
                review queue instead.
            </MudText>
            break;

        case WorldSettingsSection.Template:
            <div class="nornis-detail-section-title">Template master</div>
            <MudSwitch T="bool" @bind-Value="Form.IsTemplate" Color="Color.Secondary"
                       Label="Template master" Class="mb-1" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                Marks this world as a hand-authored master you export as a template. It moves
                into a separate "Templates" group at the bottom of the world switcher: still
                selectable, just out of the way of the worlds you actually play in.
            </MudText>
            break;
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
               Class="nornis-settings-save">
        Save
    </MudButton>
</MudPaper>

@code {
    /// <summary>The page's form, shared by every card on it.</summary>
    [Parameter, EditorRequired] public WorldSettingsForm Form { get; set; } = null!;

    [Parameter, EditorRequired] public WorldSettingsSection Section { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool _saving;
    private string? _error;

    private string SuggestedSlug =>
        new string(Form.Name.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-') is { Length: > 0 } slug
            ? slug
            : "my-world";

    private string PublicUrl => $"https://nornis.app/w/{Form.PublicSlug?.Trim().ToLowerInvariant()}";

    private async Task CopyPublicLinkAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", PublicUrl);
        Snackbar.Add("Public link copied.", Severity.Info);
    }

    private async Task SaveAsync()
    {
        _error = Form.Problem(Section);
        if (_error is not null)
        {
            return;
        }

        _saving = true;
        var result = await Api.UpdateWorldAsync(Form.WorldId, Form.RequestFor(Section));
        _saving = false;

        if (!result.IsSuccess)
        {
            _error = result.Error!.Message;
            return;
        }

        await Worlds.ReloadAsync(); // the sidebar's name, the switcher's Templates group, the hero's public line
        Snackbar.Add("Saved.", Severity.Success);
    }
}
