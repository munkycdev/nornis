@implements IDisposable
@inject WorldState Worlds
@inject NornisApiClient Api
@inject ISnackbar Snackbar

@* The world's campaigns, current one first. Lifted whole from WorldSettingsPanel on
   2026-09-09 so the Campaigns page could exist without a second copy. On 2026-09-10 the
   editing moved to each campaign's own page, where the rest of the app edits things; what
   stays here is what only makes sense over the whole list — the GM's order — and creation,
   which has no page to live on yet. *@

@if (_loadingCampaigns)
{
    <LoadingRows Rows="2" Height="48px" />
}
else if (_campaignsError is not null)
{
    <MudAlert Severity="Severity.Error">@_campaignsError</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="nornis-card nornis-card-pad">
        @if (_campaigns.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">No campaigns yet.</MudText>
        }
        @for (var i = 0; i < _campaigns.Count; i++)
        {
            var c = _campaigns[i];
            var index = i;
            var isCurrent = Worlds.Current?.CurrentCampaignId == c.Id;
            <div class="nornis-member-row">
                @* Move buttons rather than drag: this list is keyboard-reachable, and
                   the reorder is a whole-world write either way. *@
                @if (_isGm && _campaigns.Count > 1)
                {
                    <div class="d-flex flex-column">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                                       Disabled="@(index == 0 || _reordering)"
                                       OnClick="() => MoveCampaignAsync(index, -1)"
                                       aria-label="@($"Move {c.Name} up")" />
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                                       Disabled="@(index == _campaigns.Count - 1 || _reordering)"
                                       OnClick="() => MoveCampaignAsync(index, 1)"
                                       aria-label="@($"Move {c.Name} down")" />
                    </div>
                }
                <div class="nornis-list-body">
                    <div class="nornis-list-title">
                        <a href="@Links.Campaign(c.Slug, c.Id)" class="nornis-link">@c.Name</a>
                        @if (isCurrent)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="ml-1">Playing now</MudChip>
                        }
                    </div>
                    <div class="nornis-list-sub">
                        @CampaignDates(c)
                        @if (CampaignCharacterNames(c) is { Length: > 0 } names)
                        {
                            <span> · @names</span>
                        }
                    </div>
                </div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@(c.Status == "Active" ? Color.Success : Color.Default)">@c.Status</MudChip>
            </div>
        }

        @if (_isGm)
        {
            <div class="nornis-add-member mt-3">
                <MudTextField @bind-Value="_newCampaignName" Label="New campaign name" MaxLength="200"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddCampaignAsync" Disabled="_addingCampaign">
                    Add
                </MudButton>
            </div>
            @if (_addCampaignError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_addCampaignError</MudAlert>
            }
        }
    </MudPaper>
}

@code {
    private bool _isGm => Worlds.IsGm;

    private bool _loadingCampaigns = true;
    private string? _campaignsError;
    private IReadOnlyList<CampaignDto> _campaigns = [];
    private bool _reordering;
    private string _newCampaignName = string.Empty;
    private bool _addingCampaign;
    private string? _addCampaignError;

    // Loaded only so each row can say who plays in it; the cast is edited on the campaign's page.
    private IReadOnlyList<CharacterDto> _characters = [];

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldChanged;
        await Worlds.EnsureLoadedAsync();
        await LoadCampaignsAndCharactersAsync();
    }

    private void OnWorldChanged() => InvokeAsync(LoadCampaignsAndCharactersAsync);

    private async Task LoadCampaignsAndCharactersAsync()
    {
        if (Worlds.Current is null)
        {
            _campaigns = [];
            _characters = [];
            _loadingCampaigns = false;
            return;
        }

        _loadingCampaigns = true;
        _campaignsError = null;
        StateHasChanged();

        var campaignsTask = Api.GetCampaignsAsync(Worlds.Current.Id);
        var charactersTask = Api.GetCharactersAsync(Worlds.Current.Id);
        var campaigns = await campaignsTask;
        var characters = await charactersTask;

        _loadingCampaigns = false;
        if (campaigns.IsSuccess)
        {
            // The one the world is playing now leads; the rest keep the GM's order.
            var current = Worlds.Current.CurrentCampaignId;
            _campaigns = campaigns.Value!
                .OrderBy(c => c.Id == current ? 0 : 1)
                .ToList();
        }
        else
        {
            _campaignsError = campaigns.Error!.Message;
            _campaigns = [];
        }

        // Character names decorate the list; a failure just hides them.
        _characters = characters.IsSuccess ? characters.Value! : [];
        StateHasChanged();
    }

    private string CampaignDates(CampaignDto c)
    {
        var start = c.StartedAt?.ToString("MMM yyyy");
        var end = c.EndedAt?.ToString("MMM yyyy");
        return (start, end) switch
        {
            (null, null) => "No dates set",
            (not null, null) => $"Since {start}",
            (null, not null) => $"Until {end}",
            _ => $"{start} – {end}"
        };
    }

    private string CampaignCharacterNames(CampaignDto c) =>
        string.Join(", ", _characters.Where(ch => ch.CampaignIds.Contains(c.Id)).Select(ch => ch.Name));

    /// <summary>
    /// Moves one campaign a step and sends the whole resulting order. The server rewrites
    /// every position in the world, so sending the list is not wasteful — it is the unit the
    /// write actually operates on. The current-campaign-first display order is a read-time
    /// presentation; what is sent is the GM's order as the server holds it.
    /// </summary>
    private async Task MoveCampaignAsync(int index, int delta)
    {
        var target = index + delta;
        if (Worlds.Current is null || target < 0 || target >= _campaigns.Count)
        {
            return;
        }

        var reordered = _campaigns.ToList();
        (reordered[index], reordered[target]) = (reordered[target], reordered[index]);

        // Optimistic: the list redraws under the cursor immediately, and a failure below
        // replaces it with whatever the server actually holds.
        _campaigns = reordered;
        _reordering = true;

        var result = await Api.ReorderCampaignsAsync(Worlds.Current.Id, reordered.Select(c => c.Id).ToList());
        _reordering = false;

        if (result.IsSuccess)
        {
            _campaigns = result.Value!;
        }
        else
        {
            Snackbar.Add(result.Error!.Message, Severity.Error);
            await LoadCampaignsAndCharactersAsync();
        }

        StateHasChanged();
    }

    private async Task AddCampaignAsync()
    {
        _addCampaignError = null;
        if (string.IsNullOrWhiteSpace(_newCampaignName))
        {
            _addCampaignError = "Enter a campaign name.";
            return;
        }

        _addingCampaign = true;
        var result = await Api.CreateCampaignAsync(Worlds.Current!.Id, new CreateCampaignRequest(_newCampaignName.Trim()));
        _addingCampaign = false;

        if (result.IsSuccess)
        {
            // Last, matching where the repository positions it — prepending here would show
            // an order the next load contradicts.
            _campaigns = _campaigns.Append(result.Value!).ToList();
            _newCampaignName = string.Empty;
            Snackbar.Add("Campaign created.", Severity.Success);
        }
        else
        {
            _addCampaignError = result.Error!.Message;
        }
        StateHasChanged();
    }

    public void Dispose() => Worlds.Changed -= OnWorldChanged;
}
