@inject NornisApiClient Api

@* Type-to-confirm guard for the unrecoverable world wipe. The Delete button stays
   disabled until the typed name matches exactly; the API re-verifies server-side. *@

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
            This permanently deletes <b>@WorldName</b> and everything in it — sessions, codex,
            timeline, campaigns, characters, library files, members, and invite links.
            There is no archive and no way to get it back.
        </MudAlert>
        <MudText Typo="Typo.body2" Class="mb-2">
            Type <b>@WorldName</b> to confirm.
        </MudText>
        <MudTextField @bind-Value="_typedName"
                      Label="World name"
                      Immediate="true"
                      MaxLength="200"
                      Variant="Variant.Outlined"
                      Disabled="_busy" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@(_busy ? null : Icons.Material.Filled.DeleteForever)"
                   OnClick="DeleteAsync" Disabled="@(!NameMatches || _busy)">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <span>Deleting world…</span>
            }
            else
            {
                <span>Delete this world forever</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid WorldId { get; set; }
    [Parameter] public string WorldName { get; set; } = string.Empty;

    private string _typedName = string.Empty;
    private bool _busy;
    private string? _error;

    // Case-sensitive on purpose — this gate protects an unrecoverable action.
    private bool NameMatches => string.Equals(_typedName.Trim(), WorldName, StringComparison.Ordinal);

    private async Task DeleteAsync()
    {
        if (!NameMatches)
        {
            return;
        }

        _busy = true;
        _error = null;
        // The wipe can take a while and can't be canceled client-side once requested —
        // lock the dialog (no backdrop click, no Esc) so it can't be dismissed mid-delete.
        await MudDialog.SetOptionsAsync(MudDialog.Options with { BackdropClick = false, CloseOnEscapeKey = false });

        var result = await Api.DeleteWorldAsync(WorldId, _typedName.Trim());

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error!.Message;
            await MudDialog.SetOptionsAsync(MudDialog.Options with { BackdropClick = true, CloseOnEscapeKey = true });
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
