@implements IDisposable
@using Nornis.Web.Navigation
@using Nornis.Web.Services
@inject WorldState Worlds
@inject NornisApiClient Api
@inject Nornis.Web.State.AuthSessionState AuthSession
@inject OnboardingState Onboarding
@inject QuickSwitcherState Switcher
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS

@* The demo-world tutorial checklist (feature 20 phase C; re-cut for the grouped sidebar on
   2026-09-10). Two chapters — playing, then running — completed in any order, detected from
   real state wherever the server has state to look at. What each step is called and where it
   is done comes from TutorialGuide, which reads the "where" off the sidebar's own data. Fully
   cancellable: Dismiss removes it permanently for this user. *@

@if (Visible)
{
    <div class="nornis-tutorial @(_collapsed ? "nornis-tutorial-collapsed" : null)">
        <div class="nornis-tutorial-head" @onclick="ToggleCollapsed">
            <MudIcon Icon="@(AllDone ? Icons.Material.Filled.Celebration : Icons.Material.Outlined.School)"
                     Size="Size.Small" />
            <span class="nornis-tutorial-title">
                @(AllDone ? "Tutorial complete!" : $"Getting started · {DoneCount} of {_steps.Count}")
            </span>
            @* MudBlazor buttons swallow the click rather than letting the head's handler
               see it, so the chevron needs its own toggle. The wrapper keeps the two from
               firing in sequence and cancelling each other out. *@
            <span @onclick:stopPropagation="true">
                <MudIconButton Icon="@(_collapsed ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small" OnClick="ToggleCollapsed"
                               aria-label="@(_collapsed ? "Expand tutorial" : "Collapse tutorial")" />
            </span>
            <span @onclick:stopPropagation="true">
                <MudTooltip Text="Dismiss the tutorial for good">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   OnClick="DismissAsync"
                                   aria-label="Dismiss tutorial" />
                </MudTooltip>
            </span>
        </div>

        @if (!_collapsed)
        {
            <div class="nornis-tutorial-body">
                @foreach (var chapter in new[] { 1, 2 })
                {
                    <div class="nornis-tutorial-chapter">
                        @(chapter == 1 ? "Playing in a world" : "Running a campaign")
                    </div>
                    @foreach (var step in _steps.Where(s => s.Chapter == chapter))
                    {
                        var guide = TutorialGuide.Find(step.Key);
                        var done = step.CompletedAt is not null;
                        var door = guide is null ? null : TutorialGuide.Door(guide);
                        <div class="nornis-tutorial-step @(done ? "nornis-tutorial-step-done" : null)">
                            <MudIcon Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)"
                                     Size="Size.Small" />
                            <div class="flex-grow-1">
                                @if (guide?.Href is not null && !done)
                                {
                                    <a href="@guide.Href" class="nornis-tutorial-step-title">@guide.Title</a>
                                }
                                else
                                {
                                    <span class="nornis-tutorial-step-title">@(guide?.Title ?? step.Key)</span>
                                }
                                @if (!done && guide is not null)
                                {
                                    @* Where it is done, read from the sidebar's own data — never written here. *@
                                    @if (door is not null)
                                    {
                                        <div class="nornis-tutorial-where">
                                            <span>@door.Group.Label</span>
                                            <span aria-hidden="true">›</span>
                                            <span>@door.Item.Label</span>
                                        </div>
                                    }
                                    else if (guide.Trigger == TutorialTrigger.Jump)
                                    {
                                        <div class="nornis-tutorial-where">
                                            <kbd class="nornis-kbd">Ctrl K</kbd>
                                            <span>or the search box under the world name</span>
                                        </div>
                                    }
                                    <div class="nornis-tutorial-step-hint">@TutorialGuide.HintFor(guide)</div>
                                }
                                @if (step.Key == TutorialGuide.AddSessionSix && !done)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.ContentCopy"
                                               OnClick="CopySessionSixAsync" Disabled="_copyBusy"
                                               Class="pa-0">
                                        @(_copied ? "Copied!" : "Copy the Session 6 notes")
                                    </MudButton>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<TutorialStepDto> _steps = [];
    private bool _available;
    private bool _dismissed;
    private bool _collapsed;
    private bool _copyBusy;
    private bool _copied;
    private Guid? _loadedWorldId;
    private bool _lastViewingAsPlayer;
    private readonly CancellationTokenSource _cts = new();

    private bool Visible => _available && !_dismissed
        && Worlds.Current is { IsDemo: true, TutorialEnabled: true };

    private int DoneCount => _steps.Count(s => s.CompletedAt is not null);
    private bool AllDone => _steps.Count > 0 && DoneCount == _steps.Count;

    protected override async Task OnInitializedAsync()
    {
        Worlds.Changed += OnWorldsChanged;
        Nav.LocationChanged += OnLocationChanged;
        Switcher.Jumped += OnJumped;
        _lastViewingAsPlayer = Worlds.ViewingAsPlayer;

        // This component sits in MainLayout, outside its boot gate, so it renders during the
        // static prerender pass too — where the fetch and the poll timer below are both thrown
        // away with the render tree. See the matching guard in NavMenu.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var onboarding = await Onboarding.GetAsync(_cts.Token);
        _dismissed = onboarding is { IsSuccess: true, Value.TutorialDismissed: true };

        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        try
        {
            // Extraction and review happen in other tabs/pages; a light poll keeps the
            // state-detected steps moving without any page hooks.
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                // Stand down on an expired session — the nav owns surfacing it and probing
                // for recovery; this poll would only add to the 401s.
                if (Visible && !AllDone && !AuthSession.Expired)
                {
                    await RefreshAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
    }

    private async Task RefreshAsync()
    {
        if (_dismissed || Worlds.Current is not { IsDemo: true, TutorialEnabled: true } world)
        {
            _available = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var result = await Api.GetTutorialAsync(world.Id, _cts.Token);
        _available = result.IsSuccess;
        if (result.IsSuccess)
        {
            var firstLoadForWorld = _loadedWorldId != world.Id;
            Take(result.Value!.Steps, world.Id);
            if (firstLoadForWorld)
            {
                await ReportArrivalAsync(world.Id);
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    // A full page load fires no LocationChanged, so the page a person arrives on counts when the
    // checklist first loads for their world, or not at all — a bookmark to the Codex is as much a
    // visit as a click on it. This runs after the world is known: the component mounts outside
    // the layout's boot gate, before WorldState has loaded anything.
    private async Task ReportArrivalAsync(Guid worldId)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (TutorialGuide.StepAt(path, TutorialTrigger.Visit) is { } arrived)
        {
            await ReportAsync(worldId, arrived.Key);
        }

        await ReportLearnedAsPlayerAsync(worldId, path);
    }

    // A report and a refresh can be in flight together — jumping through the switcher fires the
    // report and the arrival's refresh a moment apart — and the server may answer the GET first.
    // Completion is one-way on the server, so a later answer that lacks a step this client has
    // already seen complete is the older answer; keep the completion. The list shape and order
    // still come from whatever arrived last, so a redeploy that changes the steps shows through.
    private void Take(IReadOnlyList<TutorialStepDto> incoming, Guid worldId)
    {
        if (_loadedWorldId == worldId)
        {
            var known = _steps.Where(s => s.CompletedAt is not null).ToDictionary(s => s.Key, s => s.CompletedAt);
            incoming = incoming
                .Select(s => s.CompletedAt is null && known.TryGetValue(s.Key, out var at) ? s with { CompletedAt = at } : s)
                .ToList();
        }

        _steps = incoming;
        _loadedWorldId = worldId;
    }

    private void OnWorldsChanged() => InvokeAsync(async () =>
    {
        var viewingAsPlayer = Worlds.ViewingAsPlayer;
        if (viewingAsPlayer != _lastViewingAsPlayer)
        {
            _lastViewingAsPlayer = viewingAsPlayer;
            await ReportViewToggleAsync(viewingAsPlayer);
        }

        if (Worlds.Current?.Id != _loadedWorldId)
        {
            await RefreshAsync();
        }

        StateHasChanged();
    });

    private async Task ReportViewToggleAsync(bool viewingAsPlayer)
    {
        if (!Visible || Worlds.Current is not { } world)
        {
            return;
        }

        if (viewingAsPlayer)
        {
            await ReportAsync(world.Id, TutorialGuide.SeeAsPlayer);
            // Already standing on What you learned when the view flips counts as opening it.
            await ReportLearnedAsPlayerAsync(world.Id, new Uri(Nav.Uri).AbsolutePath);
        }
        else if (Completed(TutorialGuide.SeeAsPlayer))
        {
            await ReportAsync(world.Id, TutorialGuide.BackToGm);
        }
    }

    private void OnJumped() => InvokeAsync(async () =>
    {
        if (Visible && Worlds.Current is { } world)
        {
            await ReportAsync(world.Id, TutorialGuide.JumpAnywhere);
        }
    });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!Visible || Worlds.Current is not { } world)
        {
            return;
        }

        var path = new Uri(e.Location).AbsolutePath;

        _ = InvokeAsync(async () =>
        {
            if (TutorialGuide.StepAt(path, TutorialTrigger.Visit) is { } visited)
            {
                await ReportAsync(world.Id, visited.Key);
            }

            // The state-detected steps only tick when the checklist is fetched, and
            // reporting a step doesn't run the detectors. Refreshing on arrival means
            // "Add the Session 6 notes" is checked by the time submitting from Capture
            // lands on Sources, instead of waiting out the next poll.
            await RefreshAsync();

            // After the refresh, so a reveal made moments ago on another page is known here.
            await ReportLearnedAsPlayerAsync(world.Id, path);
        });
    }

    // The chapter-two closer: a reveal has been made, and the GM opens What you learned the way
    // a player would find it. The server guards the order too; this check only spares it a 409.
    private async Task ReportLearnedAsPlayerAsync(Guid worldId, string path)
    {
        if (Worlds.ViewingAsPlayer
            && Completed(TutorialGuide.RevealSecret)
            && TutorialGuide.StepAt(path, TutorialTrigger.LearnedAsPlayer) is { } closer)
        {
            await ReportAsync(worldId, closer.Key);
        }
    }

    private bool Completed(string key) =>
        _steps.FirstOrDefault(s => s.Key == key)?.CompletedAt is not null;

    private async Task ReportAsync(Guid worldId, string stepKey)
    {
        if (Completed(stepKey))
        {
            return;
        }

        var result = await Api.ReportTutorialStepAsync(worldId, stepKey, _cts.Token);
        if (result.IsSuccess)
        {
            Take(result.Value!.Steps, worldId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopySessionSixAsync()
    {
        if (Worlds.Current is not { } world)
        {
            return;
        }

        _copyBusy = true;
        var result = await Api.GetTutorialSessionSixAsync(world.Id, _cts.Token);
        _copyBusy = false;

        if (result.IsSuccess)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", result.Value!.Body);
                _copied = true;
            }
            catch
            {
                // Clipboard can be denied; the capture page hint still guides the user.
            }
        }
    }

    private void ToggleCollapsed() => _collapsed = !_collapsed;

    private async Task DismissAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Dismiss the tutorial?",
            "It goes away for good — it won't come back on this or any other world.",
            yesText: "Dismiss", cancelText: "Keep it");

        if (confirmed == true)
        {
            _dismissed = true;
            await Api.DismissTutorialAsync(_cts.Token);
            // The shared cache would otherwise keep reporting "not dismissed" for the rest of
            // the circuit, so a sibling reading it later would resurrect the checklist.
            Onboarding.Invalidate();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        Worlds.Changed -= OnWorldsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Switcher.Jumped -= OnJumped;
    }
}
