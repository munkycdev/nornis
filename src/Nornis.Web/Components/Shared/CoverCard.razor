@inject NornisApiClient Api

@* The cover art (feature 38). "The model paints, Nornis sets the type": the GM asks the
   Loremaster for an art brief (or writes one), generates two options on the world creator's own
   OpenAI key, and picks one; or uploads their own art. Every rule (the cap, the key, what records
   AI use) is the API's; this card shows what the API answers. *@

<MudPaper Elevation="0" Class="nornis-card nornis-card-pad nornis-cover-card">
    <MudText Typo="Typo.overline" Color="Color.Secondary">Cover</MudText>

    @if (_state is null)
    {
        @if (_error is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="my-2" />
        }
    }
    else
    {
        @if (_state.Cover is { } cover)
        {
            <div class="nornis-cover-current">
                <img src="@CoverUrl(cover)" alt="The cover art" class="nornis-cover-thumb" />
                <div class="nornis-cover-current-side">
                    <div class="nornis-book-details-caption nornis-cover-source">
                        @(cover.Source == "Generated" ? "Generated with AI" : "Your upload")
                    </div>
                    <MudSelect T="string" Value="cover.Layout" ValueChanged="SetLayoutAsync" Label="Layout" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Locked" Class="nornis-cover-layout">
                        @foreach (var (value, label) in Layouts)
                        {
                            <MudSelectItem T="string" Value="value">@label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="nornis-cover-remove"
                               StartIcon="@Icons.Material.Outlined.HideImage" Disabled="Locked" OnClick="RemoveAsync">Remove art</MudButton>
                </div>
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nornis-cover-empty">
                No art yet: the booklet prints a typeset cover. Generate art from a brief, or upload your own.
            </MudText>
        }

        @if (_state.Warning is { } warning)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="nornis-cover-warning">@warning</MudText>
        }

        <div class="d-flex flex-wrap gap-1 mt-2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="nornis-cover-generate-open"
                       StartIcon="@Icons.Material.Outlined.AutoAwesome" Disabled="Locked" OnClick="OpenBrief">Generate</MudButton>
            <label class="nornis-cover-upload @(Locked ? "nornis-cover-upload-disabled" : null)">
                <InputFile OnChange="UploadAsync" accept=".png,.jpg,.jpeg,image/png,image/jpeg" disabled="@Locked" class="nornis-cover-upload-input" />
                <MudIcon Icon="@Icons.Material.Outlined.Upload" Size="Size.Small" />
                <span>Upload</span>
            </label>
        </div>

        @if (_briefOpen)
        {
            <div class="nornis-cover-brief">
                <MudTextField T="string" @bind-Value="_brief" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="5"
                              MaxLength="MaxBriefChars" Counter="MaxBriefChars" Immediate="true" Disabled="Locked"
                              Label="Art brief" aria-label="Art brief"
                              Placeholder="A steaming bathhouse at dusk, green slime glistening on marble steps…" />
                <div class="nornis-book-details-caption">
                    Describe one scene to paint. Nornis adds no text to the art and sets the title itself. Covers can be seen by players, so keep secrets out.
                </div>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="nornis-cover-ask"
                               StartIcon="@Icons.Material.Outlined.EditNote" Disabled="Locked" OnClick="WriteBriefAsync">Ask the Loremaster</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="nornis-cover-generate"
                               Disabled="@(Locked || !_state.CanGenerate || string.IsNullOrWhiteSpace(_brief))"
                               OnClick="GenerateAsync">Generate two options</MudButton>
                </div>
                @if (_state.GenerateBlocker is { } blocker)
                {
                    <div class="nornis-book-details-caption nornis-cover-blocker">@blocker</div>
                }
                <div class="nornis-book-details-caption nornis-cover-count">
                    @_state.ImagesGenerated of @_state.ImagesCap generated images used for this adventure.
                </div>
            </div>
        }

        @if (_working is { } working)
        {
            <div class="nornis-cover-working">
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
                <MudText Typo="Typo.caption">@working</MudText>
            </div>
        }

        @if (_state.Options.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Generated options: pick one for the cover, or refine one for more detail.</MudText>
            <div class="nornis-cover-options">
                @foreach (var option in _state.Options)
                {
                    var chosen = option == _state.ChosenOptionId;
                    <div class="nornis-art-option">
                        <button type="button" class="nornis-cover-option @(chosen ? "nornis-cover-option-chosen" : null)"
                                disabled="@(Locked || chosen)" aria-pressed="@(chosen ? "true" : "false")"
                                aria-label="@(chosen ? "The cover" : "Use this option")" @onclick="() => ChooseAsync(option)">
                            <img src="@OptionUrl(option)" alt="A generated cover option" loading="lazy" />
                        </button>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="nornis-art-refine"
                                   StartIcon="@Icons.Material.Outlined.AutoFixHigh" Disabled="@(Locked || !_state.CanGenerate)"
                                   aria-label="Refine this option with more detail" OnClick="() => RefineAsync(option)">Refine</MudButton>
                    </div>
                }
            </div>
        }
    }

    @if (_error is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Error" Class="nornis-cover-error">@_error</MudText>
    }
</MudPaper>

@code {
    /// <summary>Mirrors <c>AdventureCover.MaxBriefChars</c>; CoverCardMirrorTests pins it.</summary>
    public const int MaxBriefChars = 2_000;

    /// <summary>Mirrors <c>PrepOptions.MaxCoverUploadBytes</c>' default; the API is the rule, this only stops a pointless send.</summary>
    public const long MaxUploadBytes = 10 * 1024 * 1024;

    /// <summary>The three layouts, by their API names (<c>CoverLayout</c>), as the GM reads them.</summary>
    public static readonly IReadOnlyList<(string Value, string Label)> Layouts =
    [
        ("FullBleed", "Full bleed"),
        ("Framed", "Framed"),
        ("ClassicModule", "Classic module"),
    ];

    /// <summary>The working line while a refine runs (feature 45): a high-quality edit is slower than a draft.</summary>
    public const string RefiningText = "Refining with more detail. This can take a couple of minutes…";

    [Parameter, EditorRequired] public Guid WorldId { get; set; }

    [Parameter, EditorRequired] public Guid AdventureId { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Raised when the art changed, so the page can refresh what depends on it (the AI-use record).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private CoverStateDto? _state;
    private string? _brief;
    private bool _briefOpen;
    private string? _working;
    private string? _error;
    private Guid _loadedFor;

    private bool Locked => Disabled || _working is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == AdventureId)
        {
            return;
        }

        _loadedFor = AdventureId;
        _state = null;
        _error = null;
        var result = await Api.GetCoverAsync(WorldId, AdventureId);
        if (result.IsSuccess)
        {
            Show(result.Value!);
        }
        else
        {
            _error = result.Error!.Message;
        }
    }

    private string CoverUrl(CoverDto cover) => Links.PrepCover(WorldId, AdventureId, cover.UpdatedAt);

    private string OptionUrl(Guid option) => $"/prep-covers/{WorldId}/{AdventureId}/options/{option}";

    private void Show(CoverStateDto state)
    {
        // An answer missing its list (an older API) reads as no options rather than failing the page.
        _state = state with { Options = state.Options ?? [] };
        _brief ??= state.Brief;
    }

    private void OpenBrief()
    {
        _briefOpen = true;
        _brief ??= _state?.Brief;
    }

    private Task WriteBriefAsync() => RunAsync("The Loremaster is writing a brief…", async () =>
    {
        var result = await Api.WriteCoverBriefAsync(WorldId, AdventureId);
        if (result.IsSuccess)
        {
            _brief = result.Value!.Brief;
        }

        return result;
    }, changed: false);

    private Task GenerateAsync() => RunAsync("Painting two options. This can take a minute…",
        () => Api.GenerateCoverAsync(WorldId, AdventureId, _brief ?? string.Empty), changed: false);

    private Task RefineAsync(Guid option) => RunAsync(RefiningText,
        () => Api.RefineCoverAsync(WorldId, AdventureId, option), changed: false);

    private Task ChooseAsync(Guid option) => RunAsync("Setting the cover…",
        () => Api.ChooseCoverAsync(WorldId, AdventureId, option), changed: true);

    private Task SetLayoutAsync(string layout) => RunAsync("Changing the layout…",
        () => Api.SetCoverLayoutAsync(WorldId, AdventureId, layout), changed: true);

    private Task RemoveAsync() => RunAsync("Removing the art…",
        () => Api.RemoveCoverAsync(WorldId, AdventureId), changed: true);

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxUploadBytes)
        {
            _error = $"A cover can be at most {MaxUploadBytes / (1024 * 1024)} MB.";
            return;
        }

        await RunAsync("Uploading your art…", async () =>
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            return await Api.UploadCoverAsync(WorldId, AdventureId, buffer.ToArray());
        }, changed: true);
    }

    private async Task RunAsync(string working, Func<Task<ApiResult<CoverStateDto>>> call, bool changed)
    {
        _working = working;
        _error = null;
        StateHasChanged();
        try
        {
            var result = await call();
            if (result.IsSuccess)
            {
                Show(result.Value!);
                if (changed)
                {
                    await OnChanged.InvokeAsync();
                }
            }
            else
            {
                _error = result.Error!.Message;
            }
        }
        finally
        {
            _working = null;
        }
    }
}
