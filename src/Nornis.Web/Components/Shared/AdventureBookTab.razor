@* The Book tab of an Adventure: the booklet as an object, apart from its words, beside Talk it
   through as every tab is. Two columns when there is room: what the book carries besides its
   sections (the cover art, the handouts printed at its back, the documents that belong to it),
   and how it is set and filed (its type and its Book details). The title, pitch and campaign are
   the page head's, above every tab (3.18). Every card saves itself and raises what the API
   returned; the page merges it, so nothing open on the other tabs is replaced. *@

<div class="nornis-prep-book">
    <div class="nornis-prep-book-contents">
        <CoverCard WorldId="WorldId" AdventureId="Adventure.Id" Disabled="Disabled" OnChanged="OnCoverChanged" />

        <HandoutsCard Adventure="Adventure" Disabled="Disabled" OnSaved="OnHandoutsSaved" />
    </div>

    <div class="nornis-prep-book-catalog">
        <TypographyCard Adventure="Adventure" Disabled="Disabled" OnSaved="OnTypographySaved" />

        <BookDetailsCard Adventure="Adventure" Disabled="Disabled" OnSaved="OnBookDetailsSaved" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid WorldId { get; set; }

    [Parameter, EditorRequired] public AdventureDto Adventure { get; set; } = null!;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnCoverChanged { get; set; }

    [Parameter] public EventCallback<AdventureDto> OnBookDetailsSaved { get; set; }

    [Parameter] public EventCallback<AdventureDto> OnHandoutsSaved { get; set; }

    [Parameter] public EventCallback<AdventureDto> OnTypographySaved { get; set; }
}
