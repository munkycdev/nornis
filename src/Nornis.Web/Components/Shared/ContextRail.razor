@* The context rail's content: counted rows ("Sources 12"), a short list of what
   this thing connects to, whatever the page adds, and the Loremaster. Everything it shows
   comes from the page's own already-loaded, visibility-filtered detail — the page builds the
   model from what it has, so a rail count can never exceed what the body may show. *@

<div class="nornis-rail">
    @if (Rows.Count > 0)
    {
        <div class="nornis-rail-section">
            <div class="nornis-rail-title">@RowsTitle</div>
            @foreach (var row in Rows)
            {
                <div class="nornis-rail-row">
                    @if (row.Href is not null)
                    {
                        <a href="@row.Href" class="nornis-link">@row.Label</a>
                    }
                    else
                    {
                        <span>@row.Label</span>
                    }
                    <span class="nornis-rail-value">@row.Value</span>
                </div>
            }
        </div>
    }

    @if (Related.Count > 0)
    {
        <div class="nornis-rail-section">
            <div class="nornis-rail-title">@RelatedTitle</div>
            @foreach (var link in Related)
            {
                <a href="@link.Href" class="nornis-rail-link">
                    <TypeTile Type="@link.Type" />
                    <span>@link.Label</span>
                </a>
            }
            @if (RelatedMoreHref is not null)
            {
                <a href="@RelatedMoreHref" class="nornis-rail-more">See all</a>
            }
        </div>
    }

    @if (ChildContent is not null)
    {
        <div class="nornis-rail-section">@ChildContent</div>
    }

    @if (ShowLoremaster)
    {
        <div class="nornis-rail-section nornis-rail-loremaster">
            <LoremasterPanel Lead="@($"Ask about {LoremasterAbout}, or anything else in the record. Answers cite their sources.")"
                             Prompt="@($"Ask about {LoremasterAbout}")" />
        </div>
    }
</div>

@code {
    /// <summary>A counted row: "Sources — 12". The label links when there is somewhere to go.</summary>
    public sealed record RailRow(string Label, string Value, string? Href = null);

    /// <summary>A related entry, shown with its type's tile.</summary>
    public sealed record RailLink(string? Type, string Label, string Href);

    [Parameter] public string RowsTitle { get; set; } = "In the record";
    [Parameter] public IReadOnlyList<RailRow> Rows { get; set; } = [];
    [Parameter] public string RelatedTitle { get; set; } = "Connected";
    [Parameter] public IReadOnlyList<RailLink> Related { get; set; } = [];
    [Parameter] public string? RelatedMoreHref { get; set; }
    [Parameter] public bool ShowLoremaster { get; set; } = true;

    /// <summary>What this page is, as the Loremaster panel names it: "this entry", "this character".</summary>
    [Parameter] public string LoremasterAbout { get; set; } = "this page";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
