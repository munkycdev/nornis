@* The one frame every entity page is built on (feature 24, phase B): a full-width header,
   then the body beside a context rail. The rail is the backlinks panel — what cites this,
   what connects to it, what changed — and the Loremaster's handle, in the same place on every
   page; under the tablet breakpoint it drops beneath the body as a strip. Pages fill the three
   slots and never rebuild the frame. While a page is being edited it is a Workspace (3.19):
   see "Editing fills the window" in app.css. *@

<div class="nornis-entity @(Workspace ? "nornis-workspace" : null)">
    @if (Header is not null)
    {
        <div class="nornis-entity-header">@Header</div>
        <Stonemark Kind="StonemarkKind.Rule" Class="nornis-entity-ornament" />
    }
    <div class="nornis-entity-columns">
        <div class="nornis-entity-body">@Body</div>
        @if (Rail is not null)
        {
            <aside class="nornis-entity-rail" aria-label="Context">@Rail</aside>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Rail { get; set; }

    /// <summary>
    /// The page is being edited: on a wide window it fills the pane, the body and the rail
    /// scroll on their own, and an editor in a <c>nornis-fill</c> chain takes the room left.
    /// </summary>
    [Parameter] public bool Workspace { get; set; }
}
