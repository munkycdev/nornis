@inject NornisApiClient Api

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name"
                      Label="World name"
                      Required="true"
                      Immediate="true"
                      MaxLength="200"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <MudTextField @bind-Value="_description"
                      Label="Description"
                      Lines="2"
                      Variant="Variant.Outlined"
                      Class="mb-3" />
        <MudTextField @bind-Value="_gameSystem"
                      Label="Game system"
                      Placeholder="e.g. D&D 5e"
                      Variant="Variant.Outlined" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }

    @* The demo is a different thing from the world being named above, so it sits in a
       box of its own with buttons of its own (3.32). It was a tick and a text button inside
       the form, and the tick, "Walk me through it", read as applying to the new world. *@
    <div class="nornis-demo-offer">
        <MudText Typo="Typo.subtitle2">Or look around first</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            The demo world is a ready-made campaign you can explore and delete. It ignores the form above.
        </MudText>
        <div class="d-flex gap-2 flex-wrap">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                       OnClick="() => SubmitDemo(withTutorial: true)" Disabled="_busy">
                Open the demo with a walkthrough
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                       OnClick="() => SubmitDemo(withTutorial: false)" Disabled="_busy">
                Open the demo on its own
            </MudButton>
        </div>
    </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy">
            Create world
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = string.Empty;
    private string? _description;
    private string? _gameSystem;
    private bool _busy;
    private string? _error;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "World name is required.";
            return;
        }

        _busy = true;
        _error = null;

        var result = await Api.CreateWorldAsync(new CreateWorldRequest(_name.Trim(), _description, _gameSystem));

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error!.Message;
            return;
        }

        MudDialog.Close(DialogResult.Ok(result.Value!));
    }

    private async Task SubmitDemo(bool withTutorial)
    {
        _busy = true;
        _error = null;

        var result = await Api.CreateDemoWorldAsync(withTutorial);

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.Error!.Message;
            return;
        }

        MudDialog.Close(DialogResult.Ok(result.Value!));
    }

    private void Cancel() => MudDialog.Cancel();
}
